@using System.Net
<MudDialog Class="moog-crud-muddiag" Style="width:80%; margin:0px; background-color:#F7F7F7;" >
    <TitleContent>
        <MudText Typo="Typo.h6" Class="lang-en">
            IMAGES
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudCard Outlined="true" Style="padding: 0px; border:0px; background-color: #F7F7F7; display:flex; flex-direction:column">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart">
                <MudButton Variant="Variant.Filled" StartIcon="fa-light fa-circle-plus" Size="Size.Small" Color="Color.Primary" Class="moog-mudbutton" OnClick="OnItemAddClicked"   >
                    Add
                </MudButton>
            </MudStack>
            <MudDataGrid Class="moog-muddatagrid cruc-pg-pager mt-3" Dense="true" Hover="true" FixedHeader="true" Striped="false" HorizontalScrollbar="true" Elevation="0" ColumnResizeMode="ResizeMode.None"
                         Height="100%" ReadOnly="false"
                         StartedEditingItem="@StartedEditingItem" CanceledEditingItem="@CanceledEditingItem" CommittedItemChanges="@CommittedItemChanges"
                         EditTrigger="DataGridEditTrigger.Manual" EditMode="DataGridEditMode.Cell"
                         T="AttachedImage" Items="@Images">
                <Columns>
                    <TemplateColumn Title="Status"
                                    HeaderClass="moog-muddatagrid-hdr moog-cruc-pg" CellClass="moog-muddatagrid-cell data-align-top inline-editing"
                                    HeaderStyle="padding:8px !important; width:100px; max-width:70px" CellStyle="text-align:center" Editable="false" Context="rowData">
                        <CellTemplate>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="0">
                                @if (rowData.Item.Id == 0)
                                {
                                    <MudIcon Icon="@Icons.Material.Rounded.AddPhotoAlternate" Color="Color.Primary" />
                                }
                                else if (rowData.Item.IsDeleted)
                                {
                                    <MudIcon Icon="@Icons.Material.Rounded.Delete" Color="Color.Error" />
                                }
                                else if (rowData.Item.Id > 0)
                                {
                                    <MudIcon Icon="@Icons.Material.Rounded.CheckCircle" Color="Color.Success" />
                                }
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Title="No." Property="x => x.OrderNo"
                                    HeaderClass="moog-muddatagrid-hdr moog-cruc-pg" CellClass="moog-muddatagrid-cell data-align-top inline-editing"
                                    HeaderStyle="padding:8px !important; width:100px; max-width:44px" CellStyle="text-align:right"
                                    Editable="false" Sortable="false" Filterable="false">
                    </PropertyColumn>
                    <PropertyColumn Title="Name" Property="x => x.ObjectName"
                                    HeaderClass="moog-muddatagrid-hdr moog-cruc-pg" CellClass="moog-muddatagrid-cell data-align-top inline-editing"
                                    Context="rowData">
                        <EditTemplate>
                            <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                          Class="moog-mudform-input-square"
                                          ClearIcon="fa-regular fa-xmark" IconSize="Size.Small"
                                          Placeholder="Name"
                                          @bind-Value="rowData.Item.ObjectName" For="@(() => rowData.Item.ObjectName)" />
                        </EditTemplate>
                    </PropertyColumn>
                    <PropertyColumn Title="Filename" Property="x => x.ImageFilename"
                                    HeaderClass="moog-muddatagrid-hdr moog-cruc-pg" CellClass="moog-muddatagrid-cell data-align-top inline-editing"
                                    HeaderStyle="padding:8px !important; white-space:nowrap"
                                    Context="rowData">
                        <EditTemplate>
                            <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                          Class="moog-mudform-input-square"
                                          ClearIcon="fa-regular fa-xmark" IconSize="Size.Small"
                                          Placeholder="Filename"
                                          @bind-Value="rowData.Item.ImageFilename" />
                        </EditTemplate>
                    </PropertyColumn>
                    <PropertyColumn Title="Image URL" Property="x => x.ImageUrl"
                                    HeaderClass="moog-muddatagrid-hdr moog-cruc-pg" CellClass="moog-muddatagrid-cell data-align-top inline-editing"
                                    HeaderStyle="padding:8px !important; width:50%" Context="rowData">
                        <EditTemplate>
                            <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                          Class="moog-mudform-input-square"
                                          AdornmentIcon="fa-duotone fa-solid fa-link" Adornment="Adornment.Start"
                                          ClearIcon="fa-regular fa-xmark" IconSize="Size.Small"
                                          Placeholder="Image URL"
                                          @bind-Value="rowData.Item.ImageUrl" For="@(() => rowData.Item.ImageUrl)" />
                        </EditTemplate>
                    </PropertyColumn>
                </Columns>
            </MudDataGrid>
            @if (_errorList.Count != 0)
            {
                @foreach (string key in _errorList.Keys)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="my-2">@_errorList[key]</MudAlert>
                }
            }
        </MudCard>
        <MudCardActions>
            <MudStack Row=true AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="3" Style="width:100%;">
                <MudButton Variant="Variant.Filled" StartIcon="fa-light fa-circle-check" Size="Size.Small" Color="Color.Primary" DropShadow="false" Class="moog-mudbutton" OnClick="Confirm">
                    Confirm
                </MudButton>
                <MudButton Variant="Variant.Filled" StartIcon="fa-light fa-ban" Size="Size.Small" Color="Color.Error" DropShadow="false" Class="moog-mudbutton" OnClick="Cancel">
                    Cancel
                </MudButton>
            </MudStack>
        </MudCardActions>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public bool IsViewMode { get; set; }

    [Parameter]
    public required List<AttachedImage> Images { get; set; }

    [Parameter]
    public User? LoggedInUser { get; set; }
    readonly string DataGridHdrStyle = "font-weight:700; background-color:var(--ssv-pharma-blue); color:#FFFFFF; border-right:1px solid #FFFFFF; padding-inline-start: 10px; padding-inline-end:5px; line-height:100%; padding-top:4px; padding-bottom:4px";

    Dictionary<string, string> _errorList = new();

    #region PAGE LIFECYCLE EVENTS
    protected override void OnInitialized()
    {
        if (Images.Count == 0)
        {
            Images.Add(new AttachedImage());
        }
    }
    #endregion

    //========================================================================================================
    // UI FUNCTIONS
    //========================================================================================================
    // *IMPORTANT!* this is to prevent ENTER key press in edit form from trigger saving data
    // events
    void StartedEditingItem(AttachedImage item)
    {

    }

    void CanceledEditingItem(AttachedImage item)
    {

    }

    Task<DataGridEditFormAction> CommittedItemChanges(AttachedImage item)
    {
        return Task.FromResult(DataGridEditFormAction.Close);
    }

    void OnItemAddClicked()
    {
        Images.Add(new()
        {
            OrderNo = Images.Count+1
        });
    }
    //========================================================================================================
    // <END> UI FUNCTIONS
    //========================================================================================================
    private void Confirm()
    {
        ValidateBeforeCommit();

        if (_errorList.Count > 0)
            return;

        MudDialog!.Close(DialogResult.Ok<List<AttachedImage>>(Images, Images.GetType()));
    }

    private void InvalidSaveClick(EditContext editContext)
    {
        //string text = "";
    }

    private void ValidateBeforeCommit()
    {
        _errorList.Clear();

        foreach (AttachedImage img in Images)
        {
            if (string.IsNullOrEmpty(img.ObjectName))
                _errorList.Add($"img-{img.OrderNo!.Value:#,##0}-NameRequired", $"Image #{img.OrderNo!.Value:#,##0} name is required.");

            if (string.IsNullOrEmpty(img.ImageFilename))
                _errorList.Add($"img-{img.OrderNo!.Value:#,##0}-FileNameRequired", $"Image #{img.OrderNo!.Value:#,##0} file is required.");

            if (string.IsNullOrEmpty(img.ImageUrl))
                _errorList.Add($"img-{img.OrderNo!.Value:#,##0}-MissingUrl", $"Image #{img.OrderNo!.Value:#,##0} URL is required.");
            else
            {
                HttpClient httpClnt = new HttpClient()
                {
                    BaseAddress = new Uri(img.ImageUrl!)
                };
            }

            // HttpWebRequest request = (HttpWebRequest)HttpWebRequest.Create("url");
            // request.Method = "HEAD";

            // bool exists;
            // try
            // {
            //     request.GetResponse();
            //     exists = true;
            // }
            // catch
            // {
            //     exists = false;
            // }
        }
    }

    private void Cancel()
    {

        for (int i=0; i<Images.Count; i++)
        {
            if (Images[i].IsDeleted) continue;

            if (Images[i].Id == 0 && (string.IsNullOrEmpty(Images[i].ImageUrl) || string.IsNullOrEmpty(Images[i].ObjectName)))
            {
                Images[i].IsDeleted = true;
            }
        }

        Images.RemoveAll(x => x.Id == 0 && x.IsDeleted == true);

        MudDialog!.Close(DialogResult.Cancel());
    }
}