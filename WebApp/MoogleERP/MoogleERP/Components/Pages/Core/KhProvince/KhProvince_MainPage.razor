@page "/core/kh-province/main"

@inherits MainPageBase<KhProvince>
<MudPaper Class="moog-pg-banner" Elevation="0">
	<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
		<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Spacing="2">
			<MudIcon Icon="fad fa-list-dropdown" Color="Color.Primary" Size="Size.Large"></MudIcon>
			<MudText Typo="Typo.h4" Color="@Color.Primary">@HeaderTitle</MudText>
		</MudStack>

		<MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Primary"
				   StartIcon="far fa-plus-circle" OnClick="@(args => PerformCRUC(CRUDCModes.CREATE))">
			Add New
		</MudButton>
	</MudStack>
</MudPaper>
<MudPaper Class="moog-mudpaper-main-pg-content mt-5 overflow-y-auto" Elevation="0" Height="100%" Style="display: flex; flex-direction:column">
	<MudStack Class="ma-4" Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" StretchItems="StretchItems.None">
		<MudTextField Clearable="true" Immediate="true" ReadOnly="false" Required="false" ShrinkLabel="true" Variant="Variant.Text"
					  Class="moog-mudform-input"
					  AdornmentIcon="material-symbols-rounded/search" Adornment="Adornment.Start" AdornmentColor="Color.Primary"
					  ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
					  Placeholder="Search text here..."
					  @bind-Value="SearchText" OnKeyDown="OnSearchTextBoxKeyDown" @ref=UITextBoxSearch Disabled=IsSearching />
		<MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" DropShadow="false" Class="moog-mudbutton"
				   StartIcon="material-symbols-rounded/search" OnClick="OnSearchClicked">Search</MudButton>
	</MudStack>
	<MudDataGrid Bordered="false" Dense="true" FixedHeader="true" Hover="true" Loading=@IsSearching MultiSelection="false" Square="true" Striped="true"
				 ColumnResizeMode="ResizeMode.Container" Elevation="0" RowsPerPage="50" SortMode="SortMode.Multiple"
				 Class="moog-muddatagrid moog-main-pg" Height="calc(100% - 38px)" NoRecordsContent="DataGridZeroRecordContent"
				 @bind-SelectedItem=SelectedObject SelectOnRowClick="true" RowClassFunc="SelectedRowClassFunc" RowClass="moog-muddatagrid-row"
				 @ref="MainDataGrid" ServerData="ServerDataFunc"
				 T="KhProvince">
		<Columns>
			<PropertyColumn Title="Name" Property="x => x.ObjectName" StickyLeft="true"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell"
							CellStyle="font-weight:600; color:var(--ssv-pharma-blue)"/>
			<PropertyColumn Title="Name (kh)" Property="x => x.NameKh"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell moog-lang-kh" />
			<PropertyColumn Title="Code 2" Property="x => x.Code2"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell moog-font-mono" />
			<PropertyColumn Title="Code 3" Property="x => x.Code3"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell moog-font-mono" />
			<PropertyColumn Title="Postal Code" Property="x => x.PostalCode"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell moog-font-mono" />
			<TemplateColumn Title="Action" Sortable="false" Filterable="false" StickyRight="true"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell"
							HeaderStyle="width:300px; max-width:120px" CellStyle="padding: 0px 10px !important;">
				<CellTemplate>
					<MudStack Row="true" Spacing="0">
						<MudIconButton Size="Size.Small" Color="Color.Primary" DropShadow="false" Class="moog-muddatagrid-icon-btn"
									   Icon="far fa-edit"
									   OnClick="@(args => PerformCRUC(CRUDCModes.UPDATE, context.Item.Id))" />
						<MudIconButton Size="Size.Small" Color="Color.Primary" Class="moog-muddatagrid-icon-btn"
									   Icon="far fa-copy"
									   OnClick="@(args => PerformCRUC(CRUDCModes.CLONE, context.Item.Id))" />
						<MudIconButton Size="Size.Small" Color="Color.Success" Class="moog-muddatagrid-icon-btn"
									   Icon="far fa-eye"
									   OnClick="@(args => PerformCRUC(CRUDCModes.READ, context.Item.Id))" />
						<MudIconButton Size="Size.Small" Color="Color.Error" Class="moog-muddatagrid-icon-btn"
									   Icon="far fa-trash-alt"
									   OnClick="@(args => DeleteRecord(context.Item))" />
					</MudStack>
				</CellTemplate>
			</TemplateColumn>
		</Columns>
		<PagerContent>
			<MudDataGridPager T="KhProvince" Class="moog-muddatagrid-pager" PageSizeOptions="new[] { 10, 20, 30, 50, 80, 100 }" />
		</PagerContent>
    </MudDataGrid>
</MudPaper>

@code {
	#region UI VARIABLES

	#endregion

	#region PAGE LIFECYCLE FUNCTIONS
	public override Task SetParametersAsync(ParameterView parameters)
	{
		UrlPrefix = "/core/kh-province";
		SearchParamName = "khProvinceSearchParam";
		return base.SetParametersAsync(parameters);
	}

	protected override async Task OnInitializedAsync()
	{
		await Task.CompletedTask;
	}
	#endregion

	#region UI FUNCTIONS
	#endregion

	#region UI BASE FUNCTIONS
	protected override async Task<GridData<KhProvince>> ServerDataFunc(GridState<KhProvince> gridState, CancellationToken token)
	{
		if (IsSearching) return new GridData<KhProvince>
		{
			Items = [],
			TotalItems = 0
		};

		try
		{
			IsSearching = true;
			int totalItemCount = 0;
			//if (gridState.SortDefinitions.Count > 0)
			//{
			//	var firstSort = gridState.SortDefinitions.First();
			//	result = firstSort.Descending
			//		? result.OrderByDescending(firstSort.SortFunc).ToList()
			//		: result.OrderBy(firstSort.SortFunc).ToList();
			//}

			if (gridState.FilterDefinitions.Any())
			{
				//var filterFunctions = gridState.FilterDefinitions.Select(x => x.GenerateFilterFunction());
				//result = result
				//	.Where(x => filterFunctions.All(f => f(x)))
				//	.ToList();
			}
			else
			{
				var result = await Uow.KhProvinces.SearchNewAsync(PageSize, MainDataGrid.CurrentPage + 1, SearchText);
				MainDataList = result.Value;
				totalItemCount = result.Key;
			}

			//var totalNumberOfFilteredItems = result.Count;

			//result = result
			//	.Skip(gridState.StartIndex)
			//	.Take(gridState.Count)
			//	.ToList();

			return new GridData<KhProvince>
			{
				Items = MainDataList,
				TotalItems = totalItemCount
			};
		}
		catch (Exception ex)
		{
			await JsRuntime.InvokeVoidAsync("console.error", ex.GetFullMessage());

			return new GridData<KhProvince>
			{
				Items = [],
				TotalItems = 0
			};
		}
		finally
		{
			IsSearching = false;
		}
	}
    #endregion
}
