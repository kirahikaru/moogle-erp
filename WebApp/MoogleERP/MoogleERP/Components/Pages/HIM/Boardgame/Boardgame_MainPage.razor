@page "/him/boardgame/main"

@using MoogHobby = DataLayer.Models.Hobby

@inherits MainPageBase<MoogHobby.Boardgame>
<MudPaper Class="moog-pg-banner" Elevation="0">
	<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
		<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Spacing="2">
			<MudIcon Icon="fad fa-game-board" Color="Color.Primary" Size="Size.Large"></MudIcon>
			<MudText Typo="Typo.h4" Color="@Color.Primary">@HeaderTitle</MudText>
		</MudStack>
		<MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Primary"
				   StartIcon="far fa-plus-circle" OnClick="@(args => PerformCRUC(CRUDCModes.CREATE))">
			Add New
		</MudButton>
	</MudStack>
</MudPaper>
<MudPaper Class="moog-mudpaper-main-pg-content mt-5 overflow-y-auto" Elevation="0" Height="100%" Style="display: flex; flex-direction:column">
	<MudStack Class="ma-4" Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" StretchItems="StretchItems.None">
		<MudTextField Clearable="true" Immediate="true" ReadOnly="false" Required="false" ShrinkLabel="true" Variant="Variant.Text"
					  Class="moog-mudform-input"
					  AdornmentIcon="material-symbols-rounded/search" Adornment="Adornment.Start" AdornmentColor="Color.Primary"
					  ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
					  Placeholder="Search text here..."
					  @bind-Value="SearchText" OnKeyDown="OnSearchTextBoxKeyDown" @ref=UITextBoxSearch Disabled=IsSearching />
		<MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" DropShadow="false" Class="moog-mudbutton"
				   StartIcon="material-symbols-rounded/search" OnClick="OnSearchClicked">Search</MudButton>
	</MudStack>
	<MudDataGrid Bordered="false" Dense="true" FixedHeader="true" Hover="true" Loading=@IsSearching MultiSelection="false" Square="true" Striped="true"
				 ColumnResizeMode="ResizeMode.Container" Elevation="0" RowsPerPage="50" SortMode="SortMode.Multiple"
				 Class="moog-muddatagrid moog-main-pg" Height="calc(100% - 38px)"
				 @bind-SelectedItem=SelectedObject SelectOnRowClick="true" RowClassFunc="SelectedRowClassFunc" RowClass="moog-muddatagrid-row"
				 @ref="MainDataGrid" ServerData="ServerDataFunc"
				 T="MoogHobby.Boardgame">
        <Columns>
			<TemplateColumn Title="Name" StickyLeft="true"
                            HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell" 
							HeaderStyle="min-width:280px" Context="rowData">
                <CellTemplate>
                    @if (rowData.Item.ObjectState.Is(ObjectStates.WRITTEN_OFF, ObjectStates.SOLD, ObjectStates.GIFTED_OTHER))
                    {
                        <span style="text-decoration:line-through; font-style:italic; color:var(--metronic-gray-400);">@rowData.Item.ObjectName</span>
                    }
                    else if (rowData.Item.ObjectState.Is(ObjectStates.LOANED))
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <span style="font-style:italic; color:var(--material-amber-700);">@rowData.Item.ObjectName</span>
                            <MudIcon Icon="@Icons.Material.Rounded.WarningAmber" Style="color:var(--material-amber-700);" />
                        </MudStack>
                    }
                    else
                    {
                        <span style="font-weight:500; color:var(--ssv-pharma-blue);">@rowData.Item.ObjectName</span>
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Title="Year" Property="x => x.ReleaseYear"
                            HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell" />
            <PropertyColumn Title="Age" Property="x => x.PlayingAgeText"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell" />
            <PropertyColumn Title="Play Time" Property="x => x.PlayDurationText"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell"
							HeaderStyle="min-width:150px" />
            <PropertyColumn Title="Player Limit" Property="x => x.PlayerLimitText"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell"
							HeaderStyle="min-width:150px" />
            <PropertyColumn Title="Price" Property="x => x.PurchasedPrice" Format="$ #,##0.00"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell" CellStyle="text-align:right"
							HeaderStyle="min-width:100px" />
			<PropertyColumn Title="Purhcased Date" Property="x => x.PurchasedDate" Format="dd-MMM-yyyy"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell"
							HeaderStyle="min-width:170px" CellStyle="text-align:center" />
            <TemplateColumn Title="Purchase From" Sortable="false" Filterable="false" 
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell"
							HeaderStyle="min-width:280px" Context="rowData">
                <CellTemplate>
                    @if (@rowData.Item.Merchant != null)
                    {
                        <MudText Typo="Typo.body1" Style="font-size:10pt">@rowData.Item.Merchant.ObjectName</MudText>
                    }
                    else
                    {
						<MudText Typo="Typo.body1" Style="font-size:10pt"> - </MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="State" Sortable="false" Filterable="false"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell" CellStyle="text-align:center; padding-top: 0px !important; padding-bottom: 0px !important"
                            Context="rowData">
                <CellTemplate>
                    @* @(ObjectStates.GetDisplayText(rowData.Item.ObjectState).ToUpper()) *@
                    <MudChip Size="Size.Small" T="string" Class=@($"status-chip-tiny") Style=@_stateLightStyles[rowData.Item.ObjectState!]>
                        @(ObjectStates.GetDisplayText(rowData.Item.ObjectState).ToUpper())
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Barcode" Title="Barcode"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell moog-font-mono" />
            <PropertyColumn Title="ID" Property="x => x.ObjectCode"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell moog-font-mono" />
			<TemplateColumn Title="Action" Sortable="false" Filterable="false" StickyRight="true"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell"
							HeaderStyle="width:300px; max-width:120px" CellStyle="padding: 0px 10px !important;">
				<CellTemplate>
					<MudStack Row="true" Spacing="0">
						<MudIconButton Size="Size.Small" Color="Color.Primary" DropShadow="false" Class="moog-muddatagrid-icon-btn"
									   Icon="far fa-edit"
									   OnClick="@(args => PerformCRUC(CRUDCModes.UPDATE, context.Item.Id))" />
						<MudIconButton Size="Size.Small" Color="Color.Success" Class="moog-muddatagrid-icon-btn"
									   Icon="far fa-copy"
									   OnClick="@(args => PerformCRUC(CRUDCModes.CLONE, context.Item.Id))" />
						<MudIconButton Size="Size.Small" Color="Color.Info" Class="moog-muddatagrid-icon-btn"
									   Icon="far fa-eye"
									   OnClick="@(args => PerformCRUC(CRUDCModes.READ, context.Item.Id))" />
						<MudIconButton Size="Size.Small" Color="Color.Error" Class="moog-muddatagrid-icon-btn"
									   Icon="far fa-trash-alt"
									   OnClick="@(args => DeleteRecord(context.Item))" />
					</MudStack>
				</CellTemplate>
			</TemplateColumn>
		</Columns>
		<PagerContent>
			<MudDataGridPager T="MoogHobby.Boardgame" Class="moog-muddatagrid-pager" PageSizeOptions="new[] { 10, 20, 30, 50, 80, 100 }" />
		</PagerContent>
    </MudDataGrid>
</MudPaper>

@code {
	#region UI VARIABLES

	Dictionary<string, string> _statesCssClasses = new() {
		{ ObjectStates.NEW, "status-chip-pink-light" },
		{ ObjectStates.BNIB, "status-chip-pink-light" },
		{ ObjectStates.IN_USE, "status-chip-green-light" },
		{ ObjectStates.LOANED, "status-chip-amber-light"},
		{ ObjectStates.UNKNOWN, "status-chip-brown-light"},
		{ ObjectStates.OTHER, "status-chip-brown-light"},
		{ ObjectStates.DRAFT, "status-chip-teal-light"},
		{ ObjectStates.GIFTED_OTHER, "status-chip-blue-gray-light"},
		{ ObjectStates.SOLD, "status-chip-blue-gray-light"},
		{ ObjectStates.WRITTEN_OFF, "status-chip-blue-gray-light"},
		{ ObjectStates.IN_STASH, "status-chip-purple-light" },
		{ ObjectStates.BROKEN, "status-chip-blue-gray-light" },
		{ ObjectStates.RARELY_USED, "status-chip-amber-light" },
	};

	Dictionary<string, string> _stateLightStyles = [];

	#endregion

	#region PAGE LIFECYCLE FUNCTIONS
	public override Task SetParametersAsync(ParameterView parameters)
	{
		UrlPrefix = "/him/boardgame";
		SearchParamName = "boardgameSearchParam";
		_stateLightStyles = ObjectStates.GetLightStyles();
		return base.SetParametersAsync(parameters);
	}

	protected override async Task OnInitializedAsync()
	{
		await Task.CompletedTask;
	}
	#endregion

	#region UI FUNCTIONS
	async Task OnSearchClearClicked(MouseEventArgs args)
	{
		await UITextBoxSearch!.FocusAsync();
		await MainDataGrid.ReloadServerData();
	}
	#endregion

	#region UI BASE FUNCTIONS
	protected override async Task<GridData<MoogHobby.Boardgame>> ServerDataFunc(GridState<MoogHobby.Boardgame> gridState, CancellationToken token)
	{
		if (IsSearching) return new GridData<MoogHobby.Boardgame>
		{
			Items = [],
			TotalItems = 0
		};

		try
		{
			IsSearching = true;
			int totalItemCount = 0;
			IEnumerable<SqlSortCond> sortConds = [];
			IEnumerable<SqlFilterCond> filterConds = [];

			if (gridState.SortDefinitions.Count > 0)
			{
				foreach (var sortDef in gridState.SortDefinitions)
				{
					sortConds.Append<SqlSortCond>(new SqlSortCond(sortDef.SortBy, sortDef.Descending));
				}
			}

			if (gridState.FilterDefinitions.Any())
			{
				//var filterFunctions = gridState.FilterDefinitions.Select(x => x.GenerateFilterFunction());
				//result = result
				//	.Where(x => filterFunctions.All(f => f(x)))
				//	.ToList();
			}

			var result = await Uow.Boardgames.SearchNewAsync(PageSize, MainDataGrid.CurrentPage + 1, SearchText, sortConds, filterConds);
			MainDataList = result.Value;
			totalItemCount = result.Key;

			return new GridData<MoogHobby.Boardgame>
			{
				Items = MainDataList,
				TotalItems = totalItemCount
			};
		}
		catch (Exception ex)
		{
			await JsRuntime.InvokeVoidAsync("console.error", ex.GetFullMessage());

			return new GridData<MoogHobby.Boardgame>
			{
				Items = [],
				TotalItems = 0
			};
		}
		finally
		{
			IsSearching = false;
		}
	}
    #endregion
}
