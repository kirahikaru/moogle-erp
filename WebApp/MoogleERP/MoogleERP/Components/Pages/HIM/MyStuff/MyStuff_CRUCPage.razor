        {
            _selMerchant = _merchantList.SingleOrDefault<DropdownSelectItem>(x => x.Id == CurrentObject.MerchantId.Value);
        }

        if (CurrentObject.OwnedItemCategoryId.HasValue && _ownedItemCategoryList.Count(x => x.Id == CurrentObject.OwnedItemCategoryId.Value) > 0)
        {
            _selOwnedItemCtg = _ownedItemCategoryList.SingleOrDefault<DropdownSelectItem>(x => x.Id == CurrentObject.OwnedItemCategoryId.Value);
        }
    }

    Task PurchasedDateTodayAsync()
    {
