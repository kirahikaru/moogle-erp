@page "/him/my-stuff/{CRUCMode}"
@page "/him/my-stuff/{CRUCMode}/{id:int}"

@inherits CRUCPageBase<OwnedItem>
<PageTitle>My Stuff</PageTitle>
@if (CurrentObject != null && CurrentEditContext != null)
{
    <EditForm EditContext="CurrentEditContext" OnValidSubmit="SaveDummy" OnInvalidSubmit="SaveDummy" style="height:100%; display:flex; flex-direction:column;" >
        <DataAnnotationsValidator />
        <MudPaper Class="moog-pg-banner" Elevation="0">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Spacing="2">
                    <MudIcon Icon="fad fa-box-heart" Color="Color.Primary" Size="Size.Large"></MudIcon>
                    <MudText Typo="Typo.h4" Color="@Color.Primary">@HeaderTitle</MudText>
                    @if (CRUCMode == CRUDCModes.READ)
                    {
                        <MudChip Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string" Style="margin-top:-12px">VIEW</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.UPDATE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string" Style="margin-top:-12px">UPDATE</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.CREATE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string" Style="margin-top:-12px">NEW</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.CLONE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string" Style="margin-top:-12px">NEW (Clone)</MudChip>
                    }
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="2">
                    @if (CRUCMode.Is(CRUDCModes.UPDATE, CRUDCModes.CREATE, CRUDCModes.CLONE) && _nextValidActionList.Any())
                    {
                        <MudMenu Label="Workflow Actions" Class="moog-menu" PopoverClass="moog-menu-popover" ListClass="moog-menu-list" RelativeWidth="DropdownWidth.Adaptive"
                                 Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" DropShadow="false" EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
                            @foreach (string action in _nextValidActionList.Keys)
                            {
                                <MudMenuItem Label="@_nextValidActionList[action]" Icon="@_actionIconList[action]" Disabled=@IsSaving OnClick="(() => SaveAndTransit(action))" Style="width:100%; color:var(--ssv-pharma-blue)" />
                            }
                        </MudMenu>
                    }
                    @if (IsViewMode)
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Default"
                                   Disabled=@IsSaving OnClick="Cancel" StartIcon="material-symbols-rounded/close">
                            Close
                        </MudButton>
                    }
                    else if (CRUCMode == CRUDCModes.UPDATE)
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Primary" StartIcon="material-symbols-rounded/save_as"
                                   Disabled=@IsSaving OnClick="@(() => Save(false))">
                            Save
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Primary" StartIcon="material-symbols-rounded/save"
                                   Disabled=@IsSaving OnClick="@(() => Save(true))">
                            Save & Close
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Default" StartIcon="material-symbols-rounded/cancel"
                                   Disabled=@IsSaving OnClick="Cancel">
                            Cancel
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Default" StartIcon="material-symbols-rounded/cancel"
                                   Disabled=@IsSaving OnClick="Cancel">
                            Cancel
                        </MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>
        <MudTabs Color="Color.Primary" Class="moog-mudtab mt-4" ActiveTabClass="moog-mudtab-tab-active" TabButtonsClass="moog-mudtab-tab-btn" TabHeaderClass="moog-mudtab-tab-hdr" TabPanelsClass="moog-mudtab-tab-panel">
            <MudTabPanel Icon="fad fa-home-lg" Text="Main" Class="moog-mudtabpanel" PanelClass="moog-mudtabpanel-panel">
                <MudPaper Class="moog-mudpaper-cruc-pg-tab-content" Elevation="0" Square="true" Height="calc(100% - var(--moog-cruc-pg-status-bar-height))" Style="border-bottom-left-radius: 0px; border-bottom-right-radius: 0px">
                    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" StretchItems="StretchItems.All" Spacing="1">
                        <MudGrid Spacing="4" Class="pa-4" Style="margin-left:-8px">
                            <MudItem xs="6">
                                <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="true" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="Name"
                                              @bind-Value="CurrentObject!.NameEn" For="@(() => CurrentObject!.NameEn)" @ref=_mtfObjName />
                            </MudItem>
                            <MudItem xs="4">
                                <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input moog-lang-kh"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="Name (Kh)" Placeholder="ឈ្មោះខ្មែរ"
                                              @bind-Value="CurrentObject!.NameKh" For="@(() => CurrentObject!.NameKh)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="true" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="ID"
                                              @bind-Value="CurrentObject!.ObjectCode" For="@(() => CurrentObject!.ObjectCode)" />
                            </MudItem>
                            <MudItem xs="5">
                                <MudStack Row="true" Spacing="1">
                                    <MudAutocomplete Clearable="true" CoerceText="true" CoerceValue="false" Readonly="@IsViewMode" Required="false" ShrinkLabel="true"
                                                     Class="moog-mudform-input" FullWidth="true" PopoverClass="moog-mudautocomplete-popover" InputClass="moog-mudautocomplete-input" ListClass="moog-mudautocomplete-list" ListItemClass="moog-mudautocomplete-listitem"
                                                     ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                                     AdornmentIcon="fa-solid fa-angle-down"
                                                     DebounceInterval="300"
                                                     Label="Category" T="DropdownSelectItem" ToStringFunc="@(e => e == null ? null : $"{e.Value}")"
                                                     Value="_selOwnedItemCtg" ValueChanged="OnOwnedItemCategoryChanged"
                                                     SearchFunc="@SearchOwnedItemCategory" />
                                    <MudStack Row="true" Spacing="1">
                                        <MudTooltip Text="Add new category"
                                                    Placement="Placement.Top" Arrow="true" Style="width:200px; max-width:100px" ShowOnClick="false" ShowOnHover="true" ShowOnFocus="false">
                                            <MudIconButton Size="Size.Medium" Color="Color.Primary" Class="moog-muddatagrid-icon-btn" OnClick="OnAddCategoryBtnClicked"
                                                           Icon="fad fa-circle-plus" aria-label="Add New My Stuff Category" />
                                        </MudTooltip>
                                    </MudStack>
                                </MudStack>
                            </MudItem>
                            <MudItem xs="5">
                                @* <MudSelect T="string" Label="Made In" Dense="true" Margin="Margin.Dense" ShrinkLabel="true" Clearable="true" @bind-Value="CurrentObject!.ManufacturerCountryCode" For="@(() => CurrentObject!.ManufacturerCountryCode)"
                                           Class="moog-mud-select" >
                                    @foreach (var cty in _countryList)
                                    {
                                        <MudSelectItem T="string" Value="@cty.ObjectCode" >@cty.ObjectName</MudSelectItem>
                                    }
                                </MudSelect> *@
                                <MudComboBox Clearable="true" Editable="true" Immediate="true" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" SearchBox="true" Strict="true" Variant="Variant.Text" autocomplete="new-password"
                                             Class="moog-mudcombobox" PopoverClass="moog-mudcombobox-popover" TemplateClass="moog-mudcombobox-template" HighlightClass="moog-mudcombobox-highlight"
                                             Label="Made In" Placeholder="Select a country..."
                                             @bind-Value="@CurrentObject.MfgCountryCode" @bind-Text=@_selectedCountryName
                                             T="string" ToStringFunc="@(e => string.IsNullOrEmpty(e) || _countryList.Count == 0 ? "" : _countryList.Single<DropDownListItem>(x => x.ObjectCode == e)?.ObjectName)">
                                    <ChildContent>
                                        @foreach (var cty in _countryList)
                                        {
                                            <MudComboBoxItem T="string" Value="@cty.ObjectCode" Text="@cty.ObjectName">@cty.ObjectName</MudComboBoxItem>
                                        }
                                    </ChildContent>
                                </MudComboBox>
                            </MudItem>
                            <MudItem xs="2">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body1" Style="font-size:9pt">Status</MudText>
                                    <MudChip Size="Size.Small" T="string" Style=@(_stateStyleList[CurrentObject!.ObjectState!])>
                                        @(ObjectStates.GetDisplayText(CurrentObject!.ObjectState).ToUpper())
                                    </MudChip>
                                </MudStack>
                            </MudItem>
                            <MudItem xs="4">
                                <MudAutocomplete Clearable="true" CoerceText="true" CoerceValue="true" Readonly="@IsViewMode" Required="false" ShrinkLabel="true"
                                                 Class="moog-mudform-input" FullWidth="true" PopoverClass="moog-mudautocomplete-popover" InputClass="moog-mudautocomplete-input" ListClass="moog-mudautocomplete-list" ListItemClass="moog-mudautocomplete-listitem"
                                                 ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                                 AdornmentIcon="fa-solid fa-angle-down"
                                                 DebounceInterval="300"
                                                 Label="Brand" T="string"
                                                 @bind-Value="CurrentObject!.Brand" For="@(() => CurrentObject!.Brand)"
                                                 SearchFunc="@SearchBrandName" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="Model"
                                              @bind-Value="CurrentObject!.ModelNo" For="@(() => CurrentObject!.ModelNo)" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="Serial No."
                                              @bind-Value="CurrentObject!.SerialNumber" For="@(() => CurrentObject!.SerialNumber)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              AdornmentIcon="material-symbols-rounded/barcode" Adornment="Adornment.Start"
                                              Label="Barcode"
                                              @bind-Value="CurrentObject!.Barcode" For="@(() => CurrentObject!.Barcode)" MaxLength="50" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              AdornmentIcon="material-symbols-rounded/link" Adornment="Adornment.Start" AdornmentColor="@Color.Primary"
                                              Label="Info Link"
                                              @bind-Value="CurrentObject!.RefLink" For="@(() => CurrentObject!.RefLink)" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              AdornmentIcon="material-symbols-rounded/link" Adornment="Adornment.Start" AdornmentColor="@Color.Primary"
                                              Label="Purchase Link"
                                              @bind-Value="CurrentObject!.PurchaseLink" For="@(() => CurrentObject!.PurchaseLink)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudDatePicker Clearable="true" Editable="true" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                               Class="moog-muddatepicker" ActionsClass="moog-muddatepicker-action" ToolbarClass="moog-muddatepicker-toolbar"
                                               ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                               AdornmentIcon="material-symbols-rounded/calendar_month" AdornmentColor=@Color.Primary
                                               Label="Purchased Date" Placeholder="Purchased Date" DateFormat="dd-MMM-yyyy"
                                               @bind-Date="CurrentObject!.PurchasedDate" For="@(() => CurrentObject!.PurchasedDate)" />
                                @* <PickerActions Context="purchaseDateContext">
                                        <MudButton Class="mr-auto align-self-start" OnClick="PurchasedDateTodayAsync">Today</MudButton>
                                    </PickerActions>
                                </MudDatePicker> *@
                            </MudItem>
                            <MudItem xs="4">
                                <MudStack Row="true" Spacing="1">
                                    <MudAutocomplete Clearable="true" CoerceText="true" CoerceValue="false" Readonly="@IsViewMode" Required="false" ShrinkLabel="true"
                                                     Class="moog-mudform-input" FullWidth="true" PopoverClass="moog-mudautocomplete-popover" InputClass="moog-mudautocomplete-input" ListClass="moog-mudautocomplete-list" ListItemClass="moog-mudautocomplete-listitem"
                                                     ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                                     AdornmentIcon="fa-solid fa-angle-down"
                                                     DebounceInterval="300"
                                                     Label="Purchased From" T="DropdownSelectItem" ToStringFunc="@(e => e == null ? null : $"{e.Value}")"
                                                     Value="_selMerchant" ValueChanged="OnMerchantChanged"
                                                     SearchFunc="@SearchMerchant" />

                                    <MudTooltip Text="Add new merchant"
                                                Placement="Placement.Top" Arrow="true" Style="width:200px; max-width:100px" ShowOnClick="false" ShowOnHover="true" ShowOnFocus="false">
                                        <MudIconButton Size="Size.Medium" Color="Color.Primary" Class="moog-muddatagrid-icon-btn" OnClick="OnAddMerchantBtnClicked"
                                                       Icon="fad fa-circle-plus" aria-label="Add New Merchant" />
                                    </MudTooltip>
                                </MudStack>
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="Order No." Placeholder="Order No."
                                              @bind-Value="CurrentObject!.OtherRefNum1" For="@(() => CurrentObject!.OtherRefNum1)" />
                            </MudItem>
                            <MudItem xs="1">
                                <MudNumericField Clearable="false" HideSpinButtons="true" FullWidth="true" Immediate="true" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                                 Class="moog-mudform-input" 
                                                 ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                                 Label="Quantity" Placeholder="Quantity" T="int?" Step="1" Format="#,##0"
                                                 @bind-Value="CurrentObject!.Quantity" For="(() => CurrentObject.Quantity)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudNumericField Clearable="false" HideSpinButtons="true" FullWidth="true" Immediate="true" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                                 Class="moog-mudform-input"
                                                 ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                                 AdornmentIcon="fad fa-usd-circle" Adornment="Adornment.Start" AdornmentColor="@Color.Primary"
                                                 Label="Purhcased Price" Placeholder="Purchased Cost" T="double?" Step="0.1" Format="#,##0.##"
                                                 @bind-Value="CurrentObject!.PurchasedPrice" For="(() => CurrentObject.PurchasedPrice)" />
                            </MudItem>
                            <MudItem xs="1">
                                <MudNumericField Clearable="false" HideSpinButtons="true" FullWidth="true" Immediate="true" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                                 Class="moog-mudform-input"
                                                 ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                                 AdornmentIcon="fad fa-usd-circle" Adornment="Adornment.Start" AdornmentColor="@Color.Primary"
                                                 Label="Other Cost" Placeholder="Other Cost" T="double?" Step="0.1" Format="#,##0.##"
                                                 @bind-Value="CurrentObject!.OtherCost" For="(() => CurrentObject.OtherCost)" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text" Lines="8" 
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="Item Description" Placeholder="Item description..."
                                              @bind-Value="CurrentObject!.ItemDescription" For="@(() => CurrentObject!.ItemDescription)" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text" Lines="8"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="Remark" Placeholder="Remark..."
                                              @bind-Value="CurrentObject!.Remark" For="@(() => CurrentObject!.Remark)" />
                            </MudItem>
                            @if (CurrentEditContext.GetValidationMessages().Any() || InvalidMsgList.Count > 0)
                            {
                                <MudItem xs="12" Class="pt-4">
                                    @foreach (string msg in CurrentEditContext.GetValidationMessages())
                                    {
                                        <MudAlert Variant="Variant.Outlined" Severity="Severity.Warning" Icon="fad fa-exclamation-circle" Class="moog-alert-validation mt-2">@msg</MudAlert>
                                    }
                                    @foreach (string key in InvalidMsgList.Keys)
                                    {
                                        <MudAlert Variant="Variant.Outlined" Severity="Severity.Warning" Icon="fad fa-exclamation-circle" Class="moog-alert-validation mt-2">@InvalidMsgList[key]</MudAlert>
                                    }
                                </MudItem>
                            }
                        </MudGrid>
                        <MudPaper MinWidth="500px" MaxWidth="500px" MaxHeight="1000px" MinHeight="500px" Class="pa-4" Elevation="0" Style="background-color: var(--tw-gray-50)">
                            <MudCarousel Class="mud-full-width" ShowArrows="false" ShowBullets="true" BulletsPosition="Position.End" EnableSwipeGesture="true" AutoCycle="false" TData="object" Style="min-height:540px">
                                <BulletTemplate Context="selected">
                                    <div Class="mud-button-root mud-icon-button mud-icon-button-color-inherit mud-ripple mud-ripple-icon" style="padding:8px">
                                        <span class="mud-icon-button-label">
                                            <MudIcon Icon="@(selected ? "fas fa-image" : "far fa-image")" Color=@(selected ? Color.Primary : Color.Default) Size="Size.Medium" />
                                        </span>
                                    </div>
                                </BulletTemplate>
                                <ChildContent>
                                    @if (_images.Count > 0)
                                    {
                                        foreach (AttachedImage img in _images)
                                        {
                                            <MudCarouselItem Transition="Transition.Slide" Color="Color.Default">
                                                <div class="d-flex">
                                                    <MudImage Src="@img.ImageUrl" Width="500" Elevation="0" />
                                                </div>
                                            </MudCarouselItem>
                                        }
                                    }
                                    else
                                    {
                                        <MudCarouselItem Transition="Transition.Slide" Color="Color.Default">
                                            <MudImage Src="\image\no_img_available.jpg" Width="500" Elevation="0" />
                                        </MudCarouselItem>
                                    }
                                </ChildContent>
                            </MudCarousel>
                            <MudTooltip Text="Update Images" Arrow="true" Color="Color.Default">
                                <MudFab StartIcon="fas fa-images" Size="Size.Small" Color="Color.Primary" DropShadow="false" OnClick="OnUpdateImageClicked" />
                            </MudTooltip>
                        </MudPaper>
                    </MudStack>
                </MudPaper>
                <MudPaper Class="moog-mudpaper-cruc-pg-status" Height="var(--moog-cruc-pg-status-bar-height)" Elevation="0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Spacing="1" Style="height:100%; padding: 0px 16px">
                        @if (CurrentObject.Id > 0)
                        {
                            <MudText Typo="Typo.subtitle1" Color="Color.Default" >Created by </MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600">@CurrentObject!.CreatedUser</MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Default" > on </MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600">@(CurrentObject!.CreatedDateTimeText)</MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Default" >| Last modified by </MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600">@CurrentObject!.ModifiedUser</MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Default"> on </MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600">@(CurrentObject!.ModifiedDateTimeText)</MudText>
                        }
                    </MudStack>
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Icon="fad fa-circle-info" Text="Other Info" Class="moog-mudtabpanel" PanelClass="moog-mudtabpanel-panel">
                <MudPaper Class="moog-mudpaper-cruc-pg-tab-content" Elevation="0" Height="100%" Square="true" >
                    <MudDataGrid Bordered="false" Dense="true" FixedHeader="true" Hover="true" MultiSelection="false" Square="true" Striped="true"
                                 ColumnResizeMode="ResizeMode.Container" Elevation="0" RowsPerPage="50" SortMode="SortMode.Multiple"
                                 Class="moog-muddatagrid moog-main-pg" Height="100%" 
                                 Items="CurrentObject!.AuditTrails" T="ObjStateHistory">
                        <Columns>
                            <PropertyColumn Title="Date" Property="x => x.EffectiveDate" Format="dd-MMM-yyyy"
                                            HeaderClass="moog-muddatagrid-hdr" CellClass="moog-muddatagrid-cell" />
                            <TemplateColumn Title="Action" Sortable="false" Filterable="false"
                                            HeaderClass="moog-muddatagrid-hdr" CellClass="moog-muddatagrid-cell"
                                            CellStyle="text-align:center" Context="rowData">
                                <CellTemplate>
                                    @* @(ObjectStates.GetDisplayText(rowData.Item.ObjectState).ToUpper()) *@
                                    <MudChip Size="Size.Small" T="string" Class=@($"status-chip-tiny") Style=@_actionBtnStyles[rowData.Item.ActionCode!]>
                                        @(ObjectStateActions.GetDisplayText(rowData.Item.ActionCode).ToUpper())
                                    </MudChip>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="From Status" Sortable="false" Filterable="false"
                                            HeaderClass="moog-muddatagrid-hdr" CellClass="mud-muddatagrid-cell"
                                            CellStyle="text-align:center" Context="rowData">
                                <CellTemplate>
                                    @* @(ObjectStates.GetDisplayText(rowData.Item.ObjectState).ToUpper()) *@
                                    <MudChip Size="Size.Small" T="string" Class=@($"status-chip-tiny") Style=@_stateStyleList[rowData.Item.FromStatus!]>
                                        @(ObjectStates.GetDisplayText(rowData.Item.FromStatus).ToUpper())
                                    </MudChip>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="To Status" Sortable="false" Filterable="false"
                                            HeaderClass="moog-muddatagrid-hdr" CellClass="moog-muddatagrid-cell"
                                            CellStyle="text-align:center"
                                            Context="rowData">
                                <CellTemplate>
                                    @* @(ObjectStates.GetDisplayText(rowData.Item.ObjectState).ToUpper()) *@
                                    <MudChip Size="Size.Small" T="string" Class=@($"status-chip-tiny") Style=@_stateStyleList[rowData.Item.ToStatus!]>
                                        @(ObjectStates.GetDisplayText(rowData.Item.ToStatus).ToUpper())
                                    </MudChip>
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Title="Remark" Property="x => x.Remark"
                                            HeaderClass="moog-muddatagrid-hdr" CellClass="moog-muddatagrid-cell" />
                            <PropertyColumn Title="Created On" Property="x => x.CreatedDateTime"
                                            HeaderClass="moog-muddatagrid-hdr" CellClass="moog-muddatagrid-cell"
                                            Format="dd-MMM-yyyy HH:mm:ss" />
                        </Columns>
                    </MudDataGrid>
                </MudPaper>
            </MudTabPanel>
        </MudTabs>
    </EditForm>
}

