@page "/hms/med-test/{CRUCMode}"
@page "/hms/med-test/{CRUCMode}/{id:int}"

@inherits CRUCPageBase<MedTest>

<PageTitle>Medical Test</PageTitle>
@if (CurrentObject != null && CurrentEditContext != null)
{
    <EditForm EditContext="CurrentEditContext" OnValidSubmit="SaveDummy" OnInvalidSubmit="SaveDummy" style="height:100%; display:flex; flex-direction:column;">
        <DataAnnotationsValidator />
        <MudPaper Class="moog-pg-banner" Elevation="0">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.FlexStart" Spacing="2">
                    <MudIcon Icon="fad fa-list-tree" Color="Color.Primary" Size="Size.Large"></MudIcon>
                    <MudText Typo="Typo.h4" Color="@Color.Primary">@HeaderTitle</MudText>
                    @if (CRUCMode == CRUDCModes.READ)
                    {
                        <MudChip Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string" Style="margin-top:-8px">VIEW</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.UPDATE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string" Style="margin-top:-8px">UPDATE</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.CREATE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string" Style="margin-top:-8px">NEW</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.CLONE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string" Style="margin-top:-8px">NEW (Clone)</MudChip>
                    }
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="2">
                    @if (IsViewMode)
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Default" DropShadow="false" Class="moog-mudbutton"
                                   Disabled=@IsSaving OnClick="Cancel" StartIcon="material-symbols-rounded/close">
                            Close
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" DropShadow="false" Class="moog-mudbutton"
                                   Disabled=@IsSaving OnClick="@(() => Save(false))" StartIcon="fa-regular fa-floppy-disk-circle-arrow-right">
                            Save
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" DropShadow="false" Class="moog-mudbutton"
                                   Disabled=@IsSaving OnClick="@(() => Save(true))" StartIcon="fa-regular fa-floppy-disk">
                            Save & Close
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Default" Size="Size.Small" DropShadow="false" Class="moog-mudbutton"
                                   Disabled=@IsSaving OnClick="Cancel" StartIcon="fa-regular fa-circle-xmark">
                            Cancel
                        </MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>
        <MudTabs Color="Color.Primary" Class="moog-mudtab mt-4" ActiveTabClass="moog-mudtab-tab-active" TabButtonsClass="moog-mudtab-tab-btn" TabHeaderClass="moog-mudtab-tab-hdr" TabPanelsClass="moog-mudtab-tab-panel">
            <MudTabPanel Icon="fad fa-home-lg" Text="Main" Class="moog-mudtabpanel" PanelClass="moog-mudtabpanel-panel">
                <MudPaper Elevation="0" Square="true" Height="calc(100% - var(--moog-cruc-pg-status-bar-height))" Style="overflow-y: auto; background-color: var(--tw-gray-50); scrollbar-width:auto; scrollbar-color:var(--tw-gray-300) var(--tw-gray-50)">
                    <MudGrid Spacing="4" Class="py-4 px-4" Style="margin-left:-8px">
                        <MudItem xs="1">
                            <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="true" ShrinkLabel="true" Variant="Variant.Text"
                                          Class="moog-mudform-input"
                                          ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                          Label="Test Code"
                                          @bind-Value="CurrentObject!.TestCode" For="@(() => CurrentObject!.TestCode)" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="true" ShrinkLabel="true" Variant="Variant.Text"
                                          Class="moog-mudform-input"
                                          ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                          Label="Test Name"
                                          @bind-Value="CurrentObject!.ObjectName" For="@(() => CurrentObject!.ObjectName)" @ref=_mtfObjName />
                        </MudItem>
                        <MudItem xs="3">
                            <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                          Class="moog-mudform-input"
                                          ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                          Label="Name (kh)" Placeholder="ឈ្មោះខ្មែរ"
                                          @bind-Value="CurrentObject!.ObjectNameKh" For="@(() => CurrentObject!.ObjectNameKh)" />
                        </MudItem>
                        <MudItem xs="2">
                            <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="true" ShrinkLabel="true" Variant="Variant.Text"
                                          Class="moog-mudform-input"
                                          ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                          Label="ID"
                                          @bind-Value="CurrentObject!.ObjectCode" For="@(() => CurrentObject!.ObjectCode)" Style="text-transform:uppercase" />
                        </MudItem>
                        <MudItem xs="2">
                            <MudSelect Clearable="true" FitContent="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                       Class="moog-mudform-input" PopoverClass="moog-mudselect-popover" InputClass="moog-mudselect-input" ListClass="moog-mudselect-list" OuterClass="moog-mudselect-outer"
                                       ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                       AdornmentIcon="fa-solid fa-angle-down" AdornmentColor="Color.Primary"
                                       Label="Type" T="int?"
                                       Value="CurrentObject!.MedTestTypeId" For="@(() => CurrentObject!.MedTestTypeId)">
                                @foreach (var item in _medTestTypeList)
                                {
                                    <MudSelectItem T="int?" Value="@item.Id">@item.Value</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                          Class="moog-mudform-input"
                                          ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                          Label="Diagnosis Area"
                                          @bind-Value="CurrentObject!.DiagnosisArea" For="@(() => CurrentObject!.DiagnosisArea)" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text" Lines="18"
                                          Class="moog-mudform-input"
                                          ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                          Label="Description" Placeholder="Description"
                                          @bind-Value=CurrentObject!.TestDesc For="@(() => CurrentObject!.TestDesc)" OnlyValidateIfDirty="true" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text" Lines="18"
                                          Class="moog-mudform-input"
                                          ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                          Label="Diagnosis Note" Placeholder="Diagnosis Note"
                                          @bind-Value=CurrentObject!.DiagnosisNote For="@(() => CurrentObject!.DiagnosisNote)" OnlyValidateIfDirty="true" />
                        </MudItem>
                        @if (CurrentEditContext.GetValidationMessages().Any() || InvalidMsgList.Count > 0)
                        {
                            <MudItem xs="12" Class="pt-4">
                                @foreach (string msg in CurrentEditContext.GetValidationMessages())
                                {
                                    <MudAlert Variant="Variant.Outlined" Severity="Severity.Warning" Icon="fad fa-exclamation-circle" Class="moog-alert-validation mt-2">@msg</MudAlert>
                                }
                                @foreach (string key in InvalidMsgList.Keys)
                                {
                                    <MudAlert Variant="Variant.Outlined" Severity="Severity.Warning" Icon="fad fa-exclamation-circle" Class="moog-alert-validation mt-2">@InvalidMsgList[key]</MudAlert>
                                }
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
                <MudPaper Class="moog-mudpaper-cruc-pg-status" Height="var(--moog-cruc-pg-status-bar-height)" Elevation="0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Spacing="1" Style="height:100%; padding: 0px 16px">
                        @if (CurrentObject.Id > 0)
                        {
                            <MudText Typo="Typo.subtitle1" Color="Color.Default">Created by </MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600">@CurrentObject!.CreatedUser</MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Default"> on </MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600">@(CurrentObject!.CreatedDateTimeText)</MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Default">| Last modified by </MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600">@CurrentObject!.ModifiedUser</MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Default"> on </MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600">@(CurrentObject!.ModifiedDateTimeText)</MudText>
                        }
                    </MudStack>
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Icon="@Icons.Material.Rounded.Info" Text="Other Info">

            </MudTabPanel>
        </MudTabs>
    </EditForm>
}

@code {

    #region UI PARAM
    MudTextField<string>? _mtfObjName;
    IEnumerable<DropdownDataList> _facilityTypeList = [];
    List<DropdownSelectItem> _medTestTypeList = [];
    IMask objIdMask = new RegexMask(@"^[A-Z0-9-_]{0,}$");
    List<AttachedImage> _images = [];

    #endregion

    #region PAGE LIFECYCLE FUNCTIONS
    public override Task SetParametersAsync(ParameterView parameters)
    {
        UrlPrefix = "/hms/healthcare-facility";
        return base.SetParametersAsync(parameters);
    }

    protected override async Task OnInitializedAsync()
    {
        switch (CRUCMode)
        {
            case CRUDCModes.READ:
                {
                    CurrentObject = await Uow.MedTests.GetAsync(Id);
                    IsViewMode = true;
                }
                break;
            case CRUDCModes.CREATE:
                {
                    CurrentObject = new();
                }
                break;
            case CRUDCModes.UPDATE:
                CurrentObject = await Uow.MedTests.GetAsync(Id);
                break;
            case CRUDCModes.CLONE:
                {
                    var tempObj = await Uow.MedTests.GetAsync(Id);
                    CurrentObject = tempObj!.DeepClone();
                    CurrentObject!.Id = 0;
                    CurrentObject!.ObjectCode = null;
                }
                break;
        }

        CurrentEditContext = new EditContext(CurrentObject!);

        await PopulatedUIControls();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_mtfObjName != null && !IsViewMode)
                await _mtfObjName!.FocusAsync();

            // await PopulatedUIControls();
        }
    }
    #endregion

    #region UI FUNCTIONS
    async Task OnUpdateImageClicked()
    {
        DialogParameters<AttachedImagesDiag> param = new();
        param.Add(x => x.Images, _images);

        var diagOptions = new DialogOptions
        {
            BackdropClick = false,
            CloseButton = true,
            CloseOnEscapeKey = false,
            MaxWidth = MaxWidth.Large,
            Position = DialogPosition.Center
        };

        var dialog = await MudDialogSvc.ShowAsync<AttachedImagesDiag>($"IMAGE(S)", param, diagOptions);
        var result = await dialog.Result;
    }
    #endregion

    #region DB UPDATE FUNCTIONS
    protected override async Task ValidatePreSave()
    {
        InvalidMsgList.Clear();

        bool isDuplicated = await Uow.MedTests.IsDuplicateCodeAsync(CurrentObject!.Id, CurrentObject!.ObjectCode!);

        if (isDuplicated)
        {
            InvalidMsgList.Add("ObjectCode_Duplicate", $"Record with ObjectCode='{CurrentObject.ObjectCode}' is already existed.");
        }
    }

    protected override Task PreSaveProcessing()
    {
        CurrentObject!.ObjectCode = CurrentObject!.ObjectCode!.ToUpper();

        return base.PreSaveProcessing();
    }

    protected override async Task<bool> SaveAndCommitProcessing()
    {
        DateTime timestamp = DateTime.Now;

        if (CurrentObject!.Id == 0)
        {
            CurrentObject!.CreatedUser = AuditTrailUser;
            CurrentObject!.CreatedDateTime = timestamp;
        }

        CurrentObject!.ModifiedUser = AuditTrailUser;
        CurrentObject!.ModifiedDateTime = timestamp;

        if (CurrentObject.Id > 0)
        {
            // Update existing record
            bool isUpd = await Uow.MedTests.UpdateAsync(CurrentObject);
            return isUpd;
        }
        else
        {
            int objId = await Uow.MedTests.InsertAsync(CurrentObject);
            if (objId > 0)
                CurrentObject.Id = objId;

            return objId > 0;
        }
        ;
    }
    #endregion

    #region INTERNAL FUNCTIONS
    async Task PopulatedUIControls()
    {
        _facilityTypeList = await Uow.DropdownDataLists.GetForDropdownListAsync(DropdownDataSystems.HEALTH_MANAGEMENT_SYSTEM, typeof(HealthcareFacility).Name, nameof(HealthcareFacility.FacilityTypeDdlId), null);
        _medTestTypeList = await Uow.MedTestTypes.GetForDropdownSelectAsync();
    }
    #endregion
}
