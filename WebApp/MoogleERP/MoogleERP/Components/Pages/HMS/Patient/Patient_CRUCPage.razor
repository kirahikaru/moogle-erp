@page "/hms/patient/{CRUCMode}"
@page "/hms/patient/{CRUCMode}/{id:int}"

@inherits CRUCPageBase<Patient>

@if (CurrentObject != null && CurrentEditContext != null)
{
    <EditForm EditContext="CurrentEditContext" OnValidSubmit="SaveDummy" OnInvalidSubmit="SaveDummy" style="height:100%; display:flex; flex-direction:column;">
        <DataAnnotationsValidator />
        <MudPaper Class="moog-pg-banner" Elevation="0">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Spacing="2">
                    <MudIcon Icon="fad fa-box-heart" Color="Color.Primary" Size="Size.Large"></MudIcon>
                    <MudText Typo="Typo.h4" Color="@Color.Primary">@HeaderTitle</MudText>
                    @if (CRUCMode == CRUDCModes.READ)
                    {
                        <MudChip Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string" Style="margin-top:-12px">VIEW</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.UPDATE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string" Style="margin-top:-12px">UPDATE</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.CREATE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string" Style="margin-top:-12px">NEW</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.CLONE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string" Style="margin-top:-12px">NEW (Clone)</MudChip>
                    }
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="2">
                    @if (IsViewMode)
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Color="Color.Default" Disabled=@IsSaving
                                   Class="moog-mudbutton"
                                   StartIcon="material-symbols-rounded/close" IconSize="Size.Small"
                                   OnClick="Cancel">
                            Close
                        </MudButton>
                    }
                    else if (CRUCMode == CRUDCModes.UPDATE)
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Color="Color.Primary" Disabled=@IsSaving
                                   Class="moog-mudbutton"
                                   StartIcon="material-symbols-rounded/save_as" IconSize="Size.Small"
                                   OnClick="@(() => Save(false))">
                            Save
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Color="Color.Primary" Disabled=@IsSaving
                                   Class="moog-mudbutton"
                                   StartIcon="material-symbols-rounded/save"
                                   OnClick="@(() => Save(true))">
                            Save & Close
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Color="Color.Default" Disabled=@IsSaving
                                   Class="moog-mudbutton"
                                   StartIcon="material-symbols-rounded/cancel" IconSize="Size.Small"
                                   OnClick="Cancel">
                            Cancel
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Color="Color.Default" Disabled=@IsSaving
                                   Class="moog-mudbutton"
                                   StartIcon="material-symbols-rounded/cancel" IconSize="Size.Small"
                                   OnClick="Cancel">
                            Cancel
                        </MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>
        <MudTabs Color="Color.Primary" Class="moog-mudtab mt-4" ActiveTabClass="moog-mudtab-tab-active" TabButtonsClass="moog-mudtab-tab-btn" TabHeaderClass="moog-mudtab-tab-hdr" TabPanelsClass="moog-mudtab-tab-panel">
            <MudTabPanel Icon="fad fa-home-lg" Text="Main" Class="moog-mudtabpanel" PanelClass="moog-mudtabpanel-panel">
                <MudPaper Class="moog-mudpaper-cruc-pg-tab-content" Elevation="0" Square="true" Height="calc(100% - var(--moog-cruc-pg-status-bar-height))" Style="border-bottom-left-radius: 0px; border-bottom-right-radius: 0px">
                    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" StretchItems="StretchItems.All" Spacing="1">
                        <MudGrid Spacing="4" Class="pa-6 py-4">
                            <MudItem xs="2">
                                <MudDatePicker Clearable="true" Editable="true" ReadOnly=@IsViewMode Required="true" ShrinkLabel="true" Variant="Variant.Text"
                                               Class="moog-muddatepicker" ActionsClass="moog-muddatepicker-action" ToolbarClass="moog-muddatepicker-toolbar"
                                               ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                               AdornmentIcon="material-symbols-rounded/calendar_month" AdornmentColor=@Color.Primary
                                               Label="Registration Date" Placeholder="DD-MMM-YYYY" DateFormat="dd-MMM-yyyy"
                                               @bind-Date="CurrentObject!.RegDateTime" For="@(() => CurrentObject!.RegDateTime)" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" >
                                    <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="true" ShrinkLabel="true" Variant="Variant.Text"
                                                  Class="moog-mudform-input"
                                                  ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                                  Label="Given Name" @ref=_mtfObjName
                                                  @bind-Value="CurrentObject!.GivenName" For="@(() => CurrentObject!.GivenName)" />
                                    <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="true" ShrinkLabel="true" Variant="Variant.Text"
                                                  Class="moog-mudform-input"
                                                  ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                                  Label="Surnname" 
                                                  @bind-Value="CurrentObject!.Surname" For="@(() => CurrentObject!.Surname)" />
                                </MudStack>
                            </MudItem>
                            <MudItem xs="4">
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" >
                                    <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                                  Class="moog-mudform-input moog-lang-kh"
                                                  ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                                  Label="Surname" Placeholder="នាមត្រកូល"
                                                  @bind-Value="CurrentObject!.SurnameKh" For="@(() => CurrentObject!.SurnameKh)" />
                                    <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                                  Class="moog-mudform-input moog-lang-kh"
                                                  ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                                  Label="Given Name" Placeholder="នាមខ្លួន"
                                                  @bind-Value="CurrentObject!.SurnameKh" For="@(() => CurrentObject!.SurnameKh)" />
                                </MudStack>
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="true" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="ID" 
                                              @bind-Value="CurrentObject!.ObjectCode" For="@(() => CurrentObject!.ObjectCode)" Style="text-transform:uppercase" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudDatePicker Clearable="true" Editable="true" ReadOnly=@IsViewMode Required="true" ShrinkLabel="true" Variant="Variant.Text"
                                               Class="moog-muddatepicker" ActionsClass="moog-muddatepicker-action" ToolbarClass="moog-muddatepicker-toolbar"
                                               ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                               AdornmentIcon="material-symbols-rounded/calendar_month" AdornmentColor=@Color.Primary
                                               Label="Date of Birth" Placeholder="Purchased Date" DateFormat="dd-MMM-yyyy"
                                               @bind-Date="CurrentObject!.BirthDate" For="@(() => CurrentObject!.BirthDate)" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudSelect Clearable="true" FitContent="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="true" ShrinkLabel="true" Variant="Variant.Text"
                                           Class="moog-mudform-input" PopoverClass="moog-mudselect-popover" InputClass="moog-mudselect-input" ListClass="moog-mudselect-list" OuterClass="moog-mudselect-outer"
                                           ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                           AdornmentIcon="fa-solid fa-angle-down" AdornmentColor="Color.Primary"
                                           Label="Gender" T="string"
                                           Value="@CurrentObject!.Gender" ValueChanged="OnGenderChanged">
                                    @foreach (var gender in _genderList)
                                    {
                                        <MudSelectItem T="string" Value="@gender.Key">@gender.Value</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="3">
                                <MudSelect Clearable="true" FitContent="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="true" ShrinkLabel="true" Variant="Variant.Text"
                                           Class="moog-mudform-input" PopoverClass="moog-mudselect-popover" InputClass="moog-mudselect-input" ListClass="moog-mudselect-list" OuterClass="moog-mudselect-outer"
                                           ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                           AdornmentIcon="fa-solid fa-angle-down" AdornmentColor="Color.Primary"
                                           Label="Marital Status" T="string"
                                           @bind-Value="@CurrentObject!.MaritalStatus" For="@(() => CurrentObject!.MaritalStatus)">
                                    @foreach (var item in _maritalStatusList)
                                    {
                                        <MudSelectItem T="string" Value="@item.Key">@item.Value</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="3">
                                <MudComboBox Clearable="true" Editable="true" FullWidth="true" Immediate="true" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" SearchBox="true" Strict="true" Variant="Variant.Text"
                                             Class="moog-mudcombobox" PopoverClass="moog-mudcombobox-popover" TemplateClass="moog-mudcombobox-template" HighlightClass="moog-mudcombobox-highlight" autocomplete="new-password"
                                             Label="Nationality" T="string"
                                             @bind-Value="@CurrentObject.NatlCtyCode" 
                                             ToStringFunc="@(e => string.IsNullOrEmpty(e) ? "" : _countryList.SingleOrDefault<DropDownListItem>(x => x.ObjectCode == e)?.ObjectName)">
                                    <ChildContent>
                                        @foreach (var cty in _countryList)
                                        {
                                            <MudComboBoxItem T="string" Value="@cty.ObjectCode" Text="@cty.ObjectName">@cty.ObjectName</MudComboBoxItem>
                                        }
                                    </ChildContent>
                                </MudComboBox>
                            </MudItem>
                            <MudItem xs="3">
                                <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              AdornmentIcon="material-symbols-rounded/id_card" Adornment="Adornment.Start" AdornmentColor=@Color.Primary
                                              Label="National ID No."
                                              @bind-Value="CurrentObject!.NationalIdNum" For="@(() => CurrentObject!.NationalIdNum)" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudDatePicker Clearable="true" Editable="true" ReadOnly=@IsViewMode Required="true" ShrinkLabel="true" Variant="Variant.Text"
                                               Class="moog-muddatepicker" ActionsClass="moog-muddatepicker-action" ToolbarClass="moog-muddatepicker-toolbar"
                                               ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                               AdornmentIcon="material-symbols-rounded/calendar_month" AdornmentColor=@Color.Primary
                                               Label="Expiry Date" Placeholder="DD-MMM-YYYY" DateFormat="dd-MMM-yyyy"
                                               @bind-Date="CurrentObject!.NatlIDExpiryDate" For="@(() => CurrentObject!.NatlIDExpiryDate)" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="true" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              AdornmentIcon="material-symbols-rounded/passport" Adornment="Adornment.Start" AdornmentColor=@Color.Primary
                                              Label="Passport No."
                                              @bind-Value="CurrentObject!.PassportNo" For="@(() => CurrentObject!.PassportNo)" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudDatePicker Clearable="true" Editable="true" ReadOnly=@IsViewMode Required="true" ShrinkLabel="true" Variant="Variant.Text"
                                               Class="moog-muddatepicker" ActionsClass="moog-muddatepicker-action" ToolbarClass="moog-muddatepicker-toolbar"
                                               ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                               AdornmentIcon="material-symbols-rounded/calendar_month" AdornmentColor=@Color.Primary
                                               Label="Expiry Date" Placeholder="DD-MMM-YYYY" DateFormat="dd-MMM-yyyy"
                                               @bind-Date="CurrentObject!.PassportExpiryDate" For="@(() => CurrentObject!.PassportExpiryDate)" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              AdornmentIcon="material-symbols-rounded/mobile" Adornment="Adornment.Start" AdornmentColor=@Color.Primary
                                              Label="Phone No. (1)"
                                              @bind-Value="CurrentObject!.PhoneLine1" For="@(() => CurrentObject!.PhoneLine1)" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              AdornmentIcon="material-symbols-rounded/mobile" Adornment="Adornment.Start" AdornmentColor=@Color.Primary
                                              Label="Phone No. (2)"
                                              @bind-Value="CurrentObject!.PhoneLine2" For="@(() => CurrentObject!.PhoneLine2)" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              AdornmentIcon="material-symbols-rounded/mail" Adornment="Adornment.Start" AdornmentColor=@Color.Primary
                                              Label="Email (Personal)"
                                              @bind-Value="CurrentObject!.PersonalEmail" For="@(() => CurrentObject!.PersonalEmail)" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              AdornmentIcon="material-symbols-rounded/mail" Adornment="Adornment.Start" AdornmentColor=@Color.Primary
                                              Label="Email (Work)"
                                              @bind-Value="CurrentObject!.WorkEmail" For="@(() => CurrentObject!.WorkEmail)" />
                            </MudItem>
                            @if (CurrentEditContext.GetValidationMessages().Any() || InvalidMsgList.Count > 0)
                            {
                                <MudItem xs="12" Class="pt-4">
                                    @foreach (string msg in CurrentEditContext.GetValidationMessages())
                                    {
                                        <MudAlert Variant="Variant.Outlined" Severity="Severity.Warning" Icon="fad fa-exclamation-circle" Class="moog-alert-validation mt-2">@msg</MudAlert>
                                    }
                                    @foreach (string key in InvalidMsgList.Keys)
                                    {
                                        <MudAlert Variant="Variant.Outlined" Severity="Severity.Warning" Icon="fad fa-exclamation-circle" Class="moog-alert-validation mt-2">@InvalidMsgList[key]</MudAlert>
                                    }
                                </MudItem>
                            }
                        </MudGrid>
                        <MudPaper MinWidth="500px" MaxWidth="500px" MaxHeight="1000px" MinHeight="500px" Class="pa-4" Elevation="0" Style="background-color: var(--tw-gray-50)">
                            <MudCarousel Class="mud-full-width" ShowArrows="false" ShowBullets="true" BulletsPosition="Position.End" EnableSwipeGesture="true" AutoCycle="false" TData="object" Style="min-height:540px">
                                <BulletTemplate Context="selected">
                                    <div Class="mud-button-root mud-icon-button mud-icon-button-color-inherit mud-ripple mud-ripple-icon" style="padding:8px">
                                        <span class="mud-icon-button-label">
                                            <MudIcon Icon="@(selected ? "fas fa-image" : "far fa-image")" Color=@(selected? Color.Primary: Color.Default) Size="Size.Medium" />
                                        </span>
                                    </div>
                                </BulletTemplate>
                                <ChildContent>
                                    @if (_images.Count > 0)
                                    {
                                        foreach (AttachedImage img in _images)
                                        {
                                            <MudCarouselItem Transition="Transition.Slide" Color="Color.Default">
                                                <div class="d-flex">
                                                    <MudImage Src="@img.ImageUrl" Width="500" Elevation="0" />
                                                </div>
                                            </MudCarouselItem>
                                        }
                                    }
                                    else
                                    {
                                        <MudCarouselItem Transition="Transition.Slide" Color="Color.Default">
                                            <MudImage Src="\image\no_img_available.jpg" Width="500" Elevation="0" />
                                        </MudCarouselItem>
                                    }
                                </ChildContent>
                            </MudCarousel>
                            <MudTooltip Text="Update Images" Arrow="true" Color="Color.Default">
                                <MudFab StartIcon="fas fa-images" Size="Size.Small" Color="Color.Primary" DropShadow="false" OnClick="OnUpdateImageClicked" />
                            </MudTooltip>
                        </MudPaper>
                    </MudStack>
                </MudPaper>
                <MudPaper Class="moog-mudpaper-cruc-pg-status" Height="var(--moog-cruc-pg-status-bar-height)" Elevation="0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Spacing="1" Style="height:100%; padding: 0px 16px">
                        @if (CurrentObject.Id > 0)
                        {
                            <MudText Typo="Typo.subtitle1" Color="Color.Default">Created by </MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600">@CurrentObject!.CreatedUser</MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Default"> on </MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600">@(CurrentObject!.CreatedDateTimeText)</MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Default">| Last modified by </MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600">@CurrentObject!.ModifiedUser</MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Default"> on </MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600">@(CurrentObject!.ModifiedDateTimeText)</MudText>
                        }
                    </MudStack>
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Icon="fad fa-circle-info" Text="Other Info" Class="moog-mudtabpanel" PanelClass="moog-mudtabpanel-panel">
                <MudPaper Class="moog-mudpaper-cruc-pg-tab-content" Elevation="0" Square="true" Height="100%" >
                </MudPaper>
            </MudTabPanel>
        </MudTabs>
    </EditForm>
}

@code {

    #region UI PARAM
    List<DropDownListItem> _countryList = [];
    List<DropdownSelectItem> _genderList = Genders.GetForDropdown();
    List<DropdownSelectItem> _maritalStatusList = MaritalStatuses.GetForDropdown();
    MudTextField<string>? _mtfObjName;
    List<AttachedImage> _images = [];
    #endregion

    #region PAGE LIFECYCLE FUNCTIONS
    public override Task SetParametersAsync(ParameterView parameters)
    {
        UrlPrefix = "/hms/patient";
        return base.SetParametersAsync(parameters);
    }

    protected override async Task OnInitializedAsync()
    {
        switch (CRUCMode)
        {
            case CRUDCModes.READ:
                {
                    CurrentObject = await Uow.Patients.GetAsync(Id);
                    IsViewMode = true;
                }
                break;
            case CRUDCModes.CREATE:
                {
                    CurrentObject = new();
                }
                break;
            case CRUDCModes.UPDATE:
                CurrentObject = await Uow.Patients.GetAsync(Id);
                break;
            case CRUDCModes.CLONE:
                {
                    var tempObj = await Uow.Patients.GetAsync(Id);
                    CurrentObject = tempObj!.DeepClone();
                    CurrentObject!.Id = 0;
                    CurrentObject!.ObjectCode = String.Empty;
                }
                break;
        }

        CurrentEditContext = new EditContext(CurrentObject!);

        if (CurrentObject != null && CurrentObject.Id > 0)
            _images = await Uow.AttachedImages.GetByLinkedObjectAsync(CurrentObject.Id, CurrentObject.GetType().Name);

        await PopulatedUIControls();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_mtfObjName != null && !IsViewMode)
                await _mtfObjName!.FocusAsync();
        }
    }
    #endregion

    #region UI FUNCTIONS
    async Task OnUpdateImageClicked()
    {
        DialogParameters<AttachedImagesDiag> param = new();
        param.Add(x => x.Images, _images);

        var diagOptions = new DialogOptions
        {
            BackdropClick = false,
            CloseButton = true,
            CloseOnEscapeKey = false,
            MaxWidth = MaxWidth.Large,
            Position = DialogPosition.Center
        };

        var dialog = await MudDialogSvc.ShowAsync<AttachedImagesDiag>($"IMAGE(S)", param, diagOptions);
        var result = await dialog.Result;
    }

    void OnGenderChanged(string? value)
    {
        CurrentObject!.Gender = value;
    }
    #endregion

    #region DB UPDATE FUNCTIONS
    protected override async Task ValidatePreSave()
    {
        InvalidMsgList.Clear();

        string? patientID = await Uow.Patients.CheckExistingAsync(CurrentObject!.GivenName! ?? string.Empty, 
            CurrentObject!.Surname ?? string.Empty, CurrentObject!.Gender!, 
            CurrentObject!.BirthDate!.Value, CurrentObject!.Id);

        if (!string.IsNullOrEmpty(patientID))
        {
            InvalidMsgList.Add("ExistingPatient", $"This patient already exist (Patient ID: {patientID!})");
        }
    }

    protected override Task PreSaveProcessing()
    {
        CurrentObject!.ObjectName = CurrentObject!.FullNameText;
        CurrentObject!.ObjectNameKh = CurrentObject!.FullNameKhText;

        return base.PreSaveProcessing();
    }

    protected override async Task<bool> SaveAndCommitProcessing()
    {
        DateTime timestamp = DateTime.Now;

        if (CurrentObject!.Id == 0)   //CREATE
        {
            CurrentObject!.CreatedUser = AuditTrailUser;
            CurrentObject!.ModifiedUser = AuditTrailUser;
            CurrentObject!.CreatedDateTime = timestamp;
            CurrentObject!.ModifiedDateTime = timestamp;

            int objId = await Uow.Patients.InsertAsync(CurrentObject!);

            if (objId > 0)
            {
                CurrentObject!.Id = objId;
                return true;
            }
            else return false;
        }
        else    // UPDATE
        {
            CurrentObject!.ModifiedUser = AuditTrailUser;
            CurrentObject!.ModifiedDateTime = timestamp;

            return await Uow.Patients.UpdateAsync(CurrentObject!);
        }
    }
    #endregion

    #region INTERNAL FUNCTIONS
    async Task PopulatedUIControls()
    {
        _countryList = await Uow.Countries.GetForDropdownSelect1Async();
    }
    #endregion
}
