@page "/pms/medicine/{CRUCMode}"
@page "/pms/medicine/{CRUCMode}/{id:int}"
@using DataLayer.Repos.SysCore

@inherits CRUCPageBase<Medicine>

@if (CurrentObject != null && CurrentEditContext != null)
{
    <EditForm EditContext="CurrentEditContext" OnValidSubmit="SaveDummy" OnInvalidSubmit="SaveDummy" style="height:100%; display:flex; flex-direction:column;">
        <DataAnnotationsValidator />
        <MudPaper Class="moog-pg-banner" Elevation="0">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.FlexStart" Spacing="0">
                    <MudText Typo="Typo.h1" Color="@Color.Primary" Style="font-weight:800; font-size:20pt;">@HeaderTitle</MudText>
                    @if (CRUCMode == CRUDCModes.READ)
                    {
                        <MudChip Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string">VIEW</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.UPDATE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string">UPDATE</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.CREATE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string">NEW</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.CLONE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string">NEW (Clone)</MudChip>
                    }
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="2">
                    @if (IsViewMode)
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton moog-btn-gray" Color="Color.Default"
                                   Disabled=@IsSaving OnClick="Cancel" StartIcon="material-symbols-rounded/close">
                            Close
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Primary" StartIcon="material-symbols-rounded/save_as"
                                   Disabled=@IsSaving OnClick="@(() => Save(false))">
                            Save
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Primary" StartIcon="material-symbols-rounded/save"
                                   Disabled=@IsSaving OnClick="@(() => Save(true))">
                            Save & Close
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Default" StartIcon="material-symbols-rounded/cancel"
                                   Disabled=@IsSaving OnClick="Cancel">
                            Cancel
                        </MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>
        <MudTabs Color="Color.Primary" Class="moog-mudtab mt-4" ActiveTabClass="moog-mudtab-tab-active" TabButtonsClass="moog-mudtab-tab-btn" TabHeaderClass="moog-mudtab-tab-hdr" TabPanelsClass="moog-mudtab-tab-panel">
            <MudTabPanel Icon="fad fa-home-lg" Text="Main" Class="moog-mudtabpanel" PanelClass="moog-mudtabpanel-panel">
                <MudPaper Elevation="0" Square="true" Height="calc(100% - var(--moog-cruc-pg-status-bar-height))" Style="overflow-y: auto; background-color: var(--tw-gray-50); scrollbar-width:auto; scrollbar-color:var(--tw-gray-300) var(--tw-gray-50)">
                    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" StretchItems="StretchItems.All" Spacing="1">
                        <MudGrid Spacing="3" Class="pa-3">
                            <MudItem xs="6">
                                <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="true" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="Name" @ref=_mtfObjName
                                              @bind-Value="CurrentObject!.ObjectName" For="@(() => CurrentObject!.ObjectName)" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="Name (Kh)"
                                              @bind-Value="CurrentObject!.LocalCallName" For="@(() => CurrentObject!.LocalCallName)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="true" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="ID"
                                              @bind-Value="CurrentObject!.ObjectCode" For="@(() => CurrentObject!.ObjectCode)" Style="text-transform:uppercase" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="Sub-Text" 
                                              @bind-Value="CurrentObject!.SubText" For="@(() => CurrentObject!.SubText)" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              AdornmentIcon="material-symbols-rounded/link" Adornment="Adornment.Start" AdornmentColor="@Color.Primary"
                                              Label="Info Link" 
                                              @bind-Value="CurrentObject!.ReferenceLink" For="@(() => CurrentObject!.ReferenceLink)" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudSelect Clearable="true" FitContent="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                           Class="moog-mudform-input" PopoverClass="moog-mudselect-popover" InputClass="moog-mudselect-input" ListClass="moog-mudselect-list" OuterClass="moog-mudselect-outer"
                                           ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                           AdornmentIcon="fa-solid fa-angle-down" AdornmentColor="Color.Primary"
                                           Label="Type" T="int?" 
                                           Value="CurrentObject!.MedicineTypeId" ValueChanged="OnMedicineTypeChanged">
                                    @foreach (var item in _medicineTypeList)
                                    {
                                        <MudSelectItem T="int?" Value="@item.Id">@item.NameEn</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="3">
                                <MudSelect Clearable="true" FitContent="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                           Class="moog-mudform-input" PopoverClass="moog-mudselect-popover" InputClass="moog-mudselect-input" ListClass="moog-mudselect-list" OuterClass="moog-mudselect-outer"
                                           ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                           AdornmentIcon="fa-solid fa-angle-down" AdornmentColor="Color.Primary"
                                           Label="Package Unit"
                                           @bind-Value="CurrentObject!.PackageUnitCode">
                                    @foreach (var item in _packageUnitList)
                                    {
                                        <MudSelectItem T="string" Value="@item.ObjectCode">@item.ObjectName</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="3">
                                <MudSelect Clearable="true" FitContent="true" FullWidth="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                           Class="moog-mudform-input" PopoverClass="moog-mudselect-popover" InputClass="moog-mudselect-input" ListClass="moog-mudselect-list" OuterClass="moog-mudselect-outer"
                                           ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                           AdornmentIcon="fa-solid fa-angle-down" AdornmentColor="Color.Primary"
                                           Label="Consumable Unit" T="string" 
                                           @bind-Value="CurrentObject!.ConsumableUnitCode">
                                    @foreach (var item in _consumableUnitList)
                                    {
                                        <MudSelectItem T="string" Value="@item.ObjectCode">@item.ObjectName</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="3">
                                <MudNumericField Clearable="false" HideSpinButtons="true" FullWidth="true" Immediate="true" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                                 Class="moog-mudform-input"
                                                 ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                                 Label="Height" Placeholder="Height"
                                                 T="double?" @bind-Value="CurrentObject!.ConsumableQuantity" For="(() => CurrentObject.ConsumableQuantity)"
                                                 Step="0.1" Format="#,##0.##" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              AdornmentIcon="material-symbols-rounded/barcode" Adornment="Adornment.Start" AdornmentColor="@Color.Primary"
                                              Label="Barcode"
                                              @bind-Value="CurrentObject!.Barcode" For="@(() => CurrentObject!.Barcode)" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudComboBox Clearable="true" Editable="true" Immediate="true" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" SearchBox="true" Strict="true" Variant="Variant.Text" autocomplete="new-password"
                                             Class="moog-mudcombobox" PopoverClass="moog-mudcombobox-popover" TemplateClass="moog-mudcombobox-template" HighlightClass="moog-mudcombobox-highlight"
                                             Label="Mfg. Country" T="string" ToStringFunc="@(e => string.IsNullOrEmpty(e) ? "" : _countryList.SingleOrDefault<DropDownListItem>(x => x.ObjectCode == e)?.ObjectName)"
                                             @bind-Value="@CurrentObject.MfgCountryCode" @bind-Text=@_selectedCountryName>
                                    <ChildContent>
                                        @foreach (var cty in _countryList)
                                        {
                                            <MudComboBoxItem T="string" Value="@cty.ObjectCode" Text="@cty.ObjectName">@cty.ObjectName</MudComboBoxItem>
                                        }
                                    </ChildContent>
                                </MudComboBox>
                            </MudItem>
                            <MudItem xs="3">
                                <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="Mfg. Company" 
                                              @bind-Value="CurrentObject!.MfgCompanyName" For="@(() => CurrentObject!.MfgCompanyName)" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="Laboratory Name" 
                                              @bind-Value="CurrentObject!.LaboratoryName" For="@(() => CurrentObject!.LaboratoryName)" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="Import Company" 
                                              @bind-Value="CurrentObject!.ImportCompany" For="@(() => CurrentObject!.ImportCompany)" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="Local Distributor" 
                                              @bind-Value="CurrentObject!.LocalDistributor" For="@(() => CurrentObject!.LocalDistributor)" />
                            </MudItem>
                            <MudItem xs="6">
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text" Lines="8"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="Description" Placeholder="Description..."
                                              @bind-Value="CurrentObject!.Description" For="@(() => CurrentObject!.Description)" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text" Lines="8"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="Usage Direction" Placeholder="Usage Direction..."
                                              @bind-Value="CurrentObject!.UsageDirectionDetail" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text" Lines="8"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="Composition" Placeholder="Composition..."
                                              @bind-Value="CurrentObject!.CompositionSummary" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text" Lines="8"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="Dosage" Placeholder="Dosage..."
                                              @bind-Value="CurrentObject!.DosageDetail" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text" Lines="8"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="Ingredient Summary" Placeholder="Ingredient summary..."
                                              @bind-Value="CurrentObject!.IngredientSummary" For="@(() => CurrentObject!.IngredientSummary)" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField Clearable="true" Immediate="false" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text" Lines="8"
                                              Class="moog-mudform-input"
                                              ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
                                              Label="Remark" Placeholder="Remark..."
                                              @bind-Value="CurrentObject!.Remark" For="@(() => CurrentObject!.Remark)" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudStack Spacing="2" Justify=Justify.FlexStart Class="mt-3">
                                    @if (!IsViewMode)
                                    {
                                        <MudStack Row="true" Spacing="2" Justify=Justify.FlexStart>
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" DropShadow="false" FullWidth="false" Class="moog-btn-base moog-btn-tight moog-btn-primary-light" StartIcon="material-symbols-rounded/add_circle"
                                                       OnClick="AddItem" Disabled="!_isEditingComp">
                                                Add
                                            </MudButton>
                                            <MudSwitchM3 ReadOnly=@IsViewMode Class="moog-mud-switch ml-2" Color="@(_isEditingComp? Color.Success: Color.Dark)"
                                                         ThumbIcon="@Icons.Material.Rounded.Check" ThumbOffIcon="@Icons.Material.Rounded.Close" Size="Size.Small"
                                                         Label=@(_isEditingComp ? "Edit ON" : "Edit OFF")
                                                         @bind-Value="_isEditingComp" Style=@(_isEditingComp ? "color:#00C853; font-weight:600" : "color:#B0BEC5") />
                                        </MudStack>
                                    }
                                    @* EditDialogOptions=@(new() { BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true }) *@
                                    <MudDataGrid Class="moog-mud-datagrid" Dense="true" Hover="true" FixedHeader="true" Striped="false" HorizontalScrollbar="true" Elevation="0" ColumnResizeMode="ResizeMode.None" 
                                                 Items="@CurrentObject!.Compositions" T="MedicineComposition" Style="width:100%" @ref="_itemDataGrid"
                                                 ReadOnly=@(IsViewMode || !_isEditingComp) EditTrigger="DataGridEditTrigger.OnRowClick" EditMode="DataGridEditMode.Cell"
                                                 StartedEditingItem="@StartedEditingItem" CanceledEditingItem="@CanceledEditingItem" CommittedItemChanges="@CommittedItemChanges">
                                        <Columns>
                                            <PropertyColumn Title="No." Property="x => x.OrderNo" Sortable="false" Editable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-muddatagrid-cell" + (IsViewMode || !_isEditingComp ? " spacious" : " data-align-top inline-editing"))
                                                            CellStyle="text-align:right" />
                                            <PropertyColumn Title="Composition" Property="x => x.MedicalCompositionCode" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-muddatagrid-cell" + (IsViewMode || !_isEditingComp ? " spacious" : " data-align-top inline-editing"))
                                                            HeaderStyle="min-width:350px" Context="item">
                                                <EditTemplate>
                                                    <MudComboBox ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered moog-ui-combo-box" Editable="true" Variant="Variant.Text" SearchBox="true" Strict="true" autocomplete="new-password"
                                                                 PopoverClass="moog-ui-combo-box-popover" FullWidth="true"
                                                                 Placeholder="Select Composition..."
                                                                 T="int?" Value="@item.Item.MedicalCompositionId" Text=@_selectedMedCompName ValueChanged=@(args => OnMedCompSelectChanged(item.Item, args))
                                                                 ToStringFunc="@(e => !e.HasValue ? "" : _medCompList.Single<DropdownSelectItem>(x => x.Id == e)?.Value)"
                                                                 Style="min-width:250px">
                                                        <ChildContent>
                                                            @foreach (var medComp in _medCompList)
                                                            {
                                                                <MudComboBoxItem T="int?" Value="@medComp.Id" Text="@medComp.Value">@medComp.Value</MudComboBoxItem>
                                                            }
                                                        </ChildContent>
                                                    </MudComboBox>
                                                </EditTemplate>
                                            </PropertyColumn>
                                            <PropertyColumn Title="Composition" Property="x => x.ObjectName" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-muddatagrid-cell" + (IsViewMode || !_isEditingComp ? " spacious" : " data-align-top inline-editing"))
                                                            HeaderStyle="min-width:350px" Context="item">
                                                <EditTemplate>
                                                    <MudTextField Readonly="@(IsViewMode || !string.IsNullOrEmpty(item.Item.MedicalCompositionCode))" Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="true"
                                                                  Placeholder="Composition Name"
                                                                  @bind-Value=item.Item.ObjectName For="@(() => item.Item.ObjectName)" OnlyValidateIfDirty="true" MaxLength="255" />
                                                </EditTemplate>
                                            </PropertyColumn>
                                            <PropertyColumn Title="Quantity Desc" Property="x => x.QtyDesc" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-muddatagrid-cell" + (IsViewMode || !_isEditingComp ? " spacious" : " data-align-top inline-editing"))
                                                            Context="item">
                                                <EditTemplate>
                                                    <MudTextField Readonly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                                                  Placeholder="Quantiy Description"
                                                                  @bind-Value=item.Item.QtyDesc For="@(() => item.Item.QtyDesc)" OnlyValidateIfDirty="true" MaxLength="150" />
                                                </EditTemplate>
                                            </PropertyColumn>
                                            <PropertyColumn Title="Quantity" Property="x => x.Quantity" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-muddatagrid-cell" + (IsViewMode || !_isEditingComp ? " spacious" : " data-align-top inline-editing"))
                                                            HeaderStyle="width:100px; max-width:80px" Context="item" >
                                                <EditTemplate>
                                                    <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true"
                                                                     Placeholder="Qty" Format="#,##0.##" Step="0.1"
                                                                     @bind-Value="item.Item.Quantity" T="double?" For="(() => item.Item.Quantity)"
                                                                     Style="text-align:right" />
                                                </EditTemplate>
                                            </PropertyColumn>
                                            <PropertyColumn Title="Unit" Property="x => x.UnitCode" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-muddatagrid-cell" + (IsViewMode || !_isEditingComp ? " spacious" : " data-align-top inline-editing"))
                                                            HeaderStyle="min-width:200px" Context="item" >
                                                <EditTemplate>
                                                    <MudSelect ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered moog-ui-select" PopoverClass="moog-ui-select-popover"
                                                               Placeholder="Unit"
                                                               T="string" @bind-Value="item.Item.UnitCode">
                                                        @foreach (var uom in _quantityUomList)
                                                        {
                                                            <MudSelectItem T="string" Value="@uom.Key">@uom.Value</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </EditTemplate>
                                            </PropertyColumn>
                                            @* <PropertyColumn Property="x => x.ObjectName" Title="PO#" HeaderClass="mud-datagrid-hdr" HeaderStyle=@DataGridHdrStyle CellClass="mud-datagrid-cell" Context="qi">
                                                <EditTemplate>
                                                    <MudTextField @bind-Value=qi.Item.PurchaseOrderCode Label="PO#" MaxLength="50" Readonly="@IsViewMode" Required="true" Clearable="true" Class="form-field-base required"
                                                                  For="@(() => qi.Item.PurchaseOrderCode)" OnlyValidateIfDirty="true" />
                                                </EditTemplate>
                                            </PropertyColumn>
                                            <PropertyColumn Property="x => x.QuantityWithUnitText" Title="Quantity" HeaderClass="mud-datagrid-hdr" HeaderStyle=@DataGridHdrStyle CellClass="mud-datagrid-cell" Context="qi" CellStyle="text-align:right"
                                                            Filterable="false" Sortable="false">
                                                <EditTemplate>
                                                    <MudNumericField @bind-Value=qi.Item.Quantity Label="Quantity" Step=".1M" Format="#,##0.##" Min="0" HideSpinButtons="true" ReadOnly=@IsViewMode Culture="@CultureInfo.GetCultureInfo("en-US")"
                                                                     For="@(() => qi.Item.Quantity)" OnlyValidateIfDirty="true" Clearable="true" Required="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Numbers" />
                                                </EditTemplate>
                                            </PropertyColumn> *@
                                            <TemplateColumn Title="Action" Hidden=@IsViewMode Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass="moog-muddatagrid-cell inline-editing"
                                                            CellStyle="padding-inline-end:4px; padding-inline-start:4px; padding-top: 2px !important; padding-bottom: 2px !important"
                                                            Context="item">
                                                <CellTemplate>
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.ArrowCircleUp" Size="@Size.Small" Color="Color.Primary" OnClick="@(() => MoveItemUp(item.Item))" />
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.ArrowCircleDown" Size="@Size.Small" Color="Color.Primary" OnClick="@(() => MoveItemDown(item.Item))" />
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.Delete" Size="@Size.Small" Color="Color.Error" OnClick="@(() => RemoveItem(item.Item))" />
                                                </CellTemplate>
                                                <EditTemplate>
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.ArrowCircleUp" Size="@Size.Small" Color="Color.Primary" OnClick="@(() => MoveItemUp(item.Item))" />
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.ArrowCircleDown" Size="@Size.Small" Color="Color.Primary" OnClick="@(() => MoveItemDown(item.Item))" />
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.Delete" Size="@Size.Small" Color="Color.Error" OnClick="@(() => RemoveItem(item.Item))" />
                                                </EditTemplate>
                                            </TemplateColumn>
                                        </Columns>
                                    </MudDataGrid>
                                </MudStack>
                            </MudItem>
                            @if (CurrentEditContext.GetValidationMessages().Any() || InvalidMsgList.Count > 0)
                            {
                                <MudItem xs="12" Class="pt-4">
                                    @foreach (string msg in CurrentEditContext.GetValidationMessages())
                                    {
                                        <MudAlert Variant="Variant.Outlined" Severity="Severity.Warning" Icon="fad fa-exclamation-circle" Class="moog-alert-validation mt-2">@msg</MudAlert>
                                    }
                                    @foreach (string key in InvalidMsgList.Keys)
                                    {
                                        <MudAlert Variant="Variant.Outlined" Severity="Severity.Warning" Icon="fad fa-exclamation-circle" Class="moog-alert-validation mt-2">@InvalidMsgList[key]</MudAlert>
                                    }
                                </MudItem>
                            }
                        </MudGrid>
                        <MudPaper MinWidth="500px" MaxWidth="500px" MaxHeight="1000px" MinHeight="500px" Class="pa-2" Elevation="0">
                            <MudCarousel Class="mud-full-width" ShowArrows="false" ShowBullets="true" BulletsPosition="Position.End" EnableSwipeGesture="true" AutoCycle="false" TData="object" Style="min-height:540px">
                                <BulletTemplate Context="selected">
                                    <div Class="mud-button-root mud-icon-button mud-icon-button-color-inherit mud-ripple mud-ripple-icon" style="padding:8px">
                                        <span class="mud-icon-button-label">
                                            <MudIcon Icon="@(selected ? "fas fa-image" : "far fa-image")" Color=@(selected? Color.Primary: Color.Default) Size="Size.Medium" />
                                        </span>
                                    </div>
                                </BulletTemplate>
                                <ChildContent>
                                    @if (_images.Count > 0)
                                    {
                                        foreach (AttachedImage img in _images)
                                        {
                                            <MudCarouselItem Transition="Transition.Slide" Color="Color.Default">
                                                <div class="d-flex">
                                                    <MudImage Src="@img.ImageUrl" Width="500" Elevation="0" />
                                                </div>
                                            </MudCarouselItem>
                                        }
                                    }
                                    else
                                    {
                                        <MudCarouselItem Transition="Transition.Slide" Color="Color.Default">
                                            <MudImage Src="\image\no_img_available.jpg" Width="500" Elevation="0" />
                                        </MudCarouselItem>
                                    }
                                </ChildContent>
                            </MudCarousel>
                            <MudTooltip Text="Update Images" Arrow="true" Color="Color.Default">
                                <MudFab StartIcon="fas fa-images" Size="Size.Small" Color="Color.Primary" DropShadow="false" OnClick="OnUpdateImageClicked" />
                            </MudTooltip>
                        </MudPaper>
                    </MudStack>
                </MudPaper>
                <MudPaper Height="var(--moog-cruc-pg-status-bar-height)" Elevation="0"
                          Style="padding:0px; background-color:var(--tw-gray-100); border-top-left-radius:0px; border-top-right-radius:0px; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Spacing="1" Style="height:100%; padding: 0px 16px">
                        @if (CurrentObject.Id > 0)
                        {
                            <MudText Typo="Typo.subtitle1" Color="Color.Default">Created by </MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600">@CurrentObject!.CreatedUser</MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Default"> on </MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600">@(CurrentObject!.CreatedDateTimeText)</MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Default">| Last modified by </MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600">@CurrentObject!.ModifiedUser</MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Default"> on </MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600">@(CurrentObject!.ModifiedDateTimeText)</MudText>
                        }
                    </MudStack>
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Icon="@Icons.Material.Rounded.Info" Text="Other Info">
                    
            </MudTabPanel>
        </MudTabs>
    </EditForm>
}

@code {

    #region UI PARAM

    List<DropdownSelectItem> _itemCategoryList = [];
    List<UnitOfMeasure> _packageUnitList = [];
    List<UnitOfMeasure> _consumableUnitList = [];
    List<DropdownSelectItem> _currencyList = [];
    List<DropdownDataList> _medicineTypeList = [];
    List<DropDownListItem> _countryList = [];
    List<DropDownListItem> _itemUnitList = [];
    string? _selectedCountryName;
    string? _selectedMedCompName;
    MudTextField<string>? _mtfObjName;
    List<AttachedImage> _images = [];
    MudDataGrid<MedicineComposition> _itemDataGrid = new();
    IEnumerable<DropdownSelectItem> _medCompList = [];
    IEnumerable<DropdownSelectItem> _quantityUomList = [];

    MedicineComposition? _tempItemToAdd;
    bool _isEditingComp = false;
    #endregion

    #region PAGE LIFECYCLE FUNCTIONS
    public override Task SetParametersAsync(ParameterView parameters)
    {
        UrlPrefix = "/pms/medicine";
        return base.SetParametersAsync(parameters);
    }

    protected override async Task OnInitializedAsync()
    {
        switch (CRUCMode)
        {
            case CRUDCModes.READ:
                {
                    CurrentObject = await Uow.Medicines.GetFullAsync(Id);
                    IsViewMode = true;
                }
                break;
            case CRUDCModes.CREATE:
                {
                    CurrentObject = new();
                }
                break;
            case CRUDCModes.UPDATE:
                CurrentObject = await Uow.Medicines.GetFullAsync(Id);
                break;
            case CRUDCModes.CLONE:
                {
                    var tempObj = await Uow.Medicines.GetAsync(Id);
                    CurrentObject = tempObj!.DeepClone();
                    CurrentObject!.Id = 0;
                    CurrentObject!.ObjectCode = null;
                }
                break;
        }

        CurrentEditContext = new EditContext(CurrentObject!);

        if (CurrentObject != null && CurrentObject.Id > 0)
            _images = await Uow.AttachedImages.GetByLinkedObjectAsync(CurrentObject.Id, CurrentObject.GetType().Name);

        // await PopulatedUIControls();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_mtfObjName != null && !IsViewMode)
                await _mtfObjName!.FocusAsync();

            await PopulatedUIControls();
        }
    }
    #endregion

    #region UI FUNCTIONS
    void OnMedicineTypeChanged(int? medicineTypeId)
    {
        if (medicineTypeId.HasValue)
        {
            CurrentObject!.MedicineTypeId = medicineTypeId;
            DropdownDataList? ddi = _medicineTypeList.SingleOrDefault<DropdownDataList?>(x => x.Id == medicineTypeId);

            if (ddi != null)
                CurrentObject!.MedicineTypeCode = ddi.ObjectCode;
        }
        else
        {
            CurrentObject!.MedicineTypeId = null;
            CurrentObject!.MedicineTypeCode = null;
        }
    }

    async Task OnUpdateImageClicked()
    {
        DialogParameters<AttachedImagesDiag> param = new();
        param.Add(x => x.Images, _images);

        var diagOptions = new DialogOptions
        {
            BackdropClick = false,
            CloseButton = true,
            CloseOnEscapeKey = false,
            MaxWidth = MaxWidth.Large,
            Position = DialogPosition.Center
        };

        var dialog = await MudDialogSvc.ShowAsync<AttachedImagesDiag>($"IMAGE(S)", param, diagOptions);
        var result = await dialog.Result;
    }

    void AddItem()
    {
        _tempItemToAdd = new()
        {
            OrderNo = CurrentObject!.Compositions.Count + 1
        };

        CurrentObject!.Compositions.Add(_tempItemToAdd);
        // _itemDataGrid.SetEditingItemAsync(_tempItemToAdd);
    }

    void MoveItemUp(MedicineComposition medComp)
    {
        if (CurrentObject!.Compositions.Count > 1 && medComp.OrderNo!.Value > 1)
        {
            medComp.OrderNo--;

            MedicineComposition? a = CurrentObject!.Compositions.FirstOrDefault(x => x.IsDeleted == false && x.OrderNo is not null && x.OrderNo == medComp.OrderNo && x != medComp);

            if (a != null)
                a!.OrderNo++;

            CurrentObject!.Compositions = CurrentObject!.Compositions.OrderBy(x => x.OrderNo).ToList();
        }
    }

    void MoveItemDown(MedicineComposition medComp)
    {
        if (CurrentObject!.Compositions.Count > 1 && CurrentObject!.Compositions.Count != medComp.OrderNo!.Value)
        {
            medComp.OrderNo++;

            MedicineComposition? a = CurrentObject!.Compositions.FirstOrDefault(x => x.IsDeleted == false && x.OrderNo is not null && x.OrderNo == medComp.OrderNo && x != medComp);

            if (a != null)
                a!.OrderNo--;

            CurrentObject!.Compositions = CurrentObject!.Compositions.OrderBy(x => x.OrderNo).ToList();
        }
    }

    void RemoveItem(MedicineComposition item)
    {
        foreach (var medComp in CurrentObject!.Compositions.Where(x => !x.IsDeleted && x.OrderNo > item.OrderNo))
        {
            medComp.OrderNo--;
        }

        CurrentObject!.Compositions.Remove(item);
    }

    void StartedEditingItem(MedicineComposition item)
    {

    }

    void CanceledEditingItem(MedicineComposition item)
    {
        if (_tempItemToAdd != null)
        {
            CurrentObject!.Compositions.RemoveAt(CurrentObject!.Compositions.FindIndex(x => x.OrderNo == item.OrderNo));
            _tempItemToAdd = null;
        }
    }

    Task<DataGridEditFormAction> CommittedItemChanges(MedicineComposition item)
    {
        _tempItemToAdd = null;

        return Task.FromResult(DataGridEditFormAction.Close);
    }

    void OnMedCompSelectChanged(MedicineComposition item, int? value)
    {
        if (value.HasValue)
        {
            item.MedicalCompositionId = value;
            DropdownSelectItem? ddi = _medCompList.SingleOrDefault<DropdownSelectItem>(x => x.Id == value);
            if (ddi != null)
            {
                _selectedMedCompName = ddi.Value;
                item.ObjectName = ddi.Value;
                item.MedicalCompositionCode = ddi.Key;
            }

        }
        else
        {
            item!.MedicalCompositionId = null;
            item!.MedicalCompositionCode = null;
            item!.ObjectName = null;
            _selectedMedCompName = null;
        }
    }
    #endregion

    #region DB UPDATE FUNCTIONS
    protected override async Task ValidatePreSave()
    {
        InvalidMsgList.Clear();

        bool isDuplicated = await Uow.Medicines.IsDuplicateCodeAsync(CurrentObject!.Id, CurrentObject!.ObjectCode!);

        if (isDuplicated)
        {
            InvalidMsgList.Add("ObjectCode_Duplicate", $"Record with ObjectCode='{CurrentObject.ObjectCode}' is already existed.");
        }
    }

    protected override Task PreSaveProcessing()
    {
        CurrentObject!.ObjectCode = CurrentObject!.ObjectCode!.ToUpper();
        return base.PreSaveProcessing();
    }

    protected override async Task<bool> SaveAndCommitProcessing()
    {
        DateTime timestamp = DateTime.Now;

        if (CurrentObject!.Id == 0)
        {
            CurrentObject!.CreatedUser = AuditTrailUser;
            CurrentObject!.CreatedDateTime = timestamp;
        }

        CurrentObject!.ModifiedUser = AuditTrailUser;
        CurrentObject!.ModifiedDateTime = timestamp;
        int objId = await Uow.Medicines.CreateOrUpdateFullAsync(CurrentObject);

        if (objId > 0 && _images.Count != 0)
        {
            foreach (AttachedImage img in _images)
            {
                if (img.Id == 0 && !img.IsDeleted)
                {
                    img.LinkedObjectType = CurrentObject!.GetType().Name;
                    img.LinkedObjectId = objId;
                    img.CreatedUser = AuditTrailUser;
                    img.CreatedDateTime = timestamp;
                    img.ModifiedUser = AuditTrailUser;
                    img.ModifiedDateTime = timestamp;

                    int imgId = await Uow.AttachedImages.InsertAsync(img);
                }
                else if (img.Id > 0)
                {
                    img.ModifiedUser = AuditTrailUser;
                    img.ModifiedDateTime = timestamp;
                    bool isImgUpd = await Uow.AttachedImages.UpdateAsync(img);
                }
            }
        }

        return objId > 0;
    }
    #endregion

    #region INTERNAL FUNCTIONS
    async Task PopulatedUIControls()
    {
        _packageUnitList = await Uow.UoMs.GetByTypeAsync(UnitOfMeasureTypes.MEDICINE_PACKAGING);
        _consumableUnitList = await Uow.UoMs.GetByTypeAsync(UnitOfMeasureTypes.MEDICINE_CONSUMABLE);
        _medicineTypeList = await Uow.DropdownDataLists.GetForDropdownListAsync(DropdownDataSystems.PHARMACY_MANAGEMENT_SYSTEM, typeof(Medicine).Name, "MedicineTypeId");
        _currencyList = await Uow.Currencies.GetForDropdownSelect1Async(null);
        
        _countryList = await Uow.Countries.GetForDropdownSelect1Async();

        _medCompList = await Uow.MedicalComps.GetForDropdownSelectAsync();
        _quantityUomList = await Uow.UoMs.GetForDropdownAsync(null, UomTextDisplayOption.NameAndSymbol);
    }
    #endregion
}
