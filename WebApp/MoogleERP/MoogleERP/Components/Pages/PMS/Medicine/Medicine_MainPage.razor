@page "/pms/medicine/main"
@inherits MainPageBase<Medicine>
<MudPaper Class="moog-pg-banner" Elevation="0">
	<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
		<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Spacing="2">
			<MudIcon Icon="fa-duotone fa-pills" Color="Color.Primary" Size="Size.Large"></MudIcon>
			<MudText Typo="Typo.h4" Color="@Color.Primary">@HeaderTitle</MudText>
		</MudStack>
		<MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Primary"
				   StartIcon="fa-regular fa-plus-circle" OnClick="@(args => PerformCRUC(CRUDCModes.CREATE))">
			Add New
		</MudButton>
	</MudStack>
</MudPaper>
<MudPaper Class="moog-mudpaper-main-pg-content mt-5 overflow-y-auto" Elevation="0" Height="100%" Style="display: flex; flex-direction:column">
	<MudStack Class="ma-4" Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" StretchItems="StretchItems.None">
		<MudTextField Clearable="true" Immediate="true" ReadOnly="false" Required="false" ShrinkLabel="true" Variant="Variant.Text"
					  Class="moog-mudform-input"
					  AdornmentIcon="fa-duotone fa-regular fa-magnifying-glass" Adornment="Adornment.Start" AdornmentColor="Color.Primary"
					  ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
					  Placeholder="Search text here..."
					  @bind-Value="SearchText" OnKeyDown="OnSearchTextBoxKeyDown" @ref=UITextBoxSearch Disabled=IsSearching />
		<MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" DropShadow="false" Class="moog-mudbutton"
				   StartIcon="fa-regular fa-magnifying-glass" OnClick="OnSearchClicked">Search</MudButton>
	</MudStack>
	<MudDataGrid Bordered="false" Dense="true" FixedHeader="true" Hover="true" Loading=@IsSearching MultiSelection="false" Square="true" Striped="true"
				 ColumnResizeMode="ResizeMode.Container" Elevation="0" RowsPerPage="@(_showThumbnail ? 30 : 50)" SortMode="SortMode.Multiple"
				 Class="moog-muddatagrid moog-main-pg" Height="calc(100% - 38px)"
				 @bind-SelectedItem=SelectedObject SelectOnRowClick="true" RowClassFunc="SelectedRowClassFunc" 
				 @ref="MainDataGrid" ServerData="ServerDataFunc"
				 T="Medicine" >
		<Columns>
			@if (_showThumbnail)
			{
				<TemplateColumn Title="Logo" HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell"
								CellStyle="padding:2px !important; padding-inline-start:0px; padding-inline-end:0px"
								Context="rowData">
					<CellTemplate>
						<MudImage Src=@(!string.IsNullOrEmpty(rowData.Item.PackageImagePath) ? rowData.Item.PackageImagePath : "image/img_not_found.png") Elevation="0" Height="100" Width="100" FallbackSrc="image/img_not_found.png" />
					</CellTemplate>
				</TemplateColumn>
			}
			@* <PropertyColumn Property="x => x.ObjectName" Title="Name" HeaderClass="moog-muddatagrid-hdr moog-main-pg"  CellClass="moog-muddatagrid-cell" /> *@
            <TemplateColumn Title="Name" Editable="false" Filterable="false" Sortable="false" StickyLeft="true" Resizable="true"
                            HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell" 
							HeaderStyle="min-width:300px" CellStyle="vertical-align:top" Context="rowData">
                <CellTemplate>
                    <MudStack Spacing="1" Row=true AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.body1" Color=@Color.Primary Style="font-weight:500">@rowData.Item.ObjectName</MudText>
                        @if (!string.IsNullOrEmpty(rowData.Item.ReferenceLink))
                        {
                            <MudLink Href="@rowData.Item.ReferenceLink" Target="_blank" Class="d-flex">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Info" />
                            </MudLink>
                        }
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
			<PropertyColumn Title="Type" Property="x => x.TypeText" Editable="false" Filterable="false" Sortable="false" Resizable="true"
                            HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell" />
			<PropertyColumn Title="Composition" Property="x => x.CompositionSummary" Editable="false" Filterable="false" Sortable="false" Resizable="true"
                            HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell"
							HeaderStyle="min-width:488px; max-width: 500px" CellStyle="max-width: 500px" />
			<TemplateColumn Title="Manufactured In" Editable="false" Filterable="false" Sortable="false" Resizable="true"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell" 
							HeaderStyle="white-space:nowrap" CellStyle="white-space:nowrap"
							Context="rowData">
                <CellTemplate>
                    @if (rowData.Item.ManufacturingCountry != null && !string.IsNullOrEmpty(rowData.Item.ManufacturingCountry.FlagIconPath))
                    {
                        <MudStack Row=true AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Spacing="1">
                            <MudImage Src=@(rowData.Item.ManufacturingCountry!.FlagIconPath!) Height="12" />
                            <MudText Typo="Typo.body1">@rowData.Item.ManufacturingCountry.ObjectName</MudText>
                        </MudStack>
                    }
                </CellTemplate>
            </TemplateColumn>
			<PropertyColumn Title="Manufactured By" Property="x => x.MfgCompanyName" Editable="false" Filterable="false" Sortable="false" Resizable="true"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell"
							HeaderStyle="white-space:nowrap" CellStyle="white-space:nowrap" />
			<PropertyColumn Title="Package" Property="x => x.PackageContent" Editable="false" Filterable="false" Sortable="false" Resizable="true"
                            HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell"
							HeaderStyle="white-space:nowrap" CellStyle="white-space:nowrap" />
			<PropertyColumn Title="Pharmaceutical Company" Property="x => x.LaboratoryName" Editable="false" Filterable="false" Sortable="false" Resizable="true"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell"
							HeaderStyle="white-space:nowrap" CellStyle="white-space:nowrap" />
			<PropertyColumn Title="Imported By" Property="x => x.ImportCompany" Editable="false" Filterable="false" Sortable="false" Resizable="true"
                            HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell"
							HeaderStyle="white-space:nowrap" CellStyle="white-space:nowrap" />
			<PropertyColumn Title="Local Distributor" Property="x => x.LocalDistributor" Editable="false" Filterable="false" Sortable="false" Resizable="true"
                            HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell"
							HeaderStyle="white-space:nowrap" CellStyle="white-space:nowrap" />
			<PropertyColumn Title="KH License No." Property="x => x.KhLicNo" Editable="false" Filterable="false" Sortable="false" Resizable="true"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell moog-font-mono"
							HeaderStyle="white-space:nowrap" CellStyle="white-space:nowrap" />
			<PropertyColumn Title="RMP" Property="x => x.RetailMarketPriceText" Editable="false" Filterable="false" Sortable="false" Resizable="true"
                            HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell" CellStyle="text-align:right" />
			<PropertyColumn Title="WSP" Property="x => x.WholeSalePriceText" Editable="false" Filterable="false" Sortable="false" Resizable="true"
                            HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell" CellStyle="text-align:right" />
			<PropertyColumn Title="Barcode" Property="x => x.Barcode" Editable="false" Filterable="false" Sortable="false" Resizable="true"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell moog-font-mono"
							HeaderStyle="white-space:nowrap" CellStyle="white-space:nowrap" />
			<PropertyColumn Title="ID" Property="x => x.ObjectCode" Editable="false" Filterable="false" Sortable="false" Resizable="true"
                            HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell moog-font-mono" />
			<TemplateColumn Title="Action" Editable="false" Filterable="false" Sortable="false" Resizable="true" StickyRight="true"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell"
							HeaderStyle="max-width: 120px; width:500px; justify-items:center" 
							CellStyle="padding-inline-end:4px; padding-inline-start:4px; padding-top: 2px !important; padding-bottom: 2px !important">
				<CellTemplate>
					<MudStack Row="true" Spacing="0">
						<MudIconButton Size="Size.Small" Color="Color.Primary" DropShadow="false" Class="moog-muddatagrid-icon-btn"
									   Icon="fa-duotone fa-light fa-edit"
									   OnClick="@(args => PerformCRUC(CRUDCModes.UPDATE, context.Item.Id))" />
						<MudIconButton Size="Size.Small" Color="Color.Success" Class="moog-muddatagrid-icon-btn"
									   Icon="fa-duotone fa-light fa-clone-plus"
									   OnClick="@(args => PerformCRUC(CRUDCModes.CLONE, context.Item.Id))" />
						<MudIconButton Size="Size.Small" Color="Color.Info" Class="moog-muddatagrid-icon-btn"
									   Icon="fa-duotone fa-light fa-eye"
									   OnClick="@(args => PerformCRUC(CRUDCModes.READ, context.Item.Id))" />
						<MudIconButton Size="Size.Small" Color="Color.Error" Class="moog-muddatagrid-icon-btn"
									   Icon="fa-duotone fa-light fa-trash-xmark"
									   OnClick="@(args => DeleteRecord(context.Item))" />
					</MudStack>
				</CellTemplate>
			</TemplateColumn>
        </Columns>
		<PagerContent>
			<MudDataGridPager T="Medicine" Class="moog-muddatagrid-pager" PageSizeOptions="new[] { 10, 20, 30, 50, 80, 100 }" />
		</PagerContent>
    </MudDataGrid>
</MudPaper>

@code {
	#region UI VARIABLES
	bool _showThumbnail = true;
	#endregion

	#region PAGE LIFECYCLE FUNCTIONS
	public override Task SetParametersAsync(ParameterView parameters)
	{
		UrlPrefix = "/pms/medicine";
		SearchParamName = "medicineSearchParam";
		return base.SetParametersAsync(parameters);
	}

	protected override async Task OnInitializedAsync()
	{
		await Task.CompletedTask;
	}
	#endregion

	#region UI FUNCTIONS
	async Task OnSearchClearClicked(MouseEventArgs args)
	{
		await UITextBoxSearch!.FocusAsync();
		await MainDataGrid.ReloadServerData();
	}
	#endregion

	#region UI BASE FUNCTIONS
	protected override async Task<GridData<Medicine>> ServerDataFunc(GridState<Medicine> gridState, CancellationToken token)
	{
		if (IsSearching) return new GridData<Medicine>
		{
			Items = [],
			TotalItems = 0
		};

		try
		{
			IsSearching = true;
			int totalItemCount = 0;
			//if (gridState.SortDefinitions.Count > 0)
			//{
			//	var firstSort = gridState.SortDefinitions.First();
			//	result = firstSort.Descending
			//		? result.OrderByDescending(firstSort.SortFunc).ToList()
			//		: result.OrderBy(firstSort.SortFunc).ToList();
			//}

			if (gridState.FilterDefinitions.Any())
			{
				//var filterFunctions = gridState.FilterDefinitions.Select(x => x.GenerateFilterFunction());
				//result = result
				//	.Where(x => filterFunctions.All(f => f(x)))
				//	.ToList();
			}
			else
			{
				var result = await Uow.Medicines.SearchNewAsync(PageSize, MainDataGrid.CurrentPage + 1, SearchText);
				MainDataList = result.Value;
				totalItemCount = result.Key;
			}

			//var totalNumberOfFilteredItems = result.Count;

			//result = result
			//	.Skip(gridState.StartIndex)
			//	.Take(gridState.Count)
			//	.ToList();

			return new GridData<Medicine>
			{
				Items = MainDataList,
				TotalItems = totalItemCount
			};
		}
		catch (Exception ex)
		{
			await JsRuntime.InvokeVoidAsync("console.error", ex.GetFullMessage());

			return new GridData<Medicine>
			{
				Items = [],
				TotalItems = 0
			};
		}
		finally
		{
			IsSearching = false;
		}
	}
    #endregion
}
