    #region Item Specification
    // quick filter - filter globally across multiple columns with the same input
    private Func<ItemSpec, bool> _quickItemSpecFilter => x =>
    {
        return !x.IsDeleted;
    };

    void AddItemSpec()
    {
        _tempItemSpecToAdd = new()
        {
            OrderNo = CurrentObject!.Specs.Count + 1
        };

        CurrentObject!.Specs.Add(_tempItemSpecToAdd);
        // _itemDataGrid.SetEditingItemAsync(_tempItemToAdd);
    }

    void MoveItemSpecUp(ItemSpec itemSpec)
    {
        if (CurrentObject!.Specs.Count > 1 && itemSpec.OrderNo!.Value > 1)
        {
            itemSpec.OrderNo--;

            ItemSpec? a = CurrentObject!.Specs.FirstOrDefault(x => x.IsDeleted == false && x.OrderNo is not null && x.OrderNo == itemSpec.OrderNo && x != itemSpec);

            if (a != null)
                a!.OrderNo++;

            CurrentObject!.Specs = CurrentObject!.Specs.OrderBy(x => x.OrderNo).ToList();
        }
    }

    void MoveItemSpecDown(ItemSpec itemSpec)
    {
        if (CurrentObject!.Specs.Count > 1 && CurrentObject!.Specs.Count != itemSpec.OrderNo!.Value)
        {
            itemSpec.OrderNo++;

            ItemSpec? a = CurrentObject!.Specs.FirstOrDefault(x => x.IsDeleted == false && x.OrderNo is not null && x.OrderNo == itemSpec.OrderNo && x != itemSpec);

            if (a != null)
                a!.OrderNo--;

            CurrentObject!.Specs = CurrentObject!.Specs.OrderBy(x => x.OrderNo).ToList();
        }
    }

    void RemoveItemSpec(ItemSpec itemSpec)
    {
        if (itemSpec.Id == 0)
        {
            CurrentObject!.Specs.Remove(itemSpec);

            foreach (var var in CurrentObject!.Specs.Where(x => !x.IsDeleted && x.OrderNo > itemSpec.OrderNo))
            {
                var.OrderNo--;
            }
        }
        else if (itemSpec.Id > 0)
        {
            foreach (var var in CurrentObject!.Specs.Where(x => !x.IsDeleted && x.OrderNo > itemSpec.OrderNo))
                var.OrderNo--;

            itemSpec.OrderNo = null;
            itemSpec.IsDeleted = true;
        }
    }

