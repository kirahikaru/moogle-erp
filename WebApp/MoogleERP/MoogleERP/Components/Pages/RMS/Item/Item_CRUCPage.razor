    {
        if (_tempItemSpecToAdd != null)
        {
            CurrentObject!.Specs.RemoveAt(CurrentObject!.Specs.FindIndex(x => x.OrderNo == item.OrderNo));
            _tempItemSpecToAdd = null;
        }
    }

    Task<DataGridEditFormAction> CommittedItemSpecChanges(ItemSpec item)
