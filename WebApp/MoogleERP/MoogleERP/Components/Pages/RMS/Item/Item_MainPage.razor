@page "/rms/item/main"

@inherits MainPageBase<Item>
<MudPaper Class="moog-pg-banner" Elevation="0">
	<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
		<MudText Typo="Typo.h1" Color="@Color.Primary" Style="font-weight:800; font-size:20pt;">@HeaderTitle</MudText>
		<MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Primary"
				   StartIcon="far fa-plus-circle" OnClick="@(args => PerformCRUC(CRUDCModes.CREATE))">
			Add New
		</MudButton>
	</MudStack>
</MudPaper>
<MudPaper Class="moog-mudpaper-main-pg-content mt-5 overflow-y-auto" Elevation="0" Height="100%" Style="display: flex; flex-direction:column">
	<MudStack Class="ma-4" Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" StretchItems="StretchItems.None">
		<MudTextField Clearable="true" Immediate="true" ReadOnly="false" Required="false" ShrinkLabel="true" Variant="Variant.Text"
					  Class="moog-mudform-input"
					  AdornmentIcon="material-symbols-rounded/search" Adornment="Adornment.Start" AdornmentColor="Color.Primary"
					  ClearIcon="fa-solid fa-xmark" IconSize="Size.Small"
					  Placeholder="Search text here..."
					  @bind-Value="SearchText" OnKeyDown="OnSearchTextBoxKeyDown" @ref=UITextBoxSearch Disabled=IsSearching />
		<MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" DropShadow="false" Class="moog-mudbutton"
				   StartIcon="material-symbols-rounded/search" OnClick="OnSearchClicked">Search</MudButton>
	</MudStack>
	<MudDataGrid Bordered="false" Dense="true" FixedHeader="true" Hover="true" Loading=@IsSearching MultiSelection="false" Square="true" Striped="true" 
				 ColumnResizeMode="ResizeMode.Container" Elevation="0" RowsPerPage="50" SortMode="SortMode.Multiple"
				 Class="moog-muddatagrid moog-main-pg" Height="calc(100% - 38px)"
				 @bind-SelectedItem=SelectedObject SelectOnRowClick="true" RowClassFunc="SelectedRowClassFunc" RowClass="moog-muddatagrid-row"
				 @ref="MainDataGrid" ServerData="ServerDataFunc" T="Item">
		<Columns>
			<PropertyColumn Title="Name" Property="x => x.ObjectName" Editable="false" Filterable="false" Resizable="true" Sortable="false"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell" />
			<PropertyColumn Title="Name (Khmer)" Property="x => x.ObjectNameKh" Editable="false" Filterable="false" Resizable="true" Sortable="false"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell hanuman-regular" />
			<PropertyColumn Title="Barcode" Property="x => x.Barcode" Editable="false" Filterable="false" Resizable="true" Sortable="false"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell moog-font-mono" />
			<TemplateColumn Title="Category" HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell" Context="rowData">
				<CellTemplate>
					<span>@(rowData.Item.Category != null ? rowData.Item.Category.ObjectName : "-")</span>
				</CellTemplate>
			</TemplateColumn>
			<PropertyColumn Title="Brand" Property="x => x.Brand" Editable="false" Filterable="false" Resizable="true" Sortable="false"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell" />
			<PropertyColumn Title="Model" Property="x => x.Model" Editable="false" Filterable="false" Resizable="true" Sortable="false"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell" />
			<TemplateColumn Title="Made In" Editable="false" Filterable="false" Resizable="true" Sortable="false"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell" 
							Context="rowData">
				<CellTemplate>
					@if (rowData.Item.ManufacturedCountry != null && !string.IsNullOrEmpty(rowData.Item.ManufacturedCountry.FlagIconPath))
					{
						<MudStack Row=true AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Spacing="1">
							<MudImage Src=@(rowData.Item.ManufacturedCountry!.FlagIconPath!) Height="12" />
							<MudText Typo="Typo.body1">@rowData.Item.ManufacturedCountry.ObjectName</MudText>
						</MudStack>
					}
				</CellTemplate>
			</TemplateColumn>
			<PropertyColumn Title="RMP" Property="x => x.RetailUnitPriceText" Editable="false" Filterable="false" Resizable="true" Sortable="false"
                            HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell" CellStyle="text-align:right" />
			<PropertyColumn Title="WSP" Property="x => x.WholeSaleUnitPriceText" Editable="false" Filterable="false" Resizable="true" Sortable="false"
                            HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell" CellStyle="text-align:right" />
			<PropertyColumn Title="ID" Property="x => x.ObjectCode" Sortable="false" Filterable="true"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell moog-font-mono" />
			<TemplateColumn Title="Action" Editable="false" Filterable="false" Resizable="true" Sortable="false"
							HeaderClass="moog-muddatagrid-hdr moog-main-pg" CellClass="moog-muddatagrid-cell" 
							HeaderStyle="width:300px; max-width:120px" CellStyle="padding: 0px 10px !important;">
				<CellTemplate>
					<MudStack Row="true" Spacing="0">
						<MudIconButton Size="Size.Small" Color="Color.Primary" DropShadow="false" Class="moog-muddatagrid-icon-btn"
									   Icon="far fa-edit"
									   OnClick="@(args => PerformCRUC(CRUDCModes.UPDATE, context.Item.Id))" />
						<MudIconButton Size="Size.Small" Color="Color.Success" Class="moog-muddatagrid-icon-btn"
									   Icon="far fa-copy"
									   OnClick="@(args => PerformCRUC(CRUDCModes.CLONE, context.Item.Id))" />
						<MudIconButton Size="Size.Small" Color="Color.Info" Class="moog-muddatagrid-icon-btn"
									   Icon="far fa-eye"
									   OnClick="@(args => PerformCRUC(CRUDCModes.READ, context.Item.Id))" />
						<MudIconButton Size="Size.Small" Color="Color.Error" Class="moog-muddatagrid-icon-btn"
									   Icon="far fa-trash-alt"
									   OnClick="@(args => DeleteRecord(context.Item))" />
					</MudStack>
				</CellTemplate>
			</TemplateColumn>
		</Columns>
		<PagerContent>
			<MudDataGridPager T="Item" Class="moog-muddatagrid-pager" PageSizeOptions="new[] { 10, 20, 30, 50, 80, 100 }" />
		</PagerContent>
    </MudDataGrid>
</MudPaper>

@code {
	#region UI VARIABLES

	#endregion

	#region PAGE LIFECYCLE FUNCTIONS
	public override Task SetParametersAsync(ParameterView parameters)
	{
		UrlPrefix = "/rms/item";
		SearchParamName = "itemSearchParam";
		return base.SetParametersAsync(parameters);
	}

	protected override async Task OnInitializedAsync()
	{
		await Task.CompletedTask;
	}
	#endregion

	#region UI FUNCTIONS
	#endregion

	#region UI BASE FUNCTIONS
	protected override async Task<GridData<Item>> ServerDataFunc(GridState<Item> gridState, CancellationToken token)
	{
		if (IsSearching) return new GridData<Item>
		{
			Items = [],
			TotalItems = 0
		};

		try
		{
			IsSearching = true;
			int totalItemCount = 0;
			//if (gridState.SortDefinitions.Count > 0)
			//{
			//	var firstSort = gridState.SortDefinitions.First();
			//	result = firstSort.Descending
			//		? result.OrderByDescending(firstSort.SortFunc).ToList()
			//		: result.OrderBy(firstSort.SortFunc).ToList();
			//}

			if (gridState.FilterDefinitions.Any())
			{
				//var filterFunctions = gridState.FilterDefinitions.Select(x => x.GenerateFilterFunction());
				//result = result
				//	.Where(x => filterFunctions.All(f => f(x)))
				//	.ToList();
			}
			else
			{
				var result = await Uow.Items.SearchNewAsync(PageSize, MainDataGrid.CurrentPage + 1, SearchText);
				MainDataList = result.Value;
				totalItemCount = result.Key;
			}

			//var totalNumberOfFilteredItems = result.Count;

			//result = result
			//	.Skip(gridState.StartIndex)
			//	.Take(gridState.Count)
			//	.ToList();

			return new GridData<Item>
			{
				Items = MainDataList,
				TotalItems = totalItemCount
			};
		}
		catch (Exception ex)
		{
			await JsRuntime.InvokeVoidAsync("console.error", ex.GetFullMessage());

			return new GridData<Item>
			{
				Items = [],
				TotalItems = 0
			};
		}
		finally
		{
			IsSearching = false;
		}
	}
    #endregion
}
