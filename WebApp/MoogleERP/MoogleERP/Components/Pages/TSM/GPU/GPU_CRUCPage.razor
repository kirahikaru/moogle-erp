@page "/tsm/gpu/{CRUCMode}"
@page "/tsm/gpu/{CRUCMode}/{id:int}"

@inherits CRUCPageBase<GPU>

@if (CurrentObject != null && CurrentEditContext != null)
{
    <EditForm EditContext="CurrentEditContext" OnValidSubmit="SaveDummy" OnInvalidSubmit="SaveDummy" style="height:100%; display:flex; flex-direction:column;">
        <DataAnnotationsValidator />
        <MudPaper Class="moog-pg-banner" Elevation="0">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Spacing="2">
                    <MudIcon Icon="fad fa-display" Color="Color.Primary" Size="Size.Large"></MudIcon>
                    <MudText Typo="Typo.h4" Color="@Color.Primary">@HeaderTitle</MudText>
                    @if (CRUCMode == CRUDCModes.READ)
                    {
                        <MudChip Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string" Style="margin-top:-12px">VIEW</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.UPDATE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string" Style="margin-top:-12px">UPDATE</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.CREATE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string" Style="margin-top:-12px">NEW</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.CLONE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string" Style="margin-top:-12px">NEW (Clone)</MudChip>
                    }
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="2">
                    @if (IsViewMode)
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Default"
                                   Disabled=@IsSaving OnClick="Cancel" StartIcon="material-symbols-rounded/close">
                            Close
                        </MudButton>
                    }
                    else if (CRUCMode == CRUDCModes.UPDATE)
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Primary" StartIcon="material-symbols-rounded/save_as"
                                   Disabled=@IsSaving OnClick="@(() => Save(false))">
                            Save
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Primary" StartIcon="material-symbols-rounded/save"
                                   Disabled=@IsSaving OnClick="@(() => Save(true))">
                            Save & Close
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Default" StartIcon="material-symbols-rounded/cancel"
                                   Disabled=@IsSaving OnClick="Cancel">
                            Cancel
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Default" StartIcon="material-symbols-rounded/cancel"
                                   Disabled=@IsSaving OnClick="Cancel">
                            Cancel
                        </MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>
        <MudTabs Color="Color.Primary" Class="moog-mudtab mt-4" ActiveTabClass="moog-mudtab-tab-active" TabButtonsClass="moog-mudtab-tab-btn" TabHeaderClass="moog-mudtab-tab-hdr" TabPanelsClass="moog-mudtab-tab-panel">
            <MudTabPanel Icon="fad fa-home-lg" Text="Main" Class="moog-mudtabpanel" PanelClass="moog-mudtabpanel-panel">
                <MudPaper Class="moog-mudpaper-cruc-pg-tab-content" Elevation="0" Square="true" Height="calc(100% - var(--moog-cruc-pg-status-bar-height))">
                    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" StretchItems="StretchItems.All" Spacing="1">
                        <MudGrid Spacing="4" Class="pa-4" Style="margin-left:-8px">
                            <MudItem xs="6">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="true"
                                              Label="Name" @ref=_mtfObjName
                                              @bind-Value="CurrentObject!.ObjectName" For="@(() => CurrentObject!.ObjectName)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="true" 
                                              Label="ID" 
                                              @bind-Value="CurrentObject!.ObjectCode" For="@(() => CurrentObject!.ObjectCode)" Style="text-transform:uppercase" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Brand"
                                              @bind-Value="CurrentObject!.Brand" For="@(() => CurrentObject!.Brand)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Model"
                                              @bind-Value="CurrentObject!.Model" For="@(() => CurrentObject!.Model)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudDatePicker ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Editable="true" Class="moog-mud-form-field bordered moog-ui-datepicker" Required="false"
                                               AdornmentIcon="material-symbols-rounded/calendar_month" AdornmentColor=@Color.Primary
                                               Label="Release Date" Placeholder="Release Date" DateFormat="dd-MMM-yyyy"
                                               @bind-Date="CurrentObject!.ReleaseDate" For="@(() => CurrentObject!.ReleaseDate)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Release On"
                                              @bind-Value="CurrentObject!.ReleaseDateText" For="@(() => CurrentObject!.ReleaseDateText)" />
                            </MudItem>
                            <MudItem xs="12" Class="mt-3" Style="padding:4px 12px; background-color:var(--ssv-pharma-blue-100)">
                                <MudText Typo="Typo.h1" Style="font-size:18px; font-weight:700; color:var(--ssv-pharma-blue)">Graphics Processor</MudText>
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="GPU Name"
                                              @bind-Value="CurrentObject!.GPUName" For="@(() => CurrentObject!.GPUName)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="GPU Variant"
                                              @bind-Value="CurrentObject!.GPUVariant" For="@(() => CurrentObject!.GPUVariant)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Process Type"
                                              @bind-Value="CurrentObject!.ProcessType" For="@(() => CurrentObject!.ProcessType)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Process Size"
                                              @bind-Value="CurrentObject!.ProcessSize" For="@(() => CurrentObject!.ProcessSize)" />
                            </MudItem>
                            <MudItem xs="4">
                            </MudItem>
                            <MudItem xs="12" Class="mt-3" Style="padding:4px 12px; background-color:var(--ssv-pharma-blue-100)">
                                <MudText Typo="Typo.h1" Style="font-size:18px; font-weight:700; color:var(--ssv-pharma-blue)">Memory</MudText>
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Memory Size (GB)"
                                              @bind-Value="CurrentObject!.MemorySizeGb" For="@(() => CurrentObject!.MemorySizeGb)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Memory Type"
                                              @bind-Value="CurrentObject!.MemoryType" For="@(() => CurrentObject!.MemoryType)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true"
                                                 AdornmentText="bit" Adornment="Adornment.End"
                                                 Label="Memory Bus" Step="1"
                                                 @bind-Value="CurrentObject!.MemoryBusBit" T="int?" For="(() => CurrentObject.MemoryBusBit)"
                                                 Style="text-align:right" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true"
                                                 AdornmentText="GB/s" Adornment="Adornment.End"
                                                 Label="Bandwidth" Step="0.01M"
                                                 @bind-Value="CurrentObject!.Bandwidth" T="decimal?" For="(() => CurrentObject.Bandwidth)"
                                                 Style="text-align:right" />
                            </MudItem>
                            <MudItem xs="4">
                            </MudItem>
                            <MudItem xs="12" Class="mt-3" Style="padding:4px 12px; background-color:var(--ssv-pharma-blue-100)">
                                <MudText Typo="Typo.h1" Style="font-size:18px; font-weight:700; color:var(--ssv-pharma-blue)">
                                    Clock Speeds
                                </MudText>
                            </MudItem>
                            <MudItem xs="2">
                                <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true" Required="false"
                                                 AdornmentText="Mhz" Adornment="Adornment.End"
                                                 Label="Base Clock" Step="1"
                                                 @bind-Value="CurrentObject!.BaseClockMhz" T="int?" For="(() => CurrentObject.BaseClockMhz)"
                                                 Style="text-align:right" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true" Required="false"
                                                 AdornmentText="Mhz" Adornment="Adornment.End"
                                                 Label="Boost Clock" Step="1"
                                                 @bind-Value="CurrentObject!.BoostClockMhz" T="int?" For="(() => CurrentObject.BoostClockMhz)"
                                                 Style="text-align:right" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true" Required="false"
                                                 AdornmentText="Mhz" Adornment="Adornment.End"
                                                 Label="Memory Clock" Step="1"
                                                 @bind-Value="CurrentObject!.MemoryClockMhz" T="int?" For="(() => CurrentObject.MemoryClockMhz)"
                                                 Style="text-align:right" />
                            </MudItem>
                            <MudItem xs="12" Class="mt-3" Style="padding:4px 12px; background-color:var(--ssv-pharma-blue-100)">
                                <MudText Typo="Typo.h1" Style="font-size:18px; font-weight:700; color:var(--ssv-pharma-blue)">
                                    Render Config
                                </MudText>
                            </MudItem>
                            <MudItem xs="2">
                                <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true" Required="false"
                                                 Label="Shading Unit (Core)" Step="1" T="int?"
                                                 @bind-Value="CurrentObject!.ShadingUnitCoreCount" For="(() => CurrentObject.ShadingUnitCoreCount)"
                                                 Style="text-align:right" />
                            </MudItem>
                            <MudItem xs="1">
                                <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true" Required="false"
                                                 Label="TMU" Step="1" T="int?"
                                                 @bind-Value="CurrentObject!.TMU" For="(() => CurrentObject.TMU)"
                                                 Style="text-align:right" />
                            </MudItem>
                            <MudItem xs="1">
                                <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true" Required="false"
                                                 Label="ROP" Step="1" T="int?"
                                                 @bind-Value="CurrentObject!.ROP" For="(() => CurrentObject.ROP)"
                                                 Style="text-align:right" />
                            </MudItem>
                            <MudItem xs="1">
                                <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true" Required="false"
                                                 Label="L1 Cache (Kb)" Step="1" T="int?"
                                                 @bind-Value="CurrentObject!.L1CacheKb" For="(() => CurrentObject.L1CacheKb)"
                                                 Style="text-align:right" />
                            </MudItem>
                            <MudItem xs="1">
                                <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true" Required="false"
                                                 Label="L2 Cache (MB)" Step="1" T="int?"
                                                 @bind-Value="CurrentObject!.L2CacheMb" For="(() => CurrentObject.L2CacheMb)"
                                                 Style="text-align:right" />
                            </MudItem>
                            <MudItem xs="6">
                            </MudItem>
                            <MudItem xs="12" Class="mt-3" Style="padding:4px 12px; background-color:var(--ssv-pharma-blue-100)">
                                <MudText Typo="Typo.h1" Style="font-size:18px; font-weight:700; color:var(--ssv-pharma-blue)">
                                    Graphics Features
                                </MudText>
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="DirectX"
                                              @bind-Value="CurrentObject!.MicrosoftDirectX" For="@(() => CurrentObject!.MicrosoftDirectX)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="OpenGL"
                                              @bind-Value="CurrentObject!.OpenGL" For="@(() => CurrentObject!.OpenGL)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="CUDA"
                                              @bind-Value="CurrentObject!.CUDA" For="@(() => CurrentObject!.CUDA)" />
                            </MudItem>
                            <MudItem xs="6"></MudItem>
                            <MudItem xs="6">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered"
                                              AdornmentIcon="material-symbols-rounded/link" Adornment="Adornment.Start" AdornmentColor="@Color.Primary"
                                              Label="Tech Spec Info URL"
                                              @bind-Value="CurrentObject!.TechSpecInfoUrl" For="@(() => CurrentObject!.TechSpecInfoUrl)" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered"
                                              AdornmentIcon="material-symbols-rounded/link" Adornment="Adornment.Start" AdornmentColor="@Color.Primary"
                                              Label="Product Info URL"
                                              @bind-Value="CurrentObject!.ProductInfoUrl" For="@(() => CurrentObject!.ProductInfoUrl)" />
                            </MudItem>
                            <MudItem xs="12" Class="mt-3"></MudItem>
                            <MudItem xs="12" Style="padding:4px 12px; background-color:var(--ssv-pharma-blue-100)">
                                <MudText Typo="Typo.h1" Style="font-size:18px; font-weight:700; color:var(--ssv-pharma-blue)">Technical Specifications</MudText>
                            </MudItem>
                            <MudItem xs="12">
                                <MudStack Spacing="2" Justify=Justify.FlexStart>
                                    @if (!IsViewMode)
                                    {
                                        <MudStack Row="true" Spacing="2" Justify=Justify.FlexStart>
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" DropShadow="false" FullWidth="false" Class="moog-btn-base moog-btn-tight moog-btn-primary-light" StartIcon="material-symbols-rounded/add_circle"
                                                       OnClick="AddTechSpec" Disabled="!_isEditingTechSpecItem">
                                                Add Spec
                                            </MudButton>
                                            <MudSwitchM3 ReadOnly=@IsViewMode Class="moog-mud-switch ml-2" Color="@(_isEditingTechSpecItem? Color.Success: Color.Dark)"
                                                         ThumbIcon="@Icons.Material.Rounded.Check" ThumbOffIcon="@Icons.Material.Rounded.Close" Size="Size.Small"
                                                         Label=@(_isEditingTechSpecItem ? "Edit ON" : "Edit OFF")
                                                         @bind-Value="_isEditingTechSpecItem" Style=@(_isEditingTechSpecItem ? "color:#00C853; font-weight:600" : "color:#B0BEC5") />
                                        </MudStack>
                                    }
                                    @* EditDialogOptions=@(new() { BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true }) *@
                                    <MudDataGrid Class="moog-mud-datagrid" Dense="true" Hover="true" FixedHeader="true" Striped="false" HorizontalScrollbar="true" Elevation="0" ColumnResizeMode="ResizeMode.None"
                                                 Items="@CurrentObject!.SpecItems" T="TechSpecItem" @ref="_techSpecGrid" NoRecordsContent="_gridNoRecord" Style="width:100%" QuickFilter="_quickTechSpecFilter"
                                                 ReadOnly=@(IsViewMode || !_isEditingTechSpecItem) EditTrigger="DataGridEditTrigger.OnRowClick" EditMode="DataGridEditMode.Cell"
                                                 StartedEditingItem="@StartedEditingItemSpec" CanceledEditingItem="@CanceledEditingItemSpec" CommittedItemChanges="@CommittedItemSpecChanges">
                                        <Columns>
                                            <PropertyColumn Title="No." Property="x => x.OrderNo" Sortable="false" Editable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-muddatagrid-cell" + (IsViewMode ? " spacious" : " data-align-top inline-editing"))
                                                            CellStyle="text-align:right" />
                                            <PropertyColumn Title="Type" Property="x => x.ObjectName" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-muddatagrid-cell" + (IsViewMode ? " spacious" : " data-align-top inline-editing"))
                                                            Context="item">
                                                <EditTemplate>
                                                    <MudTextField Readonly="@IsViewMode" Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="true"
                                                                  Placeholder="Spec Type"
                                                                  @bind-Value=item.Item.ObjectName For="@(() => item.Item.ObjectName)" OnlyValidateIfDirty="true" MaxLength="255" />
                                                </EditTemplate>
                                            </PropertyColumn>
                                            <PropertyColumn Title="Spec Desc" Property="x => x.SpecDesc" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-muddatagrid-cell" + (IsViewMode ? " spacious" : " data-align-top inline-editing"))
                                                            Context="item">
                                                <EditTemplate>
                                                    <MudTextField Readonly="@IsViewMode" Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="true"
                                                                  Placeholder="Spec Value"
                                                                  @bind-Value=item.Item.SpecDesc For="@(() => item.Item.SpecDesc)" OnlyValidateIfDirty="true" MaxLength="255" />
                                                </EditTemplate>
                                            </PropertyColumn>
                                            <PropertyColumn Title="Value" Property="x => x.SpecValue" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-muddatagrid-cell" + (IsViewMode ? " spacious" : " data-align-top inline-editing"))
                                                            HeaderStyle="width:100px; max-width:80px" Context="item">
                                                <EditTemplate>
                                                    <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true"
                                                                     Placeholder="Qty" Format="#,##0.##" Step="0.1M"
                                                                     @bind-Value="item.Item.SpecValue" T="decimal?" For="(() => item.Item.SpecValue)"
                                                                     Style="text-align:right" />
                                                </EditTemplate>
                                            </PropertyColumn>
                                            <PropertyColumn Title="Unit" Property="x => x.UnitCode" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-muddatagrid-cell" + (IsViewMode ? " spacious" : " data-align-top inline-editing"))
                                                            Context="item">
                                                <EditTemplate>
                                                    <MudTextField Readonly="@IsViewMode" Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="true"
                                                                  Placeholder="Unit"
                                                                  @bind-Value=item.Item.UnitCode For="@(() => item.Item.UnitCode)" OnlyValidateIfDirty="true" MaxLength="255" />
                                                </EditTemplate>
                                            </PropertyColumn>
                                            <TemplateColumn Title="Action" Hidden=@IsViewMode Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass="moog-muddatagrid-cell inline-editing"
                                                            CellStyle="padding-inline-end:4px; padding-inline-start:4px; padding-top: 2px !important; padding-bottom: 2px !important"
                                                            Context="item">
                                                <CellTemplate>
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.ArrowCircleUp" Size="@Size.Small" Color="Color.Primary" OnClick="@(() => MoveTechSpecUp(item.Item))" />
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.ArrowCircleDown" Size="@Size.Small" Color="Color.Primary" OnClick="@(() => MoveTechSpecDown(item.Item))" />
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.Delete" Size="@Size.Small" Color="Color.Error" OnClick="@(() => RemoveTechSpec(item.Item))" />
                                                </CellTemplate>
                                                <EditTemplate>
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.ArrowCircleUp" Size="@Size.Small" Color="Color.Primary" OnClick="@(() => MoveTechSpecUp(item.Item))" />
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.ArrowCircleDown" Size="@Size.Small" Color="Color.Primary" OnClick="@(() => MoveTechSpecDown(item.Item))" />
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.Delete" Size="@Size.Small" Color="Color.Error" OnClick="@(() => RemoveTechSpec(item.Item))" />
                                                </EditTemplate>
                                            </TemplateColumn>
                                        </Columns>
                                    </MudDataGrid>
                                </MudStack>
                            </MudItem>
                            @if (CurrentEditContext.GetValidationMessages().Any() || InvalidMsgList.Count > 0)
                            {
                                <MudItem xs="12" Class="pt-4">
                                    @foreach (string msg in CurrentEditContext.GetValidationMessages())
                                    {
                                        <MudAlert Variant="Variant.Outlined" Severity="Severity.Warning" Icon="fad fa-exclamation-circle" Class="moog-alert-validation mt-2">@msg</MudAlert>
                                    }
                                    @foreach (string key in InvalidMsgList.Keys)
                                    {
                                        <MudAlert Variant="Variant.Outlined" Severity="Severity.Warning" Icon="fad fa-exclamation-circle" Class="moog-alert-validation mt-2">@InvalidMsgList[key]</MudAlert>
                                    }
                                </MudItem>
                            }
                        </MudGrid>
                    </MudStack>
                </MudPaper>
                <MudPaper Class="moog-mudpaper-cruc-pg-status" Height="var(--moog-cruc-pg-status-bar-height)" Elevation="0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Spacing="1" Style="height:100%; padding: 0px 16px">
                        @if (CurrentObject.Id > 0)
                        {
                            <MudText Typo="Typo.subtitle1" Color="Color.Default">Created by </MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600">@CurrentObject!.CreatedUser</MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Default"> on </MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600">@(CurrentObject!.CreatedDateTimeText)</MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Default">| Last modified by </MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600">@CurrentObject!.ModifiedUser</MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Default"> on </MudText>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600">@(CurrentObject!.ModifiedDateTimeText)</MudText>
                        }
                    </MudStack>
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Icon="fad fa-circle-info" Text="Other Info" Class="moog-mudtabpanel" PanelClass="moog-mudtabpanel-panel">
                <MudPaper Class="moog-mudpaper-cruc-pg-tab-content" Elevation="0" Square="true" Height="calc(100% - var(--moog-cruc-pg-status-bar-height))">
                    <MudGrid Spacing="3" Class="pa-3">
                        <MudItem xs="12" Style="padding:4px 12px; background-color:var(--ssv-pharma-blue-100)">
                            
                        </MudItem>
                        <MudItem xs="12">
                            
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudTabPanel>
        </MudTabs>
    </EditForm>
}

@code {

    #region UI PARAM
    RenderFragment _gridNoRecord = @<p>No record</p>;
    
    List<DropDownListItem> _countryList = [];

    IEnumerable<string> _brandList = [];
    MudTextField<string>? _mtfObjName;
    
    List<DropdownSelectItem> _currencyList = [];

    MudDataGrid<TechSpecItem> _techSpecGrid = new();
    TechSpecItem? _tempTechSpecToAdd;
    bool _isEditingTechSpecItem = true;
    #endregion

    #region PAGE LIFECYCLE FUNCTIONS
    public override Task SetParametersAsync(ParameterView parameters)
    {
        UrlPrefix = "/tsm/gpu";
        return base.SetParametersAsync(parameters);
    }

    protected override async Task OnInitializedAsync()
    {
        switch (CRUCMode)
        {
            case CRUDCModes.READ:
                {
                    CurrentObject = await UowPg.GPUs.GetAsync(Id);
                    IsViewMode = true;
                }
                break;
            case CRUDCModes.CREATE:
                {
                    CurrentObject = new();
                }
                break;
            case CRUDCModes.UPDATE:
                CurrentObject = await UowPg.GPUs.GetAsync(Id);
                break;
            case CRUDCModes.CLONE:
                {
                    var tempObj = await UowPg.GPUs.GetAsync(Id);
                    CurrentObject = tempObj!.DeepClone();

                    CurrentObject!.Id = 0;
                }
                break;
        }

        if (CurrentObject != null && CurrentObject.Id> 0)
        {
            CurrentObject.SpecItems = await UowPg.TechSpecItems.GetByObjectAsync(CurrentObject.GetType().Name, CurrentObject.Id);
            CurrentObject.IOPorts = await UowPg.DeviceIOPorts.GetByObjectAsync(CurrentObject.GetType().Name, CurrentObject.Id);
        }

        CurrentEditContext = new EditContext(CurrentObject!);

        await PopulatedUIControls();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_mtfObjName != null && !IsViewMode)
                await _mtfObjName!.FocusAsync();
        }
    }
    #endregion

    #region UI FUNCTIONS
    async Task<IEnumerable<string>> SearchBrandName(string value, CancellationToken token)
    {
        // In real life use an asynchronous function for fetching data from an api.
        await Task.Delay(5, token);

        if (string.IsNullOrEmpty(value))
            return _brandList;
        else
            return _brandList.Where(x => x.Contains(value, StringComparison.OrdinalIgnoreCase));
    }
    #endregion

    #region Item Specification
    // quick filter - filter globally across multiple columns with the same input
    private Func<TechSpecItem, bool> _quickTechSpecFilter => x =>
    {
        return !x.IsDeleted;
    };

    void AddTechSpec()
    {
        _tempTechSpecToAdd = new()
        {
            OrderNo = CurrentObject!.SpecItems.Count + 1
        };

        CurrentObject!.SpecItems.Add(_tempTechSpecToAdd);
        // _itemDataGrid.SetEditingItemAsync(_tempItemToAdd);
    }

    void MoveTechSpecUp(TechSpecItem techSpec)
    {
        if (CurrentObject!.SpecItems.Count > 1 && techSpec.OrderNo!.Value > 1)
        {
            techSpec.OrderNo--;

            TechSpecItem? a = CurrentObject!.SpecItems.FirstOrDefault(x => x.IsDeleted == false && x.OrderNo is not null && x.OrderNo == techSpec.OrderNo && x != techSpec);

            if (a != null)
                a!.OrderNo++;

            CurrentObject!.SpecItems = CurrentObject!.SpecItems.OrderBy(x => x.OrderNo).ToList();
        }
    }

    void MoveTechSpecDown(TechSpecItem techSpec)
    {
        if (CurrentObject!.SpecItems.Count > 1 && CurrentObject!.SpecItems.Count != techSpec.OrderNo!.Value)
        {
            techSpec.OrderNo++;

            TechSpecItem? a = CurrentObject!.SpecItems.FirstOrDefault(x => x.IsDeleted == false && x.OrderNo is not null && x.OrderNo == techSpec.OrderNo && x != techSpec);

            if (a != null)
                a!.OrderNo--;

            CurrentObject!.SpecItems = CurrentObject!.SpecItems.OrderBy(x => x.OrderNo).ToList();
        }
    }

    void RemoveTechSpec(TechSpecItem techSpec)
    {
        if (techSpec.Id == 0)
        {
            CurrentObject!.SpecItems.Remove(techSpec);

            foreach (var var in CurrentObject!.SpecItems.Where(x => !x.IsDeleted && x.OrderNo > techSpec.OrderNo))
            {
                var.OrderNo--;
            }
        }
        else if (techSpec.Id > 0)
        {
            foreach (var var in CurrentObject!.SpecItems.Where(x => !x.IsDeleted && x.OrderNo > techSpec.OrderNo))
                var.OrderNo--;

            techSpec.OrderNo = null;
            techSpec.IsDeleted = true;
        }
    }

    void StartedEditingItemSpec(TechSpecItem techSpec)
    {

    }

    void CanceledEditingItemSpec(TechSpecItem techSpec)
    {
        if (_tempTechSpecToAdd != null)
        {
            CurrentObject!.SpecItems.RemoveAt(CurrentObject!.SpecItems.FindIndex(x => x.OrderNo == techSpec.OrderNo));
            _tempTechSpecToAdd = null;
        }
    }

    Task<DataGridEditFormAction> CommittedItemSpecChanges(TechSpecItem techSpec)
    {
        _tempTechSpecToAdd = null;

        return Task.FromResult(DataGridEditFormAction.Close);
    }
    #endregion

    #region DB UPDATE FUNCTIONS
    protected override async Task ValidatePreSave()
    {
        InvalidMsgList.Clear();

        bool isDuplicated = await UowPg.GPUs.IsDuplicateCodeAsync(CurrentObject!.Id, CurrentObject!.ObjectCode!);

        if (isDuplicated)
        {
            InvalidMsgList.Add("ObjectCode_Duplicate", $"Record with ObjectCode='{CurrentObject.ObjectCode}' is already existed.");
        }
    }

    protected override Task PreSaveProcessing()
    {
        CurrentObject!.ObjectCode = CurrentObject!.ObjectCode!.ToUpper();

        if (CurrentObject!.ReleaseDate.HasValue)
            CurrentObject!.ReleaseDateText = CurrentObject!.ReleaseDate.Value.ToString("dd-MMM-yyyy");

        return base.PreSaveProcessing();
    }

    protected override async Task<bool> SaveAndCommitProcessing()
    {
        DateTime timestamp = DateTime.Now;

        if (CurrentObject!.Id == 0)
        {
            CurrentObject!.CreatedUser = AuditTrailUser;
            CurrentObject!.CreatedDateTime = timestamp;
            CurrentObject!.ModifiedUser = AuditTrailUser;
            CurrentObject!.ModifiedDateTime = timestamp;
            int objId = await UowPg.GPUs.ManualInsertAsync(GPU.GetPgFieldList(UowPg.DbContext.DbType), CurrentObject.GetParamValues(UowPg.DbContext.DbType));

            if (objId > 0)
            {
                foreach (TechSpecItem specItem in CurrentObject.SpecItems)
                {
                    if (specItem.IsDeleted) continue;

                    int specItemId = await UowPg.TechSpecItems.ManualInsertAsync(TechSpecItem.GetPgFieldList(UowPg.DbContext.DbType), specItem.GetParamValues(UowPg.DbContext.DbType));
                }
            }

            return objId > 0;
        }
        else if (CurrentObject!.Id > 0)
        {
            CurrentObject!.ModifiedUser = AuditTrailUser;
            CurrentObject!.ModifiedDateTime = timestamp;
            int updCount = await UowPg.GPUs.ManualUpdateAsync(GPU.GetPgFieldList(UowPg.DbContext.DbType), CurrentObject.GetParamValues(UowPg.DbContext.DbType, true));

            if (updCount > 0)
            {
                foreach (TechSpecItem specItem in CurrentObject.SpecItems)
                {
                    if (specItem.Id == 0 & specItem.IsDeleted) continue;

                    if (specItem.Id > 0)
                    {
                        int specUpdCount = await UowPg.TechSpecItems.ManualUpdateAsync(TechSpecItem.GetPgFieldList(UowPg.DbContext.DbType), specItem.GetParamValues(UowPg.DbContext.DbType, true));
                    }
                    else if (specItem.Id == 0)
                    {
                        int specItemId = await UowPg.TechSpecItems.ManualInsertAsync(TechSpecItem.GetPgFieldList(UowPg.DbContext.DbType), specItem.GetParamValues(UowPg.DbContext.DbType));
                    }
                }
            }

            return updCount > 0;
        }
        else
            return false;
    }
    #endregion

    #region INTERNAL FUNCTIONS
    async Task PopulatedUIControls()
    {
        _brandList = await Uow.Brands.GetAllBrandNamesAsync();
        _countryList = await Uow.Countries.GetForDropdownSelect1Async();
        _currencyList = await Uow.Currencies.GetForDropdownSelect1Async(null);
    }
    #endregion
}
