@page "/tsm/laptop/{CRUCMode}"
@page "/tsm/laptop/{CRUCMode}/{id:int}"

@inherits CRUCPageBase<Laptop>

@if (CurrentObject != null && CurrentEditContext != null)
{
    <EditForm EditContext="CurrentEditContext" OnValidSubmit="SaveDummy" OnInvalidSubmit="SaveDummy" style="height:100%; display:flex; flex-direction:column;">
        <DataAnnotationsValidator />
        <MudPaper Class="moog-pg-banner" Elevation="0">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Spacing="2">
                    <MudIcon Icon="fad fa-laptop" Color="Color.Primary" Size="Size.Large"></MudIcon>
                    <MudText Typo="Typo.h4" Color="@Color.Primary">@HeaderTitle</MudText>
                    @if (CRUCMode == CRUDCModes.READ)
                    {
                        <MudChip Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string" Style="margin-top:-12px">VIEW</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.UPDATE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string" Style="margin-top:-12px">UPDATE</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.CREATE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string" Style="margin-top:-12px">NEW</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.CLONE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="moog-pg-banner-chip" T="string" Style="margin-top:-12px">NEW (Clone)</MudChip>
                    }
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="2">
                    @if (IsViewMode)
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Default"
                                   Disabled=@IsSaving OnClick="Cancel" StartIcon="material-symbols-rounded/close">
                            Close
                        </MudButton>
                    }
                    else if (CRUCMode == CRUDCModes.UPDATE)
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Primary" StartIcon="material-symbols-rounded/save_as"
                                   Disabled=@IsSaving OnClick="@(() => Save(false))">
                            Save
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Primary" StartIcon="material-symbols-rounded/save"
                                   Disabled=@IsSaving OnClick="@(() => Save(true))">
                            Save & Close
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Default" StartIcon="material-symbols-rounded/cancel"
                                   Disabled=@IsSaving OnClick="Cancel">
                            Cancel
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-mudbutton" Color="Color.Default" StartIcon="material-symbols-rounded/cancel"
                                   Disabled=@IsSaving OnClick="Cancel">
                            Cancel
                        </MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>
        <MudTabs Color="Color.Primary" Class="moog-mudtab mt-4" ActiveTabClass="moog-mudtab-tab-active" TabButtonsClass="moog-mudtab-tab-btn" TabHeaderClass="moog-mudtab-tab-hdr" TabPanelsClass="moog-mudtab-tab-panel">
            <MudTabPanel Icon="fad fa-home-lg" Text="Main" Class="moog-mudtabpanel" PanelClass="moog-mudtabpanel-panel">
                <MudPaper Class="moog-mudpaper-cruc-pg-tab-content" Elevation="0" Square="true" Height="calc(100% - var(--moog-cruc-pg-status-bar-height))" Style="border-bottom-left-radius: 0px; border-bottom-right-radius: 0px">
                    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" StretchItems="StretchItems.All" Spacing="1">
                        <MudGrid Spacing="4" Class="pa-4" Style="margin-left:-8px">
                            <MudItem xs="5">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="true"
                                              Label="Name" @ref=_mtfObjName
                                              @bind-Value="CurrentObject!.ObjectName" For="@(() => CurrentObject!.ObjectName)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="true" 
                                              Label="ID" 
                                              @bind-Value="CurrentObject!.ObjectCode" For="@(() => CurrentObject!.ObjectCode)" Style="text-transform:uppercase" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="true"
                                              Label="Series"
                                              @bind-Value="CurrentObject!.Series" For="@(() => CurrentObject!.Series)" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="true"
                                              Label="Color(s)"
                                              @bind-Value="CurrentObject!.Colors" For="@(() => CurrentObject!.Colors)" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudAutocomplete Readonly="@IsViewMode" Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered moog-ui-autocomplete" FullWidth="true" PopoverClass="moog-mudautocomplete-popover"
                                                 CoerceText="true" CoerceValue="true" DebounceInterval="300"
                                                 Label="Brand" T="string"
                                                 @bind-Value="CurrentObject!.Brand" For="@(() => CurrentObject!.Brand)"
                                                 SearchFunc="@SearchBrandName" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Model" 
                                              @bind-Value="CurrentObject!.Model" For="@(() => CurrentObject!.Model)" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Launch Date/Year"
                                              @bind-Value="CurrentObject!.ModelDateText" For="@(() => CurrentObject!.ModelDateText)" />
                            </MudItem>
                            <MudItem xs="3">
                                <MudNumericField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true"
                                                 AdornmentText="kg" Adornment="Adornment.End"
                                                 Label="Weight" Placeholder="Weight" T="decimal?"
                                                 @bind-Value="CurrentObject!.WeightKg" For="(() => CurrentObject.WeightKg)"
                                                 Step="0.01M" Format="#,##0.##" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Display Spec" 
                                              @bind-Value="CurrentObject!.DisplaySpec" For="@(() => CurrentObject!.DisplaySpec)" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true"
                                                 Label="Display Size (inch)" Step="0.1M" 
                                                 @bind-Value="CurrentObject.DisplaySizeInch" T="decimal?" For="(() => CurrentObject.DisplaySizeInch)"
                                                 Style="text-align:right" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Display Resolution"
                                              @bind-Value="CurrentObject!.DisplayResolution" For="@(() => CurrentObject!.DisplayResolution)" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true"
                                                 Label="Refresh Rate (Hz)" Step="1"
                                                 @bind-Value="CurrentObject.DisplayRefreshRateHz" T="int?" For="(() => CurrentObject.DisplayRefreshRateHz)"
                                                 Style="text-align:right" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Panel Type"
                                              @bind-Value="CurrentObject!.DisplayPanelType" For="@(() => CurrentObject!.DisplayPanelType)" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true"
                                                 AdornmentText="nit(s)" Adornment="Adornment.End"
                                                 Label="Max Brightness" Step="1"
                                                 @bind-Value="CurrentObject.DisplayBrightnessNits" T="int?" For="(() => CurrentObject.DisplayBrightnessNits)"
                                                 Style="text-align:right" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Battery"
                                              @bind-Value="CurrentObject!.Battery" For="@(() => CurrentObject!.Battery)" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Power Supply"
                                              @bind-Value="CurrentObject!.PowerSupply" For="@(() => CurrentObject!.PowerSupply)" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Keyboard & Touchpad"
                                              @bind-Value="CurrentObject!.KeyboardTouchpad" For="@(() => CurrentObject!.KeyboardTouchpad)" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Camera"
                                              @bind-Value="CurrentObject!.Camera" For="@(() => CurrentObject!.Camera)" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Audio" Lines="6"
                                              @bind-Value="CurrentObject!.Audio" For="@(() => CurrentObject!.Audio)" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Network & Communication" Lines="6"
                                              @bind-Value="CurrentObject!.NetworkAndComm" For="@(() => CurrentObject!.NetworkAndComm)" />
                            </MudItem>
                            @* <MudItem xs="7">
                                <MudStack Row=true Spacing="2" Justify="Justify.FlexStart">
                                    <MudSelect ReadOnly=@IsViewMode ShrinkLabel="true" Clearable="true" Class="moog-mud-form-field bordered moog-ui-select" PopoverClass="moog-ui-select-popover"
                                               Label="Size Unit" T="string"
                                               Value="@CurrentObject!.DimensionUnitCode" For="(() => CurrentObject.DimensionUnitCode)" ValueChanged="OnDimensionUnitChanged">
                                        @foreach (var uom in _dimensionUnitList)
                                        {
                                            <MudSelectItem T="string" Value="@uom.ObjectCode">@uom.NameWithSymbol</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true"
                                                     Adornment="Adornment.End" AdornmentText="@_dimensionUnitSymbol"
                                                     Label="Height" T="decimal?" Placeholder="Height"
                                                     @bind-Value="CurrentObject!.DimensionHeight" For="(() => CurrentObject.DimensionHeight)"
                                                     Step="0.1M" Format="#,##0.##" />
                                    <MudNumericField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true"
                                                     Adornment="Adornment.End" AdornmentText="@_dimensionUnitSymbol"
                                                     Label="Length" Placeholder="Length" T="decimal?"
                                                     @bind-Value="CurrentObject!.DimensionLength" For="(() => CurrentObject.DimensionLength)"
                                                     Step="0.1M" Format="#,##0.##" />
                                    <MudNumericField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true"
                                                     Adornment="Adornment.End" AdornmentText="@_dimensionUnitSymbol"
                                                     Label="Width" Placeholder="Width" T="decimal?"
                                                     @bind-Value="CurrentObject!.DimensionWidth" For="(() => CurrentObject.DimensionWidth)" 
                                                     Step="0.1M" Format="#,##0.##" />
                                </MudStack>
                            </MudItem> *@
                            <MudItem xs="6">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered"
                                              AdornmentIcon="material-symbols-rounded/link" Adornment="Adornment.Start" AdornmentColor="@Color.Primary"
                                              Label="Product Info URL"
                                              @bind-Value="CurrentObject!.ProductInfoUrl" For="@(() => CurrentObject!.ProductInfoUrl)" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered"
                                              AdornmentIcon="material-symbols-rounded/link" Adornment="Adornment.Start" AdornmentColor="@Color.Primary"
                                              Label="Tech Spec URL"
                                              @bind-Value="CurrentObject!.TechSpecInfoUrl" For="@(() => CurrentObject!.TechSpecInfoUrl)" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Lines="16"
                                              Label="Feature(s)" Placeholder="Description..." 
                                              @bind-Value="CurrentObject!.Features" For="@(() => CurrentObject!.Features)" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Lines="16"
                                              Label="Notes" Placeholder="Note..."
                                              @bind-Value="CurrentObject!.Notes" For="@(() => CurrentObject!.Notes)" />
                            </MudItem>
                            <MudItem xs="12" Class="mt-3"></MudItem>
                            <MudItem xs="12" Style="padding:4px 12px; background-color:var(--ssv-pharma-blue-100)">
                                <MudText Typo="Typo.h1" Style="font-size:18px; font-weight:700; color:var(--ssv-pharma-blue)">Variation</MudText>
                            </MudItem>
                            <MudItem xs="12">
                                <MudStack Spacing="2" Justify=Justify.FlexStart >
                                    @if (!IsViewMode)
                                    {
                                        <MudStack Row="true" Spacing="2" Justify=Justify.FlexStart>
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" DropShadow="false" FullWidth="false" Class="moog-btn-base moog-btn-tight moog-btn-primary-light" StartIcon="material-symbols-rounded/add_circle"
                                                       OnClick="AddSpecVar" >
                                                Add Variation
                                            </MudButton>
                                            @* <MudSwitchM3 ReadOnly=@IsViewMode Class="moog-mud-switch ml-2" Color="@(_isEditingSpecVar ? Color.Success: Color.Dark)"
                                                         ThumbIcon="@Icons.Material.Rounded.Check" ThumbOffIcon="@Icons.Material.Rounded.Close" Size="Size.Small"
                                                         Label=@(_isEditingSpecVar ? "Edit ON" : "Edit OFF")
                                                         @bind-Value="_isEditingSpecVar" Style=@(_isEditingSpecVar ? "color:#00C853; font-weight:600" : "color:#B0BEC5") /> *@
                                        </MudStack>
                                    }
                                    @* EditDialogOptions=@(new() { BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true }) *@
                                    <MudDataGrid Class="moog-mud-datagrid" Dense="true" Hover="true" FixedHeader="true" Striped="false" HorizontalScrollbar="true" Elevation="0" ColumnResizeMode="ResizeMode.None"
                                                 Items="@CurrentObject!.SpecVariations" T="LaptopSpecVar" @ref="_specVarGrid" NoRecordsContent="_gridNoRecord" Style="width:100%" QuickFilter="_quickSpecVarFilter"
                                                 ReadOnly=@IsViewMode EditTrigger="DataGridEditTrigger.Manual" EditMode="DataGridEditMode.Form" EditDialogOptions="new DialogOptions { MaxWidth = MaxWidth.ExtraLarge }"
                                                 StartedEditingItem="@StartedEditingSpecVar" CanceledEditingItem="@CanceledEditingSpecVar" CommittedItemChanges="@CommittedSpecVarChanges">
                                        <Columns>
                                            <PropertyColumn Title="No." Property="x => x.SeqNo" Sortable="false" Editable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-muddatagrid-cell" + ((IsViewMode || !_isEditingSpecVar) ? " spacious" : " data-align-top inline-editing"))
                                                            CellStyle="text-align:right" Context="item" >
                                                            <EditTemplate>

                                                            </EditTemplate>
                                            </PropertyColumn>
                                            <PropertyColumn Title="Type" Property="x => x.ObjectName" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-muddatagrid-cell" + ((IsViewMode || !_isEditingSpecVar) ? " spacious" : " data-align-top inline-editing"))
                                                            Context="item">
                                                <EditTemplate>
                                                    <MudTextField Readonly="@IsViewMode" Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="true"
                                                                  Placeholder="Spec Type"
                                                                  @bind-Value=item.Item.ObjectName For="@(() => item.Item.ObjectName)" OnlyValidateIfDirty="true" MaxLength="255" />
                                                </EditTemplate>
                                            </PropertyColumn>
                                            <PropertyColumn Title="Model" Property="x => x.ObjectName" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-muddatagrid-cell" + ((IsViewMode || !_isEditingSpecVar) ? " spacious" : " data-align-top inline-editing"))
                                                            Context="item">
                                                <EditTemplate>
                                                    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.FlexStart" Spacing="2" Class="mt-3">
                                                        <MudTextField Readonly="@IsViewMode" Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                                                      Label="Model"
                                                                      @bind-Value=item.Item.Model For="@(() => item.Item.Model)" OnlyValidateIfDirty="true" MaxLength="150" />
                                                    </MudStack>
                                                </EditTemplate>
                                            </PropertyColumn>
                                            
                                            <PropertyColumn Title="CPU" Property="x => x.CpuName" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-muddatagrid-cell" + ((IsViewMode || !_isEditingSpecVar) ? " spacious" : " data-align-top inline-editing"))
                                                            Context="item">
                                                <EditTemplate>
                                                    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.FlexStart" Spacing="2" Class="mt-3">
                                                        <MudComboBox ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Editable="true" Class="moog-mud-form-field bordered moog-ui-combo-box" Variant="Variant.Text" SearchBox="true" Strict="true" autocomplete="new-password" Required="false"
                                                                     PopoverClass="moog-ui-combo-box-popover" T="int?"
                                                                     AdornmentIcon="@Icons.Material.Rounded.ArrowDownward" Adornment="Adornment.End"
                                                                     OpenIcon="@Icons.Material.Rounded.AccessAlarm"
                                                                     Label="CPU"
                                                                     ToStringFunc="@(e => (e is null || e!.Value < 0) ? "" : _cpuList.SingleOrDefault<DropdownSelectItem>(x => x.Id == e)?.Value)"
                                                                     Value="@item.Item.CpuId" For="@(() => item.Item.CpuId)"
                                                                     ValueChanged="@(args => OnCPUChanged(item.Item, args))">
                                                            @foreach (var cpu in _cpuList)
                                                            {
                                                                <MudComboBoxItem T="int?" Value="@cpu.Id" Text="@cpu.Value">@cpu.Value</MudComboBoxItem>
                                                            }
                                                        </MudComboBox>
                                                    </MudStack>
                                                </EditTemplate>
                                            </PropertyColumn>
                                            <PropertyColumn Title="RAM" Property="x => x.RamDispTxt" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-muddatagrid-cell" + ((IsViewMode || !_isEditingSpecVar) ? " spacious" : " data-align-top inline-editing"))
                                                            Context="item">
                                                <EditTemplate>
                                                    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.FlexStart" Spacing="2" Class="mt-3">
                                                        <MudSelect ReadOnly=@IsViewMode ShrinkLabel="true" Clearable="true" Class="moog-mud-form-field bordered moog-ui-select" PopoverClass="moog-ui-select-popover"
                                                                    AdornmentText="GB" Adornment="Adornment.End"
                                                                   Label="RAM Size" T="int?"
                                                                   @bind-Value="item.Item.RamSizeGb" For="(() => item.Item.RamSizeGb)">
                                                            @foreach (var rs in _ramSizeList)
                                                            {
                                                                <MudSelectItem T="int?" Value="@rs.Id">@rs.Value</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                        <MudSelect ReadOnly=@IsViewMode ShrinkLabel="true" Clearable="true" Class="moog-mud-form-field bordered moog-ui-select" PopoverClass="moog-ui-select-popover"
                                                                   Label="RAM Type" T="string"
                                                                   @bind-Value="item.Item.RamType" For="(() => item.Item.RamType)">
                                                            @foreach (var rt in _ramTypeList)
                                                            {
                                                                <MudSelectItem T="string" Value="@rt.Key">@rt.Value</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                    </MudStack>
                                                </EditTemplate>
                                            </PropertyColumn>
                                            <PropertyColumn Title="GPU" Property="x => x.GpuName" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-muddatagrid-cell" + ((IsViewMode || !_isEditingSpecVar) ? " spacious" : " data-align-top inline-editing"))
                                                            Context="item">
                                                <EditTemplate>
                                                    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.FlexStart" Spacing="2" Class="mt-3">
                                                        <MudComboBox ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered moog-ui-combo-box" Editable="true" Variant="Variant.Text" SearchBox="true" Strict="true" autocomplete="new-password" Required="false"
                                                                     PopoverClass="moog-ui-combo-box-popover" T="int?"
                                                                     Label="GPU"
                                                                     ToStringFunc="@(e => (e is null || e!.Value < 0) ? "" : _gpuList.SingleOrDefault<DropdownSelectItem>(x => x.Id == e)?.Value)"
                                                                     Value="@item.Item.GpuId" For="@(() => item.Item.GpuId)"
                                                                     ValueChanged="@(args => OnGPUChanged(item.Item, args))">
                                                            @foreach (var gpu in _gpuList)
                                                            {
                                                                <MudComboBoxItem T="int?" Value="@gpu.Id" Text="@gpu.Value">@gpu.Value</MudComboBoxItem>
                                                            }
                                                        </MudComboBox>
                                                    </MudStack>
                                                </EditTemplate>
                                            </PropertyColumn>
                                            <PropertyColumn Title="Storage" Property="x => x.StorageDispTxt" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-muddatagrid-cell" + ((IsViewMode || !_isEditingSpecVar) ? " spacious" : " data-align-top inline-editing"))
                                                            Context="item">
                                                <EditTemplate>
                                                    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.FlexStart" Spacing="2" Class="mt-3">
                                                        <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true"
                                                                         AdornmentText="GB" Adornment="Adornment.End"
                                                                         Label="Storage Size (GB)" Format="#,##0" Step="1"
                                                                         @bind-Value="item.Item.StorageSizeGb" T="int?" For="(() => item.Item.StorageSizeGb)"
                                                                         Style="text-align:right" />
