@code {

    #region UI PARAM
    RenderFragment _gridNoRecord = @<p>No record</p>;
    
    List<DropDownListItem> _countryList = [];
    List<DropdownSelectItem> _cpuList = [];
    List<DropdownSelectItem> _gpuList = [];
    // List<Supplier> _supplierList = [];

    List<DropdownSelectItem> _ramSizeList = RAMSizes.GetForDropdown();
    List<DropdownSelectItem> _ramTypeList = RAMTypes.GetForDropdown(RAMTypes.DEVICE_LAPTOP);
    List<DropdownSelectItem> _storageTypeList = LaptopStorageTypes.GetForDropdown();

    IEnumerable<string> _brandList = [];
    MudTextField<string>? _mtfObjName;
    List<AttachedImage> _images = [];
    
    List<DropdownSelectItem> _currencyList = [];

    MudDataGrid<LaptopSpecVar> _specVarGrid = new();
    LaptopSpecVar? _tempSpecVarToAdd;
    bool _isEditingSpecVar = false;

    MudDataGrid<DeviceIOPort> _ioPortGrid = new();
    DeviceIOPort? _tempIOPortToAdd;
    bool _isEditingIOPort = true;

    MudDataGrid<TechSpecItem> _techSpecGrid = new();
    TechSpecItem? _tempTechSpecToAdd;
    bool _isEditingTechSpecItem = true;
    #endregion

    #region PAGE LIFECYCLE FUNCTIONS
    public override Task SetParametersAsync(ParameterView parameters)
    {
        UrlPrefix = "/tsm/laptop";
        return base.SetParametersAsync(parameters);
    }

    protected override async Task OnInitializedAsync()
    {
        switch (CRUCMode)
        {
            case CRUDCModes.READ:
                {
                    CurrentObject = await UowPg.Laptops.GetAsync(Id);
                    IsViewMode = true;
                }
                break;
            case CRUDCModes.CREATE:
                {
                    CurrentObject = new();
                }
                break;
            case CRUDCModes.UPDATE:
                CurrentObject = await UowPg.Laptops.GetAsync(Id);
                break;
            case CRUDCModes.CLONE:
                {
                    var tempObj = await UowPg.Laptops.GetAsync(Id);
                    CurrentObject = tempObj!.DeepClone();

                    CurrentObject!.Id = 0;
                }
                break;
        }

        if (CurrentObject != null && CurrentObject.Id > 0)
        {
            CurrentObject.SpecVariations = await UowPg.LaptopSpecVars.GetByLaptopAsync(CurrentObject.Id);
            CurrentObject.SpecItems = await UowPg.TechSpecItems.GetByObjectAsync(CurrentObject.GetType().Name, CurrentObject.Id);
            CurrentObject.IOPorts = await UowPg.DeviceIOPorts.GetByObjectAsync(CurrentObject.GetType().Name, CurrentObject.Id);
        }

