    void MoveSpecVarUp(LaptopSpecVar specVar)
    {
        if (CurrentObject!.SpecVariations.Count > 1 && specVar.SeqNo!.Value > 1)
        {
            specVar.SeqNo--;

            LaptopSpecVar? a = CurrentObject!.SpecVariations.FirstOrDefault(x => x.IsDeleted == false && x.SeqNo is not null && x.SeqNo == specVar.SeqNo && x != specVar);

            if (a != null)
                a!.SeqNo++;

            CurrentObject!.SpecVariations = CurrentObject!.SpecVariations.OrderBy(x => x.SeqNo).ToList();
        }
    }

    void MoveSpecVarDown(LaptopSpecVar specVar)
    {
        if (CurrentObject!.SpecVariations.Count > 1 && CurrentObject!.SpecVariations.Count != specVar.SeqNo!.Value)
        {
            specVar.SeqNo++;

            LaptopSpecVar? a = CurrentObject!.SpecVariations.FirstOrDefault(x => x.IsDeleted == false && x.SeqNo is not null && x.SeqNo == specVar.SeqNo && x != specVar);

            if (a != null)
                a!.SeqNo--;

            CurrentObject!.SpecVariations = CurrentObject!.SpecVariations.OrderBy(x => x.SeqNo).ToList();
        }
    }

    void RemoveSpecVar(LaptopSpecVar specVar)
    {
        if (specVar.Id == 0)
        {
            CurrentObject!.SpecVariations.Remove(specVar);

            foreach (var var in CurrentObject!.SpecVariations.Where(x => !x.IsDeleted && x.SeqNo > specVar.SeqNo))
            {
                var.SeqNo--;
            }
        }
        else if (specVar.Id > 0)
        {
            foreach (var var in CurrentObject!.SpecVariations.Where(x => !x.IsDeleted && x.SeqNo > specVar.SeqNo))
                var.SeqNo--;

            specVar.SeqNo = null;
            specVar.IsDeleted = true;
        }
    }

