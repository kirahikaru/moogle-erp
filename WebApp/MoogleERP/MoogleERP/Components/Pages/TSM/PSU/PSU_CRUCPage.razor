@code {

    #region UI PARAM
    RenderFragment _gridNoRecord = @<p>No record</p>;
    
    List<DropDownListItem> _countryList = [];

    IEnumerable<string> _brandList = [];
    MudTextField<string>? _mtfObjName;
    List<AttachedImage> _images = [];
    
    List<DropdownSelectItem> _currencyList = [];

    MudDataGrid<TechSpecItem> _techSpecGrid = new();
    TechSpecItem? _tempTechSpecToAdd;
    bool _isEditingTechSpecItem = true;

    MudDataGrid<DeviceIOPort> _ioPortGrid = new();
    DeviceIOPort? _tempIOPortToAdd;
    bool _isEditingIOPort = true;
    #endregion

    #region PAGE LIFECYCLE FUNCTIONS
    public override Task SetParametersAsync(ParameterView parameters)
    {
        UrlPrefix = "/tsm/psu";
        return base.SetParametersAsync(parameters);
    }

    protected override async Task OnInitializedAsync()
    {
        switch (CRUCMode)
        {
            case CRUDCModes.READ:
                {
                    CurrentObject = await UowPg.PSUs.GetAsync(Id);
                    IsViewMode = true;
                }
                break;
            case CRUDCModes.CREATE:
                {
                    CurrentObject = new();
                }
                break;
            case CRUDCModes.UPDATE:
                CurrentObject = await UowPg.PSUs.GetAsync(Id);
                break;
            case CRUDCModes.CLONE:
                {
                    var tempObj = await UowPg.PSUs.GetAsync(Id);
                    CurrentObject = tempObj!.DeepClone();

                    CurrentObject!.Id = 0;
                }
                break;
        }

        if (CurrentObject != null && CurrentObject.Id > 0)
        {
            CurrentObject.SpecItems = await UowPg.TechSpecItems.GetByObjectAsync(CurrentObject.GetType().Name, CurrentObject.Id);
            CurrentObject.IOPorts = await UowPg.DeviceIOPorts.GetByObjectAsync(CurrentObject.GetType().Name, CurrentObject.Id);
        }

        CurrentEditContext = new EditContext(CurrentObject!);

        await PopulatedUIControls();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_mtfObjName != null && !IsViewMode)
                await _mtfObjName!.FocusAsync();
        }
    }
    #endregion

    #region UI FUNCTIONS
    async Task<IEnumerable<string>> SearchBrandName(string value, CancellationToken token)
    {
        // In real life use an asynchronous function for fetching data from an api.
        await Task.Delay(5, token);

        if (string.IsNullOrEmpty(value))
            return _brandList;
        else
            return _brandList.Where(x => x.Contains(value, StringComparison.OrdinalIgnoreCase));
    }
    #endregion

    #region Tech Specification
    // quick filter - filter globally across multiple columns with the same input
    private Func<TechSpecItem, bool> _quickTechSpecFilter => x =>
    {
        return !x.IsDeleted;
    };

    void AddTechSpec()
    {
        _tempTechSpecToAdd = new()
        {
            OrderNo = CurrentObject!.SpecItems.Count + 1
        };

        CurrentObject!.SpecItems.Add(_tempTechSpecToAdd);
        // _itemDataGrid.SetEditingItemAsync(_tempItemToAdd);
    }

    void MoveTechSpecUp(TechSpecItem techSpec)
    {
        if (CurrentObject!.SpecItems.Count > 1 && techSpec.OrderNo!.Value > 1)
        {
            techSpec.OrderNo--;

            TechSpecItem? a = CurrentObject!.SpecItems.FirstOrDefault(x => x.IsDeleted == false && x.OrderNo is not null && x.OrderNo == techSpec.OrderNo && x != techSpec);

            if (a != null)
                a!.OrderNo++;

            CurrentObject!.SpecItems = CurrentObject!.SpecItems.OrderBy(x => x.OrderNo).ToList();
        }
    }

    void MoveTechSpecDown(TechSpecItem techSpec)
    {
        if (CurrentObject!.SpecItems.Count > 1 && CurrentObject!.SpecItems.Count != techSpec.OrderNo!.Value)
        {
            techSpec.OrderNo++;

            TechSpecItem? a = CurrentObject!.SpecItems.FirstOrDefault(x => x.IsDeleted == false && x.OrderNo is not null && x.OrderNo == techSpec.OrderNo && x != techSpec);

            if (a != null)
                a!.OrderNo--;

            CurrentObject!.SpecItems = CurrentObject!.SpecItems.OrderBy(x => x.OrderNo).ToList();
        }
    }

    void RemoveTechSpec(TechSpecItem techSpec)
    {
        if (techSpec.Id == 0)
        {
            CurrentObject!.SpecItems.Remove(techSpec);

            foreach (var var in CurrentObject!.SpecItems.Where(x => !x.IsDeleted && x.OrderNo > techSpec.OrderNo))
            {
                var.OrderNo--;
            }
        }
        else if (techSpec.Id > 0)
        {
            foreach (var var in CurrentObject!.SpecItems.Where(x => !x.IsDeleted && x.OrderNo > techSpec.OrderNo))
                var.OrderNo--;

            techSpec.OrderNo = null;
            techSpec.IsDeleted = true;
        }
    }

    void StartedEditingItemSpec(TechSpecItem techSpec)
    {

    }

    void CanceledEditingItemSpec(TechSpecItem techSpec)
    {
        if (_tempTechSpecToAdd != null)
        {
            CurrentObject!.SpecItems.RemoveAt(CurrentObject!.SpecItems.FindIndex(x => x.OrderNo == techSpec.OrderNo));
            _tempTechSpecToAdd = null;
        }
    }

    Task<DataGridEditFormAction> CommittedItemSpecChanges(TechSpecItem techSpec)
    {
        _tempTechSpecToAdd = null;

        return Task.FromResult(DataGridEditFormAction.Close);
    }
    #endregion

    #region IO Port
    // quick filter - filter globally across multiple columns with the same input
    private Func<DeviceIOPort, bool> _quickIOPortFilter => x =>
    {
        return !x.IsDeleted;
    };

    void AddIOPort()
    {
        _tempIOPortToAdd = new()
        {
            SeqNo = CurrentObject!.IOPorts.Count + 1
        };

        CurrentObject!.IOPorts.Add(_tempIOPortToAdd);
        // _itemDataGrid.SetEditingItemAsync(_tempItemToAdd);
    }

    void MoveIOPortUp(DeviceIOPort ioPort)
    {
        if (CurrentObject!.IOPorts.Count > 1 && ioPort.SeqNo!.Value > 1)
        {
            ioPort.SeqNo--;

            DeviceIOPort? a = CurrentObject!.IOPorts.FirstOrDefault(x => x.IsDeleted == false && x.SeqNo is not null && x.SeqNo == ioPort.SeqNo && x != ioPort);

            if (a != null)
                a!.SeqNo++;

            CurrentObject!.IOPorts = CurrentObject!.IOPorts.OrderBy(x => x.SeqNo).ToList();
        }
    }

    void MoveIOPortDown(DeviceIOPort ioPort)
    {
        if (CurrentObject!.IOPorts.Count > 1 && CurrentObject!.IOPorts.Count != ioPort.SeqNo!.Value)
        {
            ioPort.SeqNo++;

            DeviceIOPort? a = CurrentObject!.IOPorts.FirstOrDefault(x => x.IsDeleted == false && x.SeqNo is not null && x.SeqNo == ioPort.SeqNo && x != ioPort);

            if (a != null)
                a!.SeqNo--;

            CurrentObject!.IOPorts = CurrentObject!.IOPorts.OrderBy(x => x.SeqNo).ToList();
        }
    }

    void RemoveIOPort(DeviceIOPort ioPort)
    {
        if (ioPort.Id == 0)
        {
            CurrentObject!.IOPorts.Remove(ioPort);

            foreach (var var in CurrentObject!.IOPorts.Where(x => !x.IsDeleted && x.SeqNo > ioPort.SeqNo))
            {
                var.SeqNo--;
            }
        }
        else if (ioPort.Id > 0)
        {
            foreach (var var in CurrentObject!.IOPorts.Where(x => !x.IsDeleted && x.SeqNo > ioPort.SeqNo))
                var.SeqNo--;

            ioPort.SeqNo = null;
            ioPort.IsDeleted = true;
        }
    }

    void StartedEditingIOPort(DeviceIOPort ioPort)
    {

    }

    void CanceledEditingIOPort(DeviceIOPort ioPort)
    {
        if (_tempIOPortToAdd != null)
        {
            CurrentObject!.IOPorts.RemoveAt(CurrentObject!.IOPorts.FindIndex(x => x.SeqNo == ioPort.SeqNo));
            _tempIOPortToAdd = null;
        }
    }

    Task<DataGridEditFormAction> CommittedIOPortChanges(DeviceIOPort ioPort)
    {
        _tempIOPortToAdd = null;

        return Task.FromResult(DataGridEditFormAction.Close);
    }
    #endregion

    #region DB UPDATE FUNCTIONS
    protected override async Task ValidatePreSave()
    {
        InvalidMsgList.Clear();

        bool isDuplicated = await UowPg.PSUs.IsDuplicateCodeAsync(CurrentObject!.Id, CurrentObject!.ObjectCode!);

        if (isDuplicated)
        {
            InvalidMsgList.Add("ObjectCode_Duplicate", $"Record with ObjectCode='{CurrentObject.ObjectCode}' is already existed.");
        }
    }

    protected override Task PreSaveProcessing()
    {
        CurrentObject!.ObjectCode = CurrentObject!.ObjectCode!.ToUpper();

        if (CurrentObject!.ReleaseDate.HasValue)
        {
            CurrentObject!.ReleaseDateText = CurrentObject!.ReleaseDate!.Value.ToString("yyyy-MM-dd");
        }

        return base.PreSaveProcessing();
    }

    protected override async Task<bool> SaveAndCommitProcessing()
    {
        DateTime timestamp = DateTime.Now;

        if (CurrentObject!.Id == 0)
        {
            CurrentObject!.CreatedUser = AuditTrailUser;
            CurrentObject!.CreatedDateTime = timestamp;
            CurrentObject!.ModifiedUser = AuditTrailUser;
            CurrentObject!.ModifiedDateTime = timestamp;
            int objId = await UowPg.PSUs.ManualInsertAsync(PSU.GetPgFieldList(UowPg.DbContext.DbType), CurrentObject.GetParamValues(UowPg.DbContext.DbType));

            if (objId > 0)
            {
                foreach (TechSpecItem specItem in CurrentObject.SpecItems)
                {
                    if (specItem.IsDeleted) continue;

                    specItem.LinkedObjectId = objId;
                    specItem.LinkedObjectType = CurrentObject.GetType().Name;
                    specItem.CreatedDateTime = CurrentObject.CreatedDateTime;
                    specItem.CreatedUser = CurrentObject.CreatedUser;
                    specItem.ModifiedDateTime = CurrentObject.ModifiedDateTime;
                    specItem.ModifiedUser = CurrentObject.ModifiedUser;
                    int specItemId = await UowPg.TechSpecItems.ManualInsertAsync(TechSpecItem.GetPgFieldList(UowPg.DbContext.DbType), specItem.GetParamValues(UowPg.DbContext.DbType));
                }

                foreach (DeviceIOPort ioPort in CurrentObject.IOPorts)
                {
                    if (ioPort.IsDeleted) continue;

                    ioPort.LinkedObjectId = objId;
                    ioPort.LinkedObjectCode = CurrentObject.ObjectCode;
                    ioPort.LinkedObjectType = CurrentObject.GetType().Name;
                    ioPort.CreatedDateTime = CurrentObject.CreatedDateTime;
                    ioPort.CreatedUser = CurrentObject.CreatedUser;
                    ioPort.ModifiedDateTime = CurrentObject.ModifiedDateTime;
                    ioPort.ModifiedUser = CurrentObject.ModifiedUser;

                    int ioPortId = await UowPg.DeviceIOPorts.ManualInsertAsync(DeviceIOPort.GetPgFieldList(UowPg.DbContext.DbType), ioPort.GetParamValues(UowPg.DbContext.DbType));
                }
            }

            return objId > 0;
        }
        else if (CurrentObject!.Id > 0)
        {
            CurrentObject!.ModifiedUser = AuditTrailUser;
            CurrentObject!.ModifiedDateTime = timestamp;
            int updCount = await UowPg.PSUs.ManualUpdateAsync(PSU.GetPgFieldList(UowPg.DbContext.DbType), CurrentObject.GetParamValues(UowPg.DbContext.DbType, true));

            if (updCount > 0)
            {
                foreach (TechSpecItem specItem in CurrentObject.SpecItems)
                {
                    if (specItem.Id == 0 & specItem.IsDeleted) continue;

                    if (specItem.Id > 0)
                    {
                        specItem.LinkedObjectId = CurrentObject.Id;
                        specItem.LinkedObjectType = CurrentObject.GetType().Name;
                        specItem.ModifiedDateTime = CurrentObject.ModifiedDateTime;
                        specItem.ModifiedUser = CurrentObject.ModifiedUser;

                        int specUpdCount = await UowPg.TechSpecItems.ManualUpdateAsync(TechSpecItem.GetPgFieldList(UowPg.DbContext.DbType), specItem.GetParamValues(UowPg.DbContext.DbType, true));
                    }
                    else if (specItem.Id == 0)
                    {
                        specItem.LinkedObjectId = CurrentObject.Id;
                        specItem.LinkedObjectType = CurrentObject.GetType().Name;
                        specItem.CreatedDateTime = CurrentObject.ModifiedDateTime;
                        specItem.CreatedUser = CurrentObject.ModifiedUser;
                        specItem.ModifiedDateTime = CurrentObject.ModifiedDateTime;
                        specItem.ModifiedUser = CurrentObject.ModifiedUser;

                        int specItemId = await UowPg.TechSpecItems.ManualInsertAsync(TechSpecItem.GetPgFieldList(UowPg.DbContext.DbType), specItem.GetParamValues(UowPg.DbContext.DbType));
                    }
                }

                foreach (DeviceIOPort ioPort in CurrentObject.IOPorts)
                {
                    if (ioPort.Id == 0 & ioPort.IsDeleted) continue;

                    if (ioPort.Id > 0)
                    {
                        ioPort.LinkedObjectId = CurrentObject.Id;
                        ioPort.LinkedObjectType = CurrentObject.GetType().Name;
                        ioPort.ModifiedDateTime = CurrentObject.ModifiedDateTime;
                        ioPort.ModifiedUser = CurrentObject.ModifiedUser;
                        int ioPortUpdCount = await UowPg.DeviceIOPorts.ManualUpdateAsync(DeviceIOPort.GetPgFieldList(UowPg.DbContext.DbType), ioPort.GetParamValues(UowPg.DbContext.DbType, true));
                    }
                    else if (ioPort.Id == 0)
                    {
                        ioPort.LinkedObjectId = CurrentObject.Id;
                        ioPort.LinkedObjectType = CurrentObject.GetType().Name;
                        ioPort.CreatedDateTime = CurrentObject.ModifiedDateTime;
                        ioPort.CreatedUser = CurrentObject.ModifiedUser;
                        ioPort.ModifiedDateTime = CurrentObject.ModifiedDateTime;
                        ioPort.ModifiedUser = CurrentObject.ModifiedUser;

                        int ioPortId = await UowPg.DeviceIOPorts.ManualInsertAsync(DeviceIOPort.GetPgFieldList(UowPg.DbContext.DbType), ioPort.GetParamValues(UowPg.DbContext.DbType));
                    }
                }
            }

            return updCount > 0;
        }
        else
            return false;
    }
    #endregion

    #region INTERNAL FUNCTIONS
    async Task PopulatedUIControls()
    {
        _brandList = await Uow.Brands.GetAllBrandNamesAsync();
        _countryList = await Uow.Countries.GetForDropdownSelect1Async();
        _currencyList = await Uow.Currencies.GetForDropdownSelect1Async(null);
    }
    #endregion
