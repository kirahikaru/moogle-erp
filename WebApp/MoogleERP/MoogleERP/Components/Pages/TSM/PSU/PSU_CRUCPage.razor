                <MudPaper Class="rounded-0" Elevation="1" Height="calc(100vh - 194px)" Style="overflow-y: auto; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px">
                    <MudGrid Spacing="3" Class="pa-3">
                        <MudItem xs="12" Style="padding:4px 12px; background-color:var(--ssv-pharma-blue-100)">
                            
