@page "/tsm/psu/{CRUCMode}"
@page "/tsm/psu/{CRUCMode}/{id:int}"

@inherits CRUCPageBase<PSU>

@if (CurrentObject != null && CurrentEditContext != null)
{
    <EditForm EditContext="CurrentEditContext" OnValidSubmit="SaveDummy" OnInvalidSubmit="SaveDummy" >
        <DataAnnotationsValidator />
        <MudPaper Class="moog-pg-banner mt-3" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.FlexStart" Spacing="0">
                    <MudText Typo="Typo.h1" Color="@Color.Primary" Style="font-weight:800; font-size:20pt;">@HeaderTitle</MudText>
                    @if (CRUCMode == CRUDCModes.READ)
                    {
                        <MudChip Size="Size.Small" Color="Color.Success" Class=@($"status-chip-tiny") T="string" Style="margin-top:-5px">View</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.UPDATE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info" Class=@($"status-chip-tiny") T="string">Update</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.CREATE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info" Class=@($"status-chip-tiny") T="string">New</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.CLONE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info" Class=@($"status-chip-tiny") T="string">New (Clone)</MudChip>
                    }
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="2">
                    @if (IsViewMode)
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-btn-base moog-btn-gray" Color="Color.Dark"
                                   Disabled=@IsSaving OnClick="Cancel" StartIcon="material-symbols-rounded/close">
                            Close
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-btn-base" Color="Color.Primary"
                                   Disabled=@IsSaving OnClick="@(() => Save(false))" StartIcon="material-symbols-rounded/save_as">
                            Save
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-btn-base" Color="Color.Primary"
                                   Disabled=@IsSaving OnClick="@(() => Save(true))" StartIcon="material-symbols-rounded/save">
                            Save & Close
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Class="moog-btn-base moog-btn-gray" Color="Color.Default"
                                   Disabled=@IsSaving OnClick="Cancel" StartIcon="material-symbols-rounded/cancel">
                            Cancel
                        </MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>
        <MudTabs Color="Color.Primary" Class="mt-3 moog-cruc-pg-mudtab" ActiveTabClass="moog-cruc-pg-mudtab-active" PanelClass="moog-cruc-pg-mudtab-panel" TabHeaderClass="moog-cruc-pg-mudtab-header" TabPanelClass="moog-cruc-pg-mudtab-tab-panel"
                 Style="height:calc(100vh - 185px);">
            <MudTabPanel Icon="material-symbols-rounded/home" Text="Main">
                <MudPaper Class="rounded-0" Elevation="1" Height="calc(100vh - 220px)" Style="overflow-y: auto;">
                    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" StretchItems="StretchItems.All" Spacing="1">
                        <MudGrid Spacing="3" Class="pa-3">
                            <MudItem xs="5">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="true"
                                              Label="Name" @ref=_mtfObjName
                                              @bind-Value="CurrentObject!.ObjectName" For="@(() => CurrentObject!.ObjectName)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="true" 
                                              Label="ID" 
                                              @bind-Value="CurrentObject!.ObjectCode" For="@(() => CurrentObject!.ObjectCode)" Style="text-transform:uppercase" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Energy Efficiency Rating"
                                              @bind-Value="CurrentObject!.EERating" For="@(() => CurrentObject!.EERating)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Brand"
                                              @bind-Value="CurrentObject!.Brand" For="@(() => CurrentObject!.Brand)" />
                            </MudItem>
                            <MudItem xs="1">
                                <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true" Required="true"
                                                 AdornmentText="W" Adornment="Adornment.End"
                                                 Label="Power Rating" Step="1"
                                                 @bind-Value="CurrentObject!.MaxPowerRating" T="int?" For="(() => CurrentObject.MaxPowerRating)"
                                                 Style="text-align:right" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Model"
                                              @bind-Value="CurrentObject!.Model" For="@(() => CurrentObject!.Model)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Dimension"
                                              @bind-Value="CurrentObject!.Dimension" For="@(() => CurrentObject!.Dimension)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Modularity"
                                              @bind-Value="CurrentObject!.Modularity" For="@(() => CurrentObject!.Modularity)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Material"
                                              @bind-Value="CurrentObject!.Material" For="@(() => CurrentObject!.Material)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Serie Name"
                                              @bind-Value="CurrentObject!.SerieName" For="@(() => CurrentObject!.SerieName)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudDatePicker ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Editable="true" Class="moog-mud-form-field bordered moog-ui-datepicker" Required="false"
                                               AdornmentIcon="material-symbols-rounded/calendar_month" AdornmentColor=@Color.Primary
                                               Label="Release Date" Placeholder="Release Date" DateFormat="dd-MMM-yyyy"
                                               @bind-Date="CurrentObject!.ReleaseDate" For="@(() => CurrentObject!.ReleaseDate)" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="false"
                                              Label="Release On"
                                              @bind-Value="CurrentObject!.ReleaseDateText" For="@(() => CurrentObject!.ReleaseDateText)" />
                            </MudItem>
                            <MudItem xs="1">
                                <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true"
                                                 AdornmentText="kg" Adornment="Adornment.End"
                                                 Label="Weight" Step="0.01M"
                                                 @bind-Value="CurrentObject!.Weight" T="decimal?" For="(() => CurrentObject.Weight)"
                                                 Style="text-align:right" />
                            </MudItem>
                            <MudItem xs="2">
                                <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true"
                                                 AdornmentIcon="material-symbols-rounded/attach_money" Adornment="Adornment.Start" AdornmentColor="@Color.Primary"
                                                 Label="MSRP" T="decimal?" Step="0.01M" Format="#,##0.##"
                                                 @bind-Value="CurrentObject!.MSRP" For="(() => CurrentObject.MSRP)" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Lines="8"
                                              Label="Note" Placeholder="Remark..."
                                              @bind-Value="CurrentObject!.Note" For="@(() => CurrentObject!.Note)" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered"
                                              AdornmentIcon="material-symbols-rounded/link" Adornment="Adornment.Start" AdornmentColor="@Color.Primary"
                                              Label="Product Info URL"
                                              @bind-Value="CurrentObject!.ProductInfoUrl" For="@(() => CurrentObject!.ProductInfoUrl)" />
                            </MudItem>
                            <MudItem xs="12" Class="mt-3"></MudItem>
                            <MudItem xs="12" Style="padding:4px 12px; background-color:var(--ssv-pharma-blue-100)">
                                <MudText Typo="Typo.h1" Style="font-size:18px; font-weight:700; color:var(--ssv-pharma-blue)">Technical Specifications</MudText>
                            </MudItem>
                            <MudItem xs="12">
                                <MudStack Spacing="2" Justify=Justify.FlexStart>
                                    @if (!IsViewMode)
                                    {
                                        <MudStack Row="true" Spacing="2" Justify=Justify.FlexStart>
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" DropShadow="false" FullWidth="false" Class="moog-btn-base moog-btn-tight moog-btn-primary-light" StartIcon="material-symbols-rounded/add_circle"
                                                       OnClick="AddTechSpec" Disabled="!_isEditingTechSpecItem">
                                                Add Spec
                                            </MudButton>
                                            <MudSwitchM3 ReadOnly=@IsViewMode Class="moog-mud-switch ml-2" Color="@(_isEditingTechSpecItem? Color.Success: Color.Dark)"
                                                         ThumbIcon="@Icons.Material.Rounded.Check" ThumbOffIcon="@Icons.Material.Rounded.Close" Size="Size.Small"
                                                         Label=@(_isEditingTechSpecItem ? "Edit ON" : "Edit OFF")
                                                         @bind-Value="_isEditingTechSpecItem" Style=@(_isEditingTechSpecItem ? "color:#00C853; font-weight:600" : "color:#B0BEC5") />
                                        </MudStack>
                                    }
                                    @* EditDialogOptions=@(new() { BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true }) *@
                                    <MudDataGrid Class="moog-mud-datagrid" Dense="true" Hover="true" FixedHeader="true" Striped="true" HorizontalScrollbar="true" Elevation="0" ColumnResizeMode="ResizeMode.None"
                                                 Items="@CurrentObject!.SpecItems" T="TechSpecItem" @ref="_techSpecGrid" NoRecordsContent="_gridNoRecord" Style="width:100%" QuickFilter="_quickTechSpecFilter"
                                                 ReadOnly=@(IsViewMode || !_isEditingTechSpecItem) EditTrigger="DataGridEditTrigger.OnRowClick" EditMode="DataGridEditMode.Cell"
                                                 StartedEditingItem="@StartedEditingItemSpec" CanceledEditingItem="@CanceledEditingItemSpec" CommittedItemChanges="@CommittedItemSpecChanges">
                                        <Columns>
                                            <PropertyColumn Title="No." Property="x => x.OrderNo" Sortable="false" Editable="false" Hidden="true"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-mud-datagrid-cell" + (IsViewMode ? " spacious" : " data-align-top inline-editing"))
                                                            CellStyle="text-align:right" />
                                            <PropertyColumn Title="Type" Property="x => x.ObjectName" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-mud-datagrid-cell" + (IsViewMode ? " spacious" : " data-align-top inline-editing"))
                                                            Context="item">
                                                <EditTemplate>
                                                    <MudTextField Readonly="@IsViewMode" Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="true"
                                                                  Placeholder="Spec Type"
                                                                  @bind-Value=item.Item.ObjectName For="@(() => item.Item.ObjectName)" OnlyValidateIfDirty="true" MaxLength="255" />
                                                </EditTemplate>
                                            </PropertyColumn>
                                            <PropertyColumn Title="Spec Desc" Property="x => x.SpecDesc" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-mud-datagrid-cell" + (IsViewMode ? " spacious" : " data-align-top inline-editing"))
                                                            Context="item">
                                                <EditTemplate>
                                                    <MudTextField Readonly="@IsViewMode" Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="true"
                                                                  Placeholder="Spec Value"
                                                                  @bind-Value=item.Item.SpecDesc For="@(() => item.Item.SpecDesc)" OnlyValidateIfDirty="true" MaxLength="255" />
                                                </EditTemplate>
                                            </PropertyColumn>
                                            <PropertyColumn Title="Value" Property="x => x.SpecValue" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-mud-datagrid-cell" + (IsViewMode ? " spacious" : " data-align-top inline-editing"))
                                                            HeaderStyle="width:100px; max-width:80px" Context="item">
                                                <EditTemplate>
                                                    <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true"
                                                                     Placeholder="Qty" Format="#,##0.##" Step="0.1M"
                                                                     @bind-Value="item.Item.SpecValue" T="decimal?" For="(() => item.Item.SpecValue)"
                                                                     Style="text-align:right" />
                                                </EditTemplate>
                                            </PropertyColumn>
                                            <PropertyColumn Title="Unit" Property="x => x.UnitCode" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-mud-datagrid-cell" + (IsViewMode ? " spacious" : " data-align-top inline-editing"))
                                                            Context="item">
                                                <EditTemplate>
                                                    <MudTextField Readonly="@IsViewMode" Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="true"
                                                                  Placeholder="Unit"
                                                                  @bind-Value=item.Item.UnitCode For="@(() => item.Item.UnitCode)" OnlyValidateIfDirty="true" MaxLength="255" />
                                                </EditTemplate>
                                            </PropertyColumn>
                                            <TemplateColumn Title="Action" Hidden=@IsViewMode Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass="moog-mud-datagrid-cell inline-editing"
                                                            CellStyle="padding-inline-end:4px; padding-inline-start:4px; padding-top: 2px !important; padding-bottom: 2px !important"
                                                            Context="item">
                                                <CellTemplate>
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.ArrowCircleUp" Size="@Size.Small" Color="Color.Primary" OnClick="@(() => MoveTechSpecUp(item.Item))" />
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.ArrowCircleDown" Size="@Size.Small" Color="Color.Primary" OnClick="@(() => MoveTechSpecDown(item.Item))" />
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.Delete" Size="@Size.Small" Color="Color.Error" OnClick="@(() => RemoveTechSpec(item.Item))" />
                                                </CellTemplate>
                                                <EditTemplate>
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.ArrowCircleUp" Size="@Size.Small" Color="Color.Primary" OnClick="@(() => MoveTechSpecUp(item.Item))" />
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.ArrowCircleDown" Size="@Size.Small" Color="Color.Primary" OnClick="@(() => MoveTechSpecDown(item.Item))" />
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.Delete" Size="@Size.Small" Color="Color.Error" OnClick="@(() => RemoveTechSpec(item.Item))" />
                                                </EditTemplate>
                                            </TemplateColumn>
                                        </Columns>
                                    </MudDataGrid>
                                </MudStack>
                            </MudItem>

                            <MudItem xs="12" Class="mt-3"></MudItem>
                            <MudItem xs="12" Style="padding:4px 12px; background-color:var(--ssv-pharma-blue-100)">
                                <MudText Typo="Typo.h1" Style="font-size:18px; font-weight:700; color:var(--ssv-pharma-blue)">IO Port(s)</MudText>
                            </MudItem>
                            <MudItem xs="12">
                                <MudStack Spacing="2" Justify=Justify.FlexStart>
                                    @if (!IsViewMode)
                                    {
                                        <MudStack Row="true" Spacing="2" Justify=Justify.FlexStart>
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" DropShadow="false" FullWidth="false" Class="moog-btn-base moog-btn-tight moog-btn-primary-light" StartIcon="material-symbols-rounded/add_circle"
                                                       OnClick="AddIOPort" Disabled="!_isEditingIOPort">
                                                Add Spec
                                            </MudButton>
                                            <MudSwitchM3 ReadOnly=@IsViewMode Class="moog-mud-switch ml-2" Color="@(_isEditingIOPort? Color.Success: Color.Dark)"
                                                         ThumbIcon="@Icons.Material.Rounded.Check" ThumbOffIcon="@Icons.Material.Rounded.Close" Size="Size.Small"
                                                         Label=@(_isEditingIOPort ? "Edit ON" : "Edit OFF")
                                                         @bind-Value="_isEditingIOPort" Style=@(_isEditingIOPort ? "color:#00C853; font-weight:600" : "color:#B0BEC5") />
                                        </MudStack>
                                    }
                                    @* EditDialogOptions=@(new() { BackdropClick = false, MaxWidth = MaxWidth.Medium, FullWidth = true }) *@
                                    <MudDataGrid Class="moog-mud-datagrid" Dense="true" Hover="true" FixedHeader="true" Striped="true" HorizontalScrollbar="true" Elevation="0" ColumnResizeMode="ResizeMode.None"
                                                 Items="@CurrentObject!.IOPorts" T="DeviceIOPort" @ref="_ioPortGrid" NoRecordsContent="_gridNoRecord" QuickFilter="_quickIOPortFilter"
                                                 ReadOnly=@(IsViewMode || !_isEditingIOPort) EditTrigger="DataGridEditTrigger.OnRowClick" EditMode="DataGridEditMode.Cell"
                                                 StartedEditingItem="@StartedEditingIOPort" CanceledEditingItem="@CanceledEditingIOPort" CommittedItemChanges="@CommittedIOPortChanges">
                                        <Columns>
                                            <PropertyColumn Title="No." Property="x => x.SeqNo" Sortable="false" Editable="false" Hidden="true"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-mud-datagrid-cell" + (IsViewMode ? " spacious" : " data-align-top inline-editing"))
                                                            CellStyle="text-align:right" />
                                            <PropertyColumn Title="Type" Property="x => x.ObjectName" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-mud-datagrid-cell" + (IsViewMode ? " spacious" : " data-align-top inline-editing"))
                                                            Context="item">
                                                <EditTemplate>
                                                    <MudTextField Readonly="@IsViewMode" Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="true"
                                                                  Placeholder="Spec Type"
                                                                  @bind-Value=item.Item.ObjectName For="@(() => item.Item.ObjectName)" OnlyValidateIfDirty="true" MaxLength="255" />
                                                </EditTemplate>
                                            </PropertyColumn>
                                            <PropertyColumn Title="# Port" Property="x => x.PortCount" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-mud-datagrid-cell" + (IsViewMode ? " spacious" : " data-align-top inline-editing"))
                                                            HeaderStyle="width:500px; max-width:80px"
                                                            CellStyle="text-align:right" Context="item">
                                                <EditTemplate>
                                                    <MudNumericField ReadOnly=@IsViewMode Clearable="false" ShrinkLabel="true" Class="moog-mud-form-field bordered" Immediate="true" HideSpinButtons="true"
                                                                     Format="#,##0" Step="1"
                                                                     @bind-Value="item.Item.PortCount" T="int?" For="(() => item.Item.PortCount)"
                                                                     Style="text-align:right" />
                                                </EditTemplate>
                                            </PropertyColumn>
                                            
                                            <PropertyColumn Title="Remark" Property="x => x.Remark" Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass=@("moog-mud-datagrid-cell" + (IsViewMode ? " spacious" : " data-align-top inline-editing"))
                                                            HeaderStyle="width:800px" Context="item" >
                                                <EditTemplate>
                                                    <MudTextField Readonly="@IsViewMode" Clearable="true" ShrinkLabel="true" Class="moog-mud-form-field bordered" Required="true"
                                                                  Placeholder="Remark..."
                                                                  @bind-Value=item.Item.Remark For="@(() => item.Item.Remark)" OnlyValidateIfDirty="true" MaxLength="255" />
                                                </EditTemplate>
                                            </PropertyColumn>
                                            <TemplateColumn Title="Action" Hidden=@IsViewMode Sortable="false"
                                                            HeaderClass="moog-mud-datagrid-hdr cruc-pg-items" CellClass="moog-mud-datagrid-cell inline-editing"
                                                            CellStyle="padding-inline-end:4px; padding-inline-start:4px; padding-top: 2px !important; padding-bottom: 2px !important"
                                                            Context="item">
                                                <CellTemplate>
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.ArrowCircleUp" Size="@Size.Small" Color="Color.Primary" OnClick="@(() => MoveIOPortUp(item.Item))" />
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.ArrowCircleDown" Size="@Size.Small" Color="Color.Primary" OnClick="@(() => MoveIOPortDown(item.Item))" />
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.Delete" Size="@Size.Small" Color="Color.Error" OnClick="@(() => RemoveIOPort(item.Item))" />
                                                </CellTemplate>
                                                <EditTemplate>
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.ArrowCircleUp" Size="@Size.Small" Color="Color.Primary" OnClick="@(() => MoveIOPortUp(item.Item))" />
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.ArrowCircleDown" Size="@Size.Small" Color="Color.Primary" OnClick="@(() => MoveIOPortDown(item.Item))" />
                                                    <MudIconButton Class="moog-ico-btn-datagrid-action" Icon="@Icons.Material.Outlined.Delete" Size="@Size.Small" Color="Color.Error" OnClick="@(() => RemoveIOPort(item.Item))" />
                                                </EditTemplate>
                                            </TemplateColumn>
                                        </Columns>
                                    </MudDataGrid>
                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudPaper>
                <MudPaper Height="26px" Elevation="1"
                          Style="padding:0px; background-color:var(--material-blue-gray-50); border-top-left-radius:0px; border-top-right-radius:0px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Spacing="1" Style="height:100%; padding: 0px 10px">
                        <MudText Typo="Typo.subtitle1" Style="font-size:8pt; color:var(--material-blue-gray-500)">Created by </MudText>
                        <MudText Typo="Typo.subtitle1" Style="font-size:8pt; font-weight:600; color:var(--material-blue-gray-500)">@CurrentObject!.CreatedUser</MudText>
                        @* <MudChip T="string" Class="status-chip-tiny" Style="font-size:8pt; padding-left:6px;padding-right:6px">@CurrentObject!.CreatedUser</MudChip> *@
                        <MudText Typo="Typo.subtitle1" Style="font-size:8pt; color:var(--material-blue-gray-500)"> on </MudText>
                        <MudText Typo="Typo.subtitle1" Style="font-size:8pt; font-weight:600; color:var(--material-blue-gray-500)">@(CurrentObject!.CreatedDateTimeText)</MudText>
                        @* <MudChip T="string" Class="status-chip-tiny" Style="font-size:8pt; padding-left:6px;padding-right:6px">
                                @(CurrentObject!.CreatedDateTime is null ? " - " : CurrentObject!.CreatedDateTime!.Value.ToString("dd-MMM-yyyy HH:mm:ss"))
                            </MudChip> *@
                        <MudText Typo="Typo.subtitle1" Style="font-size:8pt; color:var(--material-blue-gray-500)">| Last modified by </MudText>
                        <MudText Typo="Typo.subtitle1" Style="font-size:8pt; font-weight:600; color:var(--material-blue-gray-500)">@CurrentObject!.ModifiedUser</MudText>
                        @* <MudChip T="string" Class="status-chip-tiny" Style="font-size:8pt; padding-left:6px;padding-right:6px">@CurrentObject!.ModifiedUser</MudChip> *@
                        <MudText Typo="Typo.subtitle1" Style="font-size:8pt; color:var(--material-blue-gray-500)"> on </MudText>
                        <MudText Typo="Typo.subtitle1" Style="font-size:8pt; font-weight:600; color:var(--material-blue-gray-500)">@(CurrentObject!.ModifiedDateTimeText)</MudText>
                        @* <MudChip T="string" Class="status-chip-tiny" Style="font-size:8pt; padding-left:6px;padding-right:6px">
                                @(CurrentObject!.ModifiedDateTime is null ? " - " : CurrentObject!.ModifiedDateTime!.Value.ToString("dd-MMM-yyyy HH:mm:ss"))
