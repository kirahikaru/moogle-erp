    #region DB UPDATE FUNCTIONS
    protected override async Task ValidatePreSave()
    {
        InvalidMsgList.Clear();

        bool isDuplicated = await UowPg.SSDs.IsDuplicateCodeAsync(CurrentObject!.Id, CurrentObject!.ObjectCode!);

        if (isDuplicated)
        {
            InvalidMsgList.Add("ObjectCode_Duplicate", $"Record with ObjectCode='{CurrentObject.ObjectCode}' is already existed.");
        }
    }

    protected override Task PreSaveProcessing()
    {
        CurrentObject!.ObjectCode = CurrentObject!.ObjectCode!.ToUpper();

        if (CurrentObject!.ReleaseDate.HasValue)
        {
            CurrentObject!.ReleaseDateText = CurrentObject!.ReleaseDate!.Value.ToString("yyyy-MM-dd");
        }

        return base.PreSaveProcessing();
    }

    protected override async Task<bool> SaveAndCommitProcessing()
    {
        DateTime timestamp = DateTime.Now;

        if (CurrentObject!.Id == 0)
        {
            CurrentObject!.CreatedUser = AuditTrailUser;
            CurrentObject!.CreatedDateTime = timestamp;
            CurrentObject!.ModifiedUser = AuditTrailUser;
            CurrentObject!.ModifiedDateTime = timestamp;
            int objId = await UowPg.SSDs.ManualInsertAsync(SSD.GetPgFieldList(UowPg.DbContext.DbType), CurrentObject.GetParamValues(UowPg.DbContext.DbType));

            if (objId > 0)
            {
                foreach (TechSpecItem specItem in CurrentObject.SpecItems)
                {
                    if (specItem.IsDeleted) continue;

                    specItem.LinkedObjectId = objId;
                    specItem.LinkedObjectType = CurrentObject.GetType().Name;
                    specItem.CreatedDateTime = CurrentObject.CreatedDateTime;
                    specItem.CreatedUser = CurrentObject.CreatedUser;
                    specItem.ModifiedDateTime = CurrentObject.ModifiedDateTime;
                    specItem.ModifiedUser = CurrentObject.ModifiedUser;
                    int specItemId = await UowPg.TechSpecItems.ManualInsertAsync(TechSpecItem.GetPgFieldList(UowPg.DbContext.DbType), specItem.GetParamValues(UowPg.DbContext.DbType));
                }

                foreach (DeviceIOPort ioPort in CurrentObject.IOPorts)
                {
                    if (ioPort.IsDeleted) continue;

                    ioPort.LinkedObjectId = objId;
                    ioPort.LinkedObjectCode = CurrentObject.ObjectCode;
                    ioPort.LinkedObjectType = CurrentObject.GetType().Name;
                    ioPort.CreatedDateTime = CurrentObject.CreatedDateTime;
                    ioPort.CreatedUser = CurrentObject.CreatedUser;
                    ioPort.ModifiedDateTime = CurrentObject.ModifiedDateTime;
                    ioPort.ModifiedUser = CurrentObject.ModifiedUser;

                    int ioPortId = await UowPg.DeviceIOPorts.ManualInsertAsync(DeviceIOPort.GetPgFieldList(UowPg.DbContext.DbType), ioPort.GetParamValues(UowPg.DbContext.DbType));
                }

                foreach (StorageDriveOption sdo in CurrentObject.Options)
                {
                    if (sdo.IsDeleted) continue;

                    sdo.StorageType = StorageDriveTypes.SSD;
                    sdo.StorageDriveId = CurrentObject.Id;
                    sdo.CreatedDateTime = CurrentObject.CreatedDateTime;
                    sdo.CreatedUser = CurrentObject.CreatedUser;
                    sdo.ModifiedDateTime = CurrentObject.ModifiedDateTime;
                    sdo.ModifiedUser = CurrentObject.ModifiedUser;

                    int sdoId = await UowPg.StorageDriveOptions.ManualInsertAsync(StorageDriveOption.GetPgFieldList(UowPg.DbContext.DbType), sdo.GetParamValues(UowPg.DbContext.DbType));
                }
            }

            return objId > 0;
        }
        else if (CurrentObject!.Id > 0)
        {
            CurrentObject!.ModifiedUser = AuditTrailUser;
            CurrentObject!.ModifiedDateTime = timestamp;
            int updCount = await UowPg.SSDs.ManualUpdateAsync(SSD.GetPgFieldList(UowPg.DbContext.DbType), CurrentObject.GetParamValues(UowPg.DbContext.DbType, true));

            if (updCount > 0)
            {
                foreach (TechSpecItem specItem in CurrentObject.SpecItems)
                {
                    if (specItem.Id == 0 & specItem.IsDeleted) continue;

                    if (specItem.Id > 0)
                    {
                        specItem.LinkedObjectId = CurrentObject.Id;
                        specItem.LinkedObjectType = CurrentObject.GetType().Name;
                        specItem.ModifiedDateTime = CurrentObject.ModifiedDateTime;
                        specItem.ModifiedUser = CurrentObject.ModifiedUser;

                        int specUpdCount = await UowPg.TechSpecItems.ManualUpdateAsync(TechSpecItem.GetPgFieldList(UowPg.DbContext.DbType), specItem.GetParamValues(UowPg.DbContext.DbType, true));
                    }
                    else if (specItem.Id == 0)
                    {
                        specItem.LinkedObjectId = CurrentObject.Id;
                        specItem.LinkedObjectType = CurrentObject.GetType().Name;
                        specItem.CreatedDateTime = CurrentObject.ModifiedDateTime;
                        specItem.CreatedUser = CurrentObject.ModifiedUser;
                        specItem.ModifiedDateTime = CurrentObject.ModifiedDateTime;
                        specItem.ModifiedUser = CurrentObject.ModifiedUser;

                        int specItemId = await UowPg.TechSpecItems.ManualInsertAsync(TechSpecItem.GetPgFieldList(UowPg.DbContext.DbType), specItem.GetParamValues(UowPg.DbContext.DbType));
                    }
                }

                foreach (DeviceIOPort ioPort in CurrentObject.IOPorts)
                {
                    if (ioPort.Id == 0 & ioPort.IsDeleted) continue;

                    if (ioPort.Id > 0)
                    {
                        ioPort.LinkedObjectId = CurrentObject.Id;
                        ioPort.LinkedObjectType = CurrentObject.GetType().Name;
                        ioPort.ModifiedDateTime = CurrentObject.ModifiedDateTime;
                        ioPort.ModifiedUser = CurrentObject.ModifiedUser;
                        int ioPortUpdCount = await UowPg.DeviceIOPorts.ManualUpdateAsync(DeviceIOPort.GetPgFieldList(UowPg.DbContext.DbType), ioPort.GetParamValues(UowPg.DbContext.DbType, true));
                    }
                    else if (ioPort.Id == 0)
                    {
                        ioPort.LinkedObjectId = CurrentObject.Id;
                        ioPort.LinkedObjectType = CurrentObject.GetType().Name;
                        ioPort.CreatedDateTime = CurrentObject.ModifiedDateTime;
                        ioPort.CreatedUser = CurrentObject.ModifiedUser;
                        ioPort.ModifiedDateTime = CurrentObject.ModifiedDateTime;
                        ioPort.ModifiedUser = CurrentObject.ModifiedUser;

                        int ioPortId = await UowPg.DeviceIOPorts.ManualInsertAsync(DeviceIOPort.GetPgFieldList(UowPg.DbContext.DbType), ioPort.GetParamValues(UowPg.DbContext.DbType));
                    }
                }

                foreach (StorageDriveOption sdo in CurrentObject.Options)
                {
                    if (sdo.Id == 0 & sdo.IsDeleted) continue;

                    if (sdo.Id > 0)
                    {
                        sdo.StorageType = StorageDriveTypes.HDD;
                        sdo.StorageDriveId = CurrentObject.Id;
                        sdo.ModifiedDateTime = CurrentObject.ModifiedDateTime;
                        sdo.ModifiedUser = CurrentObject.ModifiedUser;
                        int sdoUpdCount = await UowPg.StorageDriveOptions.ManualUpdateAsync(StorageDriveOption.GetPgFieldList(UowPg.DbContext.DbType), sdo.GetParamValues(UowPg.DbContext.DbType, true));
                    }
                    else if (sdo.Id == 0)
                    {
                        sdo.StorageType = StorageDriveTypes.HDD;
                        sdo.StorageDriveId = CurrentObject.Id;
                        sdo.CreatedDateTime = CurrentObject.ModifiedDateTime;
                        sdo.CreatedUser = CurrentObject.ModifiedUser;
                        sdo.ModifiedDateTime = CurrentObject.ModifiedDateTime;
                        sdo.ModifiedUser = CurrentObject.ModifiedUser;

                        int sdoId = await UowPg.StorageDriveOptions.ManualInsertAsync(StorageDriveOption.GetPgFieldList(UowPg.DbContext.DbType), sdo.GetParamValues(UowPg.DbContext.DbType));
                    }
                }
            }

            return updCount > 0;
        }
        else
            return false;
    }
