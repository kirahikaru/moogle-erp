    #region PAGE LIFECYCLE FUNCTIONS
    public override Task SetParametersAsync(ParameterView parameters)
    {
        UrlPrefix = "/tsm/ssd";
        return base.SetParametersAsync(parameters);
    }

    protected override async Task OnInitializedAsync()
    {
        switch (CRUCMode)
        {
            case CRUDCModes.READ:
                {
                    CurrentObject = await UowPg.SSDs.GetAsync(Id);
                    IsViewMode = true;
                }
                break;
            case CRUDCModes.CREATE:
                {
                    CurrentObject = new();
                }
                break;
            case CRUDCModes.UPDATE:
                CurrentObject = await UowPg.SSDs.GetAsync(Id);
                break;
            case CRUDCModes.CLONE:
                {
                    var tempObj = await UowPg.SSDs.GetAsync(Id);
                    CurrentObject = tempObj!.DeepClone();

                    CurrentObject!.Id = 0;
                }
                break;
        }

        if (CurrentObject != null && CurrentObject.Id > 0)
        {
            CurrentObject.SpecItems = await UowPg.TechSpecItems.GetByObjectAsync(CurrentObject.GetType().Name, CurrentObject.Id);
            CurrentObject.IOPorts = await UowPg.DeviceIOPorts.GetByObjectAsync(CurrentObject.GetType().Name, CurrentObject.Id);
            CurrentObject.Options = await UowPg.StorageDriveOptions.GetByDriveAsync(StorageDriveTypes.SSD, CurrentObject.Id);
        }

        CurrentEditContext = new EditContext(CurrentObject!);

        await PopulatedUIControls();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_mtfObjName != null && !IsViewMode)
                await _mtfObjName!.FocusAsync();
        }
    }
    #endregion

    #region UI FUNCTIONS
    async Task<IEnumerable<string>> SearchBrandName(string value, CancellationToken token)
    {
        // In real life use an asynchronous function for fetching data from an api.
        await Task.Delay(5, token);

        if (string.IsNullOrEmpty(value))
            return _brandList;
        else
            return _brandList.Where(x => x.Contains(value, StringComparison.OrdinalIgnoreCase));
    }
    #endregion

    #region Storage Drive Options
    // quick filter - filter globally across multiple columns with the same input
    private Func<StorageDriveOption, bool> _quickStorageDriveOptionFilter => x =>
    {
        return !x.IsDeleted;
    };

    void AddStorageDriveOption()
    {
        _tempStorageDriveOptToAdd = new()
        {
            SeqNo = CurrentObject!.Options.Count + 1
        };

        CurrentObject!.Options.Add(_tempStorageDriveOptToAdd);
        // _itemDataGrid.SetEditingItemAsync(_tempItemToAdd);
    }

    void MoveStorageDriveOptionUp(StorageDriveOption sdo)
    {
        if (CurrentObject!.Options.Count > 1 && sdo.SeqNo!.Value > 1)
        {
            sdo.SeqNo--;

            StorageDriveOption? a = CurrentObject!.Options.FirstOrDefault(x => x.IsDeleted == false && x.SeqNo is not null && x.SeqNo == sdo.SeqNo && x != sdo);

            if (a != null)
                a!.SeqNo++;

            CurrentObject!.Options = CurrentObject!.Options.OrderBy(x => x.SeqNo).ToList();
        }
    }

    void MoveStorageDriveOptionDown(StorageDriveOption sdo)
    {
        if (CurrentObject!.Options.Count > 1 && CurrentObject!.Options.Count != sdo.SeqNo!.Value)
        {
            sdo.SeqNo++;

            StorageDriveOption? a = CurrentObject!.Options.FirstOrDefault(x => x.IsDeleted == false && x.SeqNo is not null && x.SeqNo == sdo.SeqNo && x != sdo);

            if (a != null)
                a!.SeqNo--;

            CurrentObject!.Options = CurrentObject!.Options.OrderBy(x => x.SeqNo).ToList();
        }
    }

    void RemoveStorageDriveOption(StorageDriveOption sdo)
    {
        if (sdo.Id == 0)
        {
            CurrentObject!.Options.Remove(sdo);

            foreach (var var in CurrentObject!.Options.Where(x => !x.IsDeleted && x.SeqNo > sdo.SeqNo))
            {
                var.SeqNo--;
            }
        }
        else if (sdo.Id > 0)
        {
            foreach (var var in CurrentObject!.Options.Where(x => !x.IsDeleted && x.SeqNo > sdo.SeqNo))
                var.SeqNo--;

            sdo.SeqNo = null;
            sdo.IsDeleted = true;
        }
    }

