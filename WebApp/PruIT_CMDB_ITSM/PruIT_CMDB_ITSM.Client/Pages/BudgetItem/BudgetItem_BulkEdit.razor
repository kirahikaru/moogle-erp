@page "/fin/budget-item/bulk-upd"
@using DataLayer.Repos
@using PruIT_CMDB_ITSM.Client.Pages

@* @rendermode InteractiveAuto *@

@inject SweetAlertService Swal
@inject IUowPruIT Uow

<MudPaper Class="px-4 py-3 rounded" Width="100%" Elevation="0" Square="true" Style="background-color:#FFFDE7; border: solid 1px var(--pru-gray-tw-100)">
	<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
		<div style="color:var(--pru-red-default); font-size:28px;">
			<span style="font-weight:800">Budget Bulk Edit</span>
			@* <span style="font-weight:400"> | Software</span> *@
		</div>
		
	</MudStack>
</MudPaper>

<MudPaper Class="pa-3 mt-3 rounded overflow-y-auto" Width="100%" Elevation="0" Square="true" Height="calc(100vh - 170px)">
	<MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.FlexStart" StretchItems="StretchItems.None">
		<MudSelect Clearable="true" ShrinkLabel="true" Class="pru-mud-form-field bordered pru-ui-select" PopoverClass="pru-ui-select-popover" Required="true"
				   Label="Year" T="int" FullWidth="false" Style="max-width:100px"
				   @bind-Value=_budgetYr >
			@foreach (int yr in _budgetYrList)
			{
				<MudSelectItem T="int" Value=@yr>@yr</MudSelectItem>
			}
		</MudSelect>
	</MudStack>
	<MudDataGrid Class="mt-2 pru-mud-datagrid cruc-pg-items" @ref="_dataGrid" Items="_budgetItemList" Dense="true" Hover="true" FixedHeader="true" Striped="true" Loading=@_isSearching RowsPerPage=50
				 ColumnResizeMode="ResizeMode.Container" HorizontalScrollbar="true" Elevation="0" SortMode="SortMode.Multiple" @bind-SelectedItem=SelectedObject SelectOnRowClick="true"
				 RowClassFunc="SelectedRowClassFunc" RowClass="mud-datagrid-row" T="BudgetItem" QuickFilter="_quickFilter"
				 EditTrigger="DataGridEditTrigger.OnRowClick" EditMode="DataGridEditMode.Cell"
				 StartedEditingItem="@StartedEditingItem" CanceledEditingItem="@CanceledEditingItem" CommittedItemChanges="@CommittedItemChanges">
		<Columns>
			@* <PropertyColumn Property="x => x.LBU" Title="LBU" HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell" /> *@
			<TemplateColumn Title="LBU" StickyLeft="true" 
				HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell data-align-top" Context="rowData">
				<CellTemplate>
					<MudStack Row=true AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Spacing="1">
						<MudImage Src=@(_lbuFlagList[rowData.Item.LBU!]) Height="12" />
						<MudText Typo="Typo.body1">@rowData.Item.LBU</MudText>
					</MudStack>
				</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Current" StickyLeft="true"
                            HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell"
                            CellStyle="text-align:center" Context="rowData">
                <CellTemplate>
                    @if (rowData.Item.IsCurrent)
                    {
                        <MudIcon Icon="@Icons.Material.Rounded.CheckCircle" Color="Color.Success" Size="Size.Small" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Rounded.Cancel" Color="Color.Secondary" Size="Size.Small" />
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Title="Order" Property="x => x.DispOrder" Sortable="false"
                            HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell" Context="item">
                <EditTemplate>
                    <MudTextField Clearable="true" ShrinkLabel="true" Class="pru-mud-form-field bordered" Required="true"
                                  MaxLength="10"
								  @bind-Value=item.Item.DispOrder For="@(() => item.Item.DispOrder)" OnlyValidateIfDirty="true" />
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Title="Year" Property="x => x.BudgetYear" Sortable="false"
							HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell data-align-top" />
            <PropertyColumn Title="Grouping L1" Property="x => x.GroupingL1"
                            HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell data-align-top"
                            HeaderStyle="min-width:200px" Sortable="false" />
            <PropertyColumn Property="x => x.GroupingL2" Title="Grouping L2"
                            HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell data-align-top"
                            HeaderStyle="min-width:180px" Sortable="false" />
            <PropertyColumn Property="x => x.GroupingL3" Title="Grouping L3."
                            HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell data-align-top" HeaderStyle="min-width:200px" />
            <PropertyColumn Property="x => x.ObjectName" Title="Budget Item"
                            HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell data-align-top"
                            HeaderStyle="min-width:280px" />
			<PropertyColumn Title="Category" Property="x => x.Category"
							HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell data-align-top" />
            <PropertyColumn Title="Act Tracker ID" Property="x => x.ActivityTrackID" Sortable="false"
                            HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell data-align-top reddit-mono-400"
                            HeaderStyle="min-width:120px" />
            <PropertyColumn Title="Class 2" Property="x => x.Class2"
							HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell data-align-top"
                            HeaderStyle="min-width:180px" />
            <PropertyColumn Title="Currency" Property="x => x.CurrencyCode" Filterable="false" Sortable="false"
                            HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell data-align-top" />
            <PropertyColumn Title="Budget Amount" Property="x => x.BudgetedAmount" Format="#,##0" Sortable="false"
                            HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell data-align-top reddit-mono-500"
                            HeaderStyle="min-width:140px" CellStyle="text-align:right" />
            <PropertyColumn Title="Expense Amount" Property="x => x.TotalExpenseAmount" Format="#,##0" Sortable="false"
                            HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell data-align-top reddit-mono-500"
                            HeaderStyle="min-width:140px" CellStyle="text-align:right" />
            @* <PropertyColumn Property="x => x.RemainingAmount" Title="Remaining Amount" HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell" Format="#,##0" CellStyle="text-align:right" /> *@
            <TemplateColumn Title="Remaining Amount" Filterable="false" Sortable="false"
                            HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell data-align-top"
                            HeaderStyle="min-width:150px" CellStyle="text-align:right" Context="item">
                <CellTemplate>
                    <MudText Typo="Typo.body1" Class="reddit-mono-500" Color="@(item.Item.RemainingAmount > 0 ? Color.Success : (item.Item.RemainingAmount < 0 ? Color.Error : Color.Default))">
                        @item.Item.RemainingAmount.ToString("#,##0")
                    </MudText>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.TaxRateText" Title="Tax Rate" Sortable="false"
                            HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell data-align-top"
                            HeaderStyle="min-width:110px" />
            <PropertyColumn Title="Budget ID" Property="x => x.ObjectCode"
                            HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell data-align-top reddit-mono-400" HeaderStyle="min-width:150px" />
            <PropertyColumn Title="Version" Property="x => x.VersionName"
                            HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell data-align-top"
							HeaderStyle="min-width:200px" />
			<PropertyColumn Title="Account Code" Property="x => x.AccountCode" Sortable="false"
							HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell data-align-top reddit-mono-400"
							HeaderStyle="min-width:150px" />
			<PropertyColumn Title="Account Name" Property="x => x.AccountName" Sortable="false"
							HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell data-align-top"
							HeaderStyle="min-width:250px" />
            <TemplateColumn Title="Action" Sortable="false" Filterable="false" StickyRight="true"
							HeaderClass="pru-mud-datagrid-hdr cruc-pg-items" CellClass="pru-mud-datagrid-cell"
							HeaderStyle="justify-items:center"
							CellStyle="padding-inline-end:4px; padding-inline-start:4px; padding-top: 2px !important; padding-bottom: 2px !important">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        
					</MudStack>
				</CellTemplate>
			</TemplateColumn>
		</Columns>
		<PagerContent>
			<MudDataGridPager T="BudgetItem" Class="pru-mud-datagrid-pager" PageSizeOptions="new[] {10, 30, 50, 80, 100}" />
		</PagerContent>
	</MudDataGrid>
</MudPaper>

@code {
	#region UI PARAM
	Dictionary<string, string> _lbuFlagList = PruLBUs.GetFlagIconPaths();
	List<int> _budgetYrList = [];
	List<BudgetItem> _budgetItemList = [];
	int _budgetYr;
	BudgetItem? _tempItemToAdd;
	string? UrlPrefix;
	MudDataGrid<BudgetItem>? _dataGrid;
	bool _isSearching = false;
	int _selectedRowNo;

	BudgetItem? SelectedObject;

	Dictionary<string, string> _statusCssClassList = new()
		{
			{ "", "" },
			{ AssetLifeCycleStatuses.IN_STOCK, "status-chip-success-light" },
			{ AssetLifeCycleStatuses.IN_USE, "status-chip-success-light" },
			{ AssetLifeCycleStatuses.TERMINATED, "status-chip-obsolete-light" },
			{ AssetLifeCycleStatuses.WRITTEN_OFF, "status-chip-obsolete-light" },
			{ AssetLifeCycleStatuses.PENDING_REVIEW, "status-chip-pending-light" },
			{ AssetLifeCycleStatuses.PENDING_WRITE_OFF, "status-chip-pending-light" },
			{ AssetLifeCycleStatuses.PENDING_TERMINATION, "status-chip-pending-light" },
		};
	#endregion

