	void StartedEditingItem(BudgetItem item)
	{

	}

	void CanceledEditingItem(BudgetItem item)
	{
		if (_tempItemToAdd != null)
		{
			_budgetItemList.Remove(item);
			_tempItemToAdd = null;
		}
	}

	void CommittedItemChanges(BudgetItem item)
	{
		_tempItemToAdd = null;
	}

	public async ValueTask EditRecordHotKeyPressed()
	{
		await Task.CompletedTask;
	}

	private void PopuplateSearchFilters()
	{

	}

	async Task PopulateUIControls()
	{
		for (int i=0; i<3; i++)
		{
			_budgetYrList.Add(DateTime.Today.Year - i);
		}

		_budgetYr = DateTime.Today.Year;

		List<SqlFilterCond> filterConds = [];

		filterConds.Add(new SqlFilterCond()
		{
			FieldName = nameof(BudgetItem.IsCurrent),
			FilterOperator = "=",
			FilterValue = true
		});

		filterConds.Add(new SqlFilterCond()
		{
			FieldName = nameof(BudgetItem.BudgetYear),
			FilterOperator = "=",
			FilterValue = _budgetYr
		});

		_budgetItemList = (await Uow.BudgetItems.SearchNewAsync(0, 0, null, null, filterConds, null)).Value.ToList();
	}
	#endregion
}
