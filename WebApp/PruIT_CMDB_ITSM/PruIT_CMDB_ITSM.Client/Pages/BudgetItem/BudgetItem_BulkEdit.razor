	#region UI FUNCTIONS
	protected async ValueTask QuickViewHotKeyPressed()
	{
		await Task.CompletedTask;
	}

	protected string SelectedRowClassFunc(BudgetItem element, int rowNumber)
	{
		if (_selectedRowNo == rowNumber)
		{
			_selectedRowNo = -1;
			return string.Empty;
		}
		else if (_dataGrid!.SelectedItem != null && _dataGrid!.SelectedItem.Equals(element))
		{
			_selectedRowNo = rowNumber;
			return "pru-mud-datagrid-row selected";
		}
		else
		{
			return string.Empty;
		}
	}
	#endregion

	#region CRUD FUNCTIONS
	#endregion

	#region INTERNAL FUNCTIONS
	private Func<BudgetItem, bool> _quickFilter => x =>
	{
		return !x.IsDeleted;
	};

	void AddItem()
	{
		_tempItemToAdd = new()
		{
			
		};

		_budgetItemList.Add(_tempItemToAdd);
		// _itemDataGrid.SetEditingItemAsync(_tempItemToAdd);
	}

	void RemoveItem(BudgetItem item)
	{
		if (item.Id == 0)
		{
			_budgetItemList!.Remove(item);
		}
		else if (item.Id > 0)
		{
			item.IsDeleted = true;
		}
	}

