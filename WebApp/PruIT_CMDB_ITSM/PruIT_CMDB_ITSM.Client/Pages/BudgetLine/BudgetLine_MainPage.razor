@page "/fin/budget-line/main"
@using PruIT_CMDB_ITSM.Client.Pages

@* @rendermode InteractiveAuto *@

@inject SweetAlertService Swal
@inherits MainPageBase<BudgetLine>

<MudPaper Class="pru-ui-mudcard-hdr-banner px-5 py-4" Width="100%" Elevation="0" Outlined="true">
	<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
		<MudText Typo="Typo.h3" Color="Color.Secondary">@HeaderTitle</MudText>
		<MudButton Color="Color.Primary" DropShadow="false" Size="Size.Small" Variant="Variant.Filled"
				   Class="pru-ui-mudbutton" StartIcon="material-symbols-rounded/add_circle"
				   OnClick="@(args => CreateOrEditRecord(0))">Add New</MudButton>
	</MudStack>
</MudPaper>

<MudPaper Class="pru-std-card-white mt-4" Outlined="true" Elevation="0" Height="100%" Width="100%" Style="overflow-y:hidden">
	<MudStack Class="pa-6" Row="true" AlignItems="AlignItems.Start" Justify="Justify.FlexStart" StretchItems="StretchItems.None">
		<MudTextField Clearable="true" ShrinkLabel="true" Immediate="true" Variant="Variant.Text" Class="pru-ui-mudform-input"
					  AdornmentIcon="material-symbols-rounded/search" Adornment="Adornment.Start" AdornmentColor="Color.Primary"
					  Placeholder="Search text here..."
					  @bind-Value="SearchText" OnKeyDown="OnSearchBoxKeyDown" @ref=UITextBoxSearch Disabled=IsSearching />
		<MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" DropShadow="false"
				   Class="pru-ui-mudbutton" StartIcon="material-symbols-rounded/search"
				   OnClick="OnSearchClicked">Search</MudButton>
	</MudStack>
	<MudDataGrid Dense="true" Hover="true" Bordered="false" Square="true" FixedHeader="true" Striped="true"
				 ColumnResizeMode="ResizeMode.Column" SortMode="SortMode.Multiple" Loading=@IsSearching RowsPerPage="50" Elevation="0"
				 Class="pru-ui-muddatagrid main-pg"
				 SelectOnRowClick="true" RowClassFunc="SelectedRowClassFunc" RowClass="mud-datagrid-row" NoRecordsContent=HtmlDataGridZeroRecord
				 ServerData="ServerDataFunc" @ref="MainDataGrid" @bind-SelectedItem=SelectedObject Height="100%" 
				 T="BudgetLine">
		<Columns>
			<PropertyColumn Title="Order #" Property="x => x.OrderNo"
                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell data-align-top"
                            HeaderStyle="min-width:180px" Sortable="false" />
			<PropertyColumn Title="Display Order" Property="x => x.DisplayOrder" Sortable="false"
							HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell data-align-top reddit-mono-500"
							HeaderStyle="min-width:140px" CellStyle="text-align:right" />
			<PropertyColumn Title="Display Order" Property="x => x.DisplayOrder"
                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell data-align-top" 
							HeaderStyle="min-width:200px" />
            <PropertyColumn Property="x => x.ObjectName" Title="Budget Item"
                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell data-align-top"
                            HeaderStyle="min-width:280px" />
			<PropertyColumn Title="Hierarchy Path" Property="x => x.HierarchyPath" Sortable="false"
							HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell data-align-top"
							HeaderStyle="min-width:250px" />
            <TemplateColumn Title="Action" Sortable="false" Filterable="false" StickyRight="true"
							HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell"
							HeaderStyle="justify-items:center; width:300px; max-width:120px" CellStyle="padding-inline-end:4px; padding-inline-start:4px" >
                <CellTemplate>
					<MudStack Row="true" Spacing="0">
						<MudIconButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info"
									   Class="pru-ui-mudiconbtn-datagrid" Icon="material-symbols-rounded/edit"
									   OnClick="@(args => CreateOrEditRecord(context.Item.Id))" aria-label="edit" />
						<MudIconButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info"
									   Class="pru-ui-mudiconbtn-datagrid" Icon="material-symbols-rounded/file_copy"
									   OnClick="@(args => CloneAndEditRecord(context.Item.Id))" aria-label="clone" />
						<MudIconButton Variant="Variant.Text" Size="Size.Small" Color="Color.Success"
									   Class="pru-ui-mudiconbtn-datagrid" Icon="material-symbols-rounded/visibility"
									   OnClick="@(args => ViewFullRecord(context.Item.Id))" aria-label="view" />
						<MudIconButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error"
									   Class="pru-ui-mudiconbtn-datagrid" Icon="material-symbols-rounded/delete"
									   OnClick="@(args => DeleteRecord(context.Item))" aria-label="delete" />
					</MudStack>
				</CellTemplate>
			</TemplateColumn>
		</Columns>
		<PagerContent>
			<MudDataGridPager T="BudgetLine" Class="pru-ui-muddatagrid-pager" PageSizeOptions="new[] {10, 30, 50, 80, 100}" />
		</PagerContent>
	</MudDataGrid>
</MudPaper>

