	</Columns>
	<PagerContent>
			<MudDataGridPager T="CmdbToAppMapping" Class="pru-ui-muddatagrid-pager" PageSizeOptions="new[] { 10, 20, 30, 50, 80, 100 }" />
	</PagerContent>
</MudDataGrid>
</MudPaper>

@code {

