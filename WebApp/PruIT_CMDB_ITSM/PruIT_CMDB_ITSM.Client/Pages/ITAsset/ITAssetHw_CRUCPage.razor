    #region UPDATE FUNCTIONS
    protected override async Task PreSaveProcessing()
    {
        CurrentObject!.ObjectCode = CurrentObject!.ObjectCode!.ToUpper();
        await Task.CompletedTask;
    }

    protected override async Task ValidatePreSave()
    {
        InvalidMsgList.Clear();

        bool isDuplicated = await Uow.ITAssets.IsDuplicateCodeAsync(CurrentObject!.Id, CurrentObject!.ObjectCode!);

        if (isDuplicated)
        {
            InvalidMsgList.Add("ObjectCode_Duplicate", $"Asset with ID='{CurrentObject.ObjectCode}' is already existed.");
        }

        if (CurrentObject!.OwnershipTag == OwnershipTags.FUNCTION && string.IsNullOrEmpty(CurrentObject!.CurrentUserFunc))
        {
            InvalidMsgList.Add("CurrentUserFunc_Required", "Function is required when Ownership Tag is 'Function'.");
        }
        else if (CurrentObject!.OwnershipTag == OwnershipTags.DEPARTMENT && string.IsNullOrEmpty(CurrentObject!.CurrentUserDept))
        {
            InvalidMsgList.Add("CurrentUserDept_Required", "Department is required when Ownership Tag is 'Department'.");
        }
    }

