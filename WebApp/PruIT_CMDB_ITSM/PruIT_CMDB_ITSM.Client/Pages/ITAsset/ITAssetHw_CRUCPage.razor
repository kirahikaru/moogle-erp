                                          @bind-Value=CurrentObject!.FinAssetCode For="@(() => CurrentObject.FinAssetCode)" OnlyValidateIfDirty="true" />
                        </MudItem>
                        <MudItem xs="2">
                            <MudDatePicker Clearable="true" Editable="true" ReadOnly="@IsViewMode" Required="false" ShrinkLabel="true" Variant="Variant.Text"
