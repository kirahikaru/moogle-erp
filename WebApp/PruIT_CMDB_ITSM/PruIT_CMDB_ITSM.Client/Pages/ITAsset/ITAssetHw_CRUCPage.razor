    private Func<ITAssetAuditTrail, bool> _quickAssetAuditTrailFilter => x =>
    {
        return !x.IsDeleted;
    };

    void AddItem()
    {
        _tempItemToAdd = new ITAssetAuditTrail()
        {
            SeqNo = CurrentObject!.AuditTrails.Count + 1
        };

        if (!string.IsNullOrEmpty(CurrentObject!.CurrentUserID))
        {
            _tempItemToAdd.CurrentUserID = CurrentObject!.CurrentUserID;
            _tempItemToAdd.CurrentUserName = CurrentObject!.CurrentUserName;
        }

        CurrentObject!.AuditTrails.Add(_tempItemToAdd);
        _auditTrailDataGrid.SetEditingItemAsync(_tempItemToAdd);
        _isEditingItemDataGrid = true;
    }

    void RemoveItem(ITAssetAuditTrail i)
    {
        int seqNoToRemove = i.SeqNo!.Value;

        if (i.Id > 0)
        {
            i.IsDeleted = true;
        }
        else
        {
            CurrentObject!.AuditTrails.Remove(i);

            foreach (ITAssetAuditTrail auditTrail in CurrentObject!.AuditTrails.Where(x => x.SeqNo > seqNoToRemove).OrderBy(x => x.SeqNo))
            {
                auditTrail.SeqNo = seqNoToRemove;
                seqNoToRemove++;
            }
        }
    }

    void CloneItem(ITAssetAuditTrail i)
    {
        _tempItemToAdd = i.DeepClone();
        _tempItemToAdd.Id = 0;
        _tempItemToAdd.SeqNo = CurrentObject!.AuditTrails.Count + 1;

        CurrentObject!.AuditTrails.Add(_tempItemToAdd);
        _auditTrailDataGrid.SetEditingItemAsync(_tempItemToAdd);
    }

    void MoveItemUp(ITAssetAuditTrail i)
    {
        if (i.SeqNo == 1)
            return;
        else
        {
            i.SeqNo--;
            var tmpInvItem = CurrentObject!.AuditTrails.SingleOrDefault(x => x.SeqNo == i.SeqNo && x != i);
            if (tmpInvItem != null)
                tmpInvItem.SeqNo++;

            CurrentObject!.AuditTrails = CurrentObject!.AuditTrails.OrderBy(x => x.SeqNo).ToList();
        }
    }

    void MoveItemDown(ITAssetAuditTrail i)
    {
        if (i.SeqNo == CurrentObject!.AuditTrails.Count())
            return;
        else
        {
            i.SeqNo++;
            var tmpInvItem = CurrentObject!.AuditTrails.SingleOrDefault(x => x.SeqNo == i.SeqNo && x != i);
            if (tmpInvItem != null)
                tmpInvItem.SeqNo--;

            CurrentObject!.AuditTrails = CurrentObject!.AuditTrails.OrderBy(x => x.SeqNo).ToList();
        }
    }

    void StartedEditingItem(ITAssetAuditTrail item)
    {
        _isEditingItemDataGrid = true;
    }

    void CanceledEditingItem(ITAssetAuditTrail item)
    {
        if (_tempItemToAdd != null)
        {
            foreach (ITAssetAuditTrail auditTrail in CurrentObject!.AuditTrails)
            {
                if (auditTrail == _tempItemToAdd)
                {
                    CurrentObject!.AuditTrails.Remove(auditTrail);
                    break;
                }
            }

            _tempItemToAdd = null;
        }

        _isEditingItemDataGrid = false;
    }

    Task<DataGridEditFormAction> CommittedItemChanges(ITAssetAuditTrail item)
    {
        _tempItemToAdd = null;
        _isEditingItemDataGrid = false;

        if (!string.IsNullOrEmpty(item.ActionDesc) && item.ActionDesc.Is("05-Return", "88-Write-Off", "99-Dispose", "88-Terminate"))
        {
            CurrentObject!.CurrentUserID = null;
            CurrentObject!.CurrentUserName = null;
            _currentUser = null;
        }
        else if (item.ActionDesc.Is("03-Allocate", "02-Unbox Allocation"))
        {
            CurrentObject!.CurrentUserID = item.TargetUserID;
            CurrentObject!.CurrentUserName = item.TargetUserName;
            _currentUser = _employeeList.SingleOrDefault(x => x.Key == item.TargetUserID);
            CurrentObject!.LifeCycleStatus = AssetLifeCycleStatuses.IN_USE;
        }

        if (item.ActionDesc == "05-Return")
        {
            CurrentObject!.LifeCycleStatus = AssetLifeCycleStatuses.IN_STOCK;
        }
        else if (item.ActionDesc == "88-Write-Off")
        {
            CurrentObject!.LifeCycleStatus = AssetLifeCycleStatuses.WRITTEN_OFF;
        }

        StateHasChanged();
        return Task.FromResult(DataGridEditFormAction.Close);
    }

