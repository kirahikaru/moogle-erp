                                       ClearIcon="material-symbols-rounded/close" IconSize="Size.Small"
                                       AdornmentIcon="material-symbols-rounded/keyboard_arrow_down" AdornmentColor="Color.Primary" 
                                       Label="Life Cycle Status"
                                       T="string" @bind-Value=CurrentObject!.LifeCycleStatus For="@(() => CurrentObject.LifeCycleStatus)" OnlyValidateIfDirty="true">
                                @foreach (DropdownSelectItem lifeCycleStatus in _assetLifeCycleList)
                                {
                                    <MudSelectItem Value=@lifeCycleStatus.Key>@lifeCycleStatus.Value</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="3">
                            <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly="@IsViewMode" Required="true" ShrinkLabel="true"
                                          Class="pru-ui-mudform-input"
                                          ClearIcon="material-symbols-rounded/close" IconSize="Size.Small"
                                          Label="Product Name" MaxLength="255"
                                          @bind-Value=CurrentObject!.ProductName For="@(() => CurrentObject.ProductName)" OnlyValidateIfDirty="true" />
                        </MudItem>
                        <MudItem xs="2">
                            <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly="@IsViewMode" Required="false" ShrinkLabel="true"
