@page "/itasset/category/cruc/{CRUCMode}"
@page "/itasset/category/cruc/{CRUCMode}/{id:int}"

@* @rendermode InteractiveAuto*@

@inherits CRUCPageBase<ITAssetCategory>

@if (CurrentObject != null && CurrentEditContext != null)
{
    <EditForm EditContext="CurrentEditContext" OnValidSubmit="SaveDummy" OnInvalidSubmit="SaveDummy" style="min-height0; height:stretch; display:flex; flex-direction:column">
        <DataAnnotationsValidator />
        <MudPaper Class="pru-ui-mudcard-hdr-banner" Width="100%" Elevation="0" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <div style="color:var(--pru-red-default); font-size:30px;">
                    <span style="font-weight:700">@HeaderTitle</span>
                    @if (CRUCMode == CRUDCModes.READ)
                    {
                        <MudChip Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined" Class="pru-ui-mudchip-banner-status" T="string" Style="margin-top:-10px">VIEW</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.UPDATE)
                    {
                        <MudChip Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined" Class="pru-ui-mudchip-banner-status" T="string" Style="margin-top:-10px">UPDATE</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.CREATE)
                    {
                        <MudChip Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined" Class="pru-ui-mudchip-banner-status" T="string" Style="margin-top:-10px">NEW</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.CLONE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="pru-ui-mudchip-banner-status" T="string" Style="margin-top:-10px">NEW (Clone)</MudChip>
                    }
                </div>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd">
                    @if (!IsViewMode)
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Color="Color.Secondary" Class="pru-ui-mudbutton"
                                   StartIcon="fa-light fa-floppy-disk-pen"
                                   OnClick="@(() => Save())">Save</MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Color="Color.Secondary" Class="pru-ui-mudbutton"
                                   StartIcon="fa-light fa-floppy-disk-circle-arrow-right"
                                   OnClick="@(() => Save(true))">Save & Close</MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Color="Color.Default" Class="pru-ui-mudbutton"
                                   StartIcon="fa-light fa-circle-xmark"
                                   OnClick="Cancel">Cancel</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Color="Color.Secondary"
                                   StartIcon="material-symbols-rounded/close"
                                   OnClick="Cancel">Close</MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>
        <MudTabs Class="pru-mudtab mt-5" Elevation="0" ActiveTabClass="pru-mudtab-active" TabHeaderClass="pru-mudtab-hdr" TabButtonsClass="pru-mudtab-btn" TabPanelsClass="pru-mudtab-tabpanel">
            <MudTabPanel Text="Main" Icon="fa-duotone fa-house-chimney" 
                         Class="pru-mudtabpanel" PanelClass="pru-mudtabpanel-panel" Style="min-width:120px">
                <MudPaper Class="pru-ui-mudpaper-cruc-tab-content" Square="true" Width="100%" Elevation="0">
                    <MudForm Model="@CurrentObject" @ref=@CrucForm @bind-IsValid=@IsValidationPassed @bind-Errors=@MudValidationErrors >
                        <MudGrid Spacing="2" Justify="Justify.SpaceEvenly">
                            <MudItem xs="6">
                                <MudTextField ReadOnly="@IsViewMode" Clearable="true" ShrinkLabel="true" FullWidth="true" Class="pru-ui-mudform-input" Required="true"
                                              Label="Name"
                                              @bind-Value=CurrentObject!.ObjectName For="@(() => CurrentObject.ObjectName)" 
                                              MaxLength="255" @ref=_uiControlObjectName />
                            </MudItem>
                            <MudItem xs="3">
                                <MudTextField ReadOnly="@IsViewMode" Clearable="true" ShrinkLabel="true" FullWidth="true" Class="pru-ui-mudform-input" MaxLength="80"
                                              Label="ID"
                                              @bind-Value=CurrentObject!.ObjectCode For="@(() => CurrentObject.ObjectCode)" OnlyValidateIfDirty="true"
                                              Required="true" RequiredError="'ID' is required." />
                            </MudItem>
                            <MudItem xs="3">
                                <MudSelect Clearable="true" FullWidth="true" Immediate="false" ReadOnly="@IsViewMode" Required="true" ShrinkLabel="true"
                                           Class="pru-ui-mudform-input" PopoverClass="pru-ui-mudselect-popover" InputClass="pru-ui-mudselect-input" ListClass="pru-ui-mudselect-list" OuterClass="pru-ui-mudselect-outer"
                                           ClearIcon="fa-regular fa-xmark" IconSize="Size.Small"
                                           AdornmentIcon="fa-solid fa-angle-down" AdornmentColor="Color.Primary"
                                           Label="Asset Type" Placeholder="Select asset type"
                                           Value=CurrentObject!.AssetType For="@(() => CurrentObject.AssetType)" ValueChanged="OnAssetTypeChanged" InputId="AssetType" T="string" OnlyValidateIfDirty="true">
                                    @foreach (DropdownSelectItem assetType in _assetTypeList)
                                    {
                                        <MudSelectItem Value=@assetType.Key>@assetType.Value</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            @if (CurrentObject.Id > 0)
                            {
                                <MudItem xs="12">
                                    <MudComboBox Clearable="true" Editable="true" FullWidth="true" ReadOnly=@IsViewMode Required="false" SearchBox="true" SearchBoxAutoFocus="true" SearchBoxClearable="true" ShrinkLabel="true" autocomplete="new-password"
                                                 Class="pru-ui-combobox" PopoverClass="pru-ui-combobox-popover" InputClass="pru-ui-combobox-input" HighlightClass="pru-ui-combobox-input" TemplateClass="pru-ui-combobox-input" ChipClass="pru-ui-combobox-chip"
                                                 AdornmentIcon="fa-solid fa-angle-down" AdornmentColor="Color.Primary" Adornment="Adornment.End" HasAdornmentEnd="true"
                                                 Label="Parent" T="int?"
                                                 Value="@CurrentObject.ParentId" ValueChanged="OnParentChanged"
                                                 ToStringFunc="@(val => val is not null && val > 0 ? _validParentList.SingleOrDefault<DropDownListItem>(x => x.ObjectId == val)?.ObjectName : "-")">
                                        <ChildContent>
                                            @foreach (var item in _validParentList)
                                            {
                                                <MudComboBoxItem T="int?" Value="@item.ObjectId" Text="@item.ObjectName">@item.ObjectName</MudComboBoxItem>
                                            }
                                        </ChildContent>
                                    </MudComboBox>
                                </MudItem>
                            }
                            <MudItem xs="12">
                                <MudTextField ReadOnly="true" Clearable="true" ShrinkLabel="true" FullWidth="true" Class="pru-ui-mudform-input"
                                              Label="Hierarchy Path"
                                              @bind-Value=CurrentObject!.HierarchyPath For="@(() => CurrentObject.HierarchyPath)" OnlyValidateIfDirty="true" />
                            </MudItem>
                            @if (CurrentEditContext.GetValidationMessages().Any() || InvalidMsgList.Count > 0)
                            {
                                <MudItem xs="12" Class="pt-10">
                                    @foreach (string msg in CurrentEditContext.GetValidationMessages())
                                    {
                                        <MudAlert Variant="Variant.Outlined" Severity="Severity.Warning" Dense="true" Icon="fa-slab-press-duo fa-regular fa-triangle-exclamation" Class="pru-alert-validation mt-2">@msg</MudAlert>
                                    }
                                    @foreach (string key in InvalidMsgList.Keys)
                                    {
                                        <MudAlert Variant="Variant.Outlined" Severity="Severity.Warning" Dense="true" Icon="fa-slab-press-duo fa-regular fa-triangle-exclamation" Class="pru-alert-validation mt-2">@InvalidMsgList[key]</MudAlert>
                                    }
                                </MudItem>
                            }
                        </MudGrid>
                    </MudForm>
                </MudPaper>
                <MudPaper Class="pru-mudpaper-status-bar" Elevation="0" Height="var(--pru-cruc-pg-status-bar-height)">
                    @if (CurrentObject.Id > 0)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Justify="Justify.FlexStart" Style="height:100%; padding: 0px 10px">
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary">Created By</MudText>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@CurrentObject.CreatedUser</MudText>
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary">on</MudText>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@(CurrentObject.CreatedDateTime.HasValue ? CurrentObject.CreatedDateTime!.Value.ToString("dd-MMM-yyyy hh:mm:ss tt") : " - ")</MudText>
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary"> | Last Modified By</MudText>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@CurrentObject.ModifiedUser</MudText>
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary">on</MudText>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@(CurrentObject.ModifiedDateTime.HasValue ? CurrentObject.ModifiedDateTime!.Value.ToString("dd-MMM-yyyy hh:mm:ss tt") : " - ")</MudText>
                        </MudStack>
                    }
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Text="Other Info" Class="pru-mudtabpanel" PanelClass="pru-mudtabpanel-panel" 
                         Icon="fa-duotone fa-memo-circle-info"  Style="min-width:120px">
                <MudPaper Class="pru-ui-mudpaper-cruc-tab-content px-4 pt-2 pb-5 overflow-y-auto" Height="100%" Width="100%" Elevation="0" 
                          Style="border-bottom: 1px solid var(--tw-gray-300); border-bottom-left-radius:var(--pru-base-card-radius); border-bottom-right-radius:var(--pru-base-card-radius)">
                          <MudStack Class="pa-6" Row="true" AlignItems="AlignItems.Start" Justify="Justify.FlexStart" StretchItems="StretchItems.None">
		                        <MudTextField Clearable="true" ShrinkLabel="true" Immediate="true" Variant="Variant.Text" Class="pru-ui-mudform-input"
					                          ClearIcon="fa-regular fa-xmark" IconSize="Size.Small"
					                          AdornmentIcon="fa-duotone fa-light fa-magnifying-glass" Adornment="Adornment.Start" AdornmentColor="Color.Primary"
					                          Placeholder="Search text here..."
                                      @bind-Value="_searchText" OnKeyDown="OnSearchBoxKeyDown" @ref=_uiTextBoxSearch Disabled=_isSearching />
		                        <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" DropShadow="false"
				                           Class="pru-ui-mudbutton" StartIcon="fa-light fa-magnifying-glass"
				                           OnClick="OnSearchClicked">Search</MudButton>
	                        </MudStack>
	                <MudDataGrid Dense="true" Hover="true" Bordered="false" Square="true" FixedHeader="true" Striped="true"
				                 ColumnResizeMode="ResizeMode.Column" SortMode="SortMode.Multiple" Loading=@_isSearching RowsPerPage="50" Elevation="0"
				                 Class="pru-ui-muddatagrid main-pg"
				                 SelectOnRowClick="true" RowClassFunc="SelectedRowClassFunc" 
                                 ServerData="ServerDataFunc" @ref="_itAssetDataGrid" @bind-SelectedItem=_selectedObject Height="100%" T="ITAsset">
		                <Columns>
                            <TemplateColumn Title="LBU" StickyLeft="true"
                                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell" Context="rowData">
                                <CellTemplate>
                                    <MudStack Row=true AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Spacing="1">
                                        <MudImage Src=@(_lbuFlagList[rowData.Item.LBU!]) Height="12" />
                                        <MudText Typo="Typo.body1">@rowData.Item.LBU</MudText>
                                    </MudStack>
                                </CellTemplate>
                            </TemplateColumn>
                            @* <PropertyColumn Property="x => x.ObjectName" Title="Asset Name" StickyLeft="true" HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell" /> *@
                            <TemplateColumn Title="Asset Name" StickyLeft="true"
                                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell" Context="rowData" HeaderStyle="min-width:250px" CellStyle="white-space:nowrap">
                                <CellTemplate>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Spacing="1">
                                        @if (rowData.Item.LifeCycleStatus.Is(AssetLifeCycleStatuses.TERMINATED, AssetLifeCycleStatuses.WRITTEN_OFF))
                                        {
                                            <span style="text-decoration:line-through; font-style:italic">@rowData.Item.ObjectName</span>
                                        }
                                        else if (rowData.Item.LifeCycleStatus.Is(AssetLifeCycleStatuses.PENDING_TERMINATION, AssetLifeCycleStatuses.PENDING_WRITE_OFF))
                                        {
                                            <MudIcon Icon="@Icons.Material.Rounded.WarningAmber" Style="color:var(--vic-orange-500);" />
                                            <span style="font-style:italic; color:var(--vic-orange-500);">@rowData.Item.ObjectName</span>
                                        }
                                        else
                                        {
                                            <span>@rowData.Item.ObjectName</span>
                                        }

                                        @if (rowData.Item.AssetState == AssetStates.BROKEN_UNREPAIRABLE)
                                        {
                                            <img src="svg/broken-phone-in-two-parts.svg" height="14" />
                                        }
                                    </MudStack>
                                </CellTemplate>
                            </TemplateColumn>
			                @if (CurrentObject!.AssetType == AssetTypes.Hardware)
                            {
                                <PropertyColumn Title="Brand" Property="x => x.Brand"
                                                HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell" />
                                <PropertyColumn Title="Model No" Property="x => x.ModelNo" Sortable="false"
                                                HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell"
                                                HeaderStyle="white-space:nowrap" CellStyle="white-space:nowrap" />
                                <PropertyColumn Title="Serial No." Property="x => x.SerialNo" Sortable="false"
                                                HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell pru-ui-font-mono"
                                                HeaderStyle="min-width:100px" CellStyle="white-space:nowrap" />
                                                <PropertyColumn Title="Staff ID" Property="x => x.CurrentUserDisplayName" Sortable="false"
                                                HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell"
							                    HeaderStyle="white-space:nowrap" CellStyle="white-space:nowrap" />
			                    <PropertyColumn Title="Vendor" Property="x => x.VendorName"
							                    HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell"
							                    HeaderStyle="white-space:nowrap" CellStyle="white-space:nowrap" />
			                    <PropertyColumn Title="PO#" Property="x => x.PORefNo"
							                    HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell pru-ui-font-mono"
							                    HeaderStyle="min-width:120px" CellStyle="white-space:nowrap" />
			                    <PropertyColumn Title="Invoice#" Property="x => x.InvoiceRefNo"
							                    HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell pru-ui-font-mono"
							                    HeaderStyle="white-space:nowrap" CellStyle="white-space:nowrap" />
			                    <PropertyColumn Title="Purchased Date" Property="x => x.PurchaseDate" Format="dd-MMM-yyyy"
                                                HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell pru-ui-font-mono"
                                                HeaderStyle="min-width: 170px" CellStyle="text-align:center" />
                                <PropertyColumn Title="Purchase Cost" Property="x => x.PurchaseCost" Format="$ #,##0"
                                                HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell"
                                                HeaderStyle="min-width: 170px" CellStyle="text-align:right" />
			                    <PropertyColumn Title="Fin Asset Code" Property="x => x.FinAssetCode" Filterable="false" Sortable="false"
							                    HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell pru-ui-font-mono"
							                    HeaderStyle="min-width:115px"/>
			                    <TemplateColumn Title="Asset State" Hidden="true" StickyRight="true"
                                                HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell"
                                                CellStyle="text-align:center; padding-top: 2px !important; padding-bottom: 2px !important"
                                                Context="itAsset">
                                    <CellTemplate>
                                        <MudChip Size="Size.Small" Class="@(!string.IsNullOrEmpty(itAsset.Item.AssetState) ? _stateCssClassList[itAsset.Item.AssetState!] : "status-chip-default-dark")">@itAsset.Item.AssetStateText</MudChip>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Status" Hidden="true" StickyRight="true"
                                                HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell"
                                                CellStyle="text-align:center; padding-top: 2px !important; padding-bottom: 2px !important"
                                                Context="itAsset">
                                    <CellTemplate>
                                        <MudChip Size="Size.Small" Class="@(!string.IsNullOrEmpty(itAsset.Item.LifeCycleStatus) ? _statusCssClassList[itAsset.Item.LifeCycleStatus!] : "status-chip-default-light")" Style="padding:2px 8px; font-size:9pt">
                                            @itAsset.Item.LifeCycleStatusText
                                        </MudChip>
                                    </CellTemplate>
                                </TemplateColumn>
                            }
                            else
                            {
                                
                            }
                            <PropertyColumn Title="Current User" Property="x => x.CurrentUserName"
                                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell"
                                            HeaderStyle="white-space:nowrap" CellStyle="white-space:nowrap" />
                            <PropertyColumn Title="Function" Property="x => x.CurrentUserFunc"
                                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell"
                                            HeaderStyle="white-space:nowrap" CellStyle="white-space:nowrap" />
                            <PropertyColumn Title="Department" Property="x => x.CurrentUserDept"
                                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell"
                                            HeaderStyle="white-space:nowrap" CellStyle="white-space:nowrap" />
                            <PropertyColumn Title="Ownership Tag" Property="x => x.OwnershipTag"
                                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell"
                                            HeaderStyle="white-space:nowrap" CellStyle="white-space:nowrap" />
                            <TemplateColumn Title="Action" Sortable="false" Filterable="false" StickyRight="true"
							                HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell"
							                HeaderStyle="justify-items:center; max-width:120px; width:500px"
							                CellStyle="padding-inline-end:4px; padding-inline-start:4px; padding-top: 2px !important; padding-bottom: 2px !important"
                                            Context="itAsset">
				                <CellTemplate>
					                <MudStack Row="true" Spacing="0">
						                <MudIconButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info"
									                   Class="pru-ui-mudiconbtn-datagrid" Icon="fa-duotone fa-light fa-edit"
                                                       OnClick="@(args => CreateOrEditRecord(itAsset.Item.Id))" aria-label="edit" />
						                <MudIconButton Variant="Variant.Text" Size="Size.Small" Color="Color.Success"
									                   Class="pru-ui-mudiconbtn-datagrid" Icon="fa-duotone fa-light fa-eye"
                                                       OnClick="@(args => ViewFullRecord(itAsset.Item.Id))" aria-label="view" />
					                </MudStack>
				                </CellTemplate>
			                </TemplateColumn>
		                </Columns>
		                <PagerContent>
                            <MudDataGridPager T="ITAsset" Class="pru-ui-muddatagrid-pager" PageSizeOptions="new[] { 10, 30, 50, 80, 100 }" />
		                </PagerContent>
	                </MudDataGrid>
                </MudPaper>
            </MudTabPanel>
        </MudTabs>
    </EditForm>
}


@code {
    #region UI PARAM
    Dictionary<string, string> _lbuFlagList = PruLBUs.GetFlagIconPaths();
    IEnumerable<DropDownListItem> _validParentList = [];
    IEnumerable<DropdownSelectItem> _assetTypeList = AssetTypes.GetForDropdownList();
    MudTextField<string>? _uiControlObjectName;
    string _parentHierarchyPath = "";
    string _searchText { get; set; }
    MudTextField<string>? _uiTextBoxSearch { get; set; }
    MudDataGrid<ITAsset>? _itAssetDataGrid { get; set; }
    ITAsset? _selectedObject;
    IEnumerable<ITAsset> _itAssetList = Enumerable.Empty<ITAsset>();
    bool _isSearching;
    int _selectedRowNo;
    Dictionary<string, string> _statusCssClassList = new()
        {
            { "", "" },
            { AssetLifeCycleStatuses.IN_STOCK, "status-chip-success-light" },
            { AssetLifeCycleStatuses.IN_USE, "status-chip-success-light" },
            { AssetLifeCycleStatuses.TERMINATED, "status-chip-obsolete-light" },
            { AssetLifeCycleStatuses.WRITTEN_OFF, "status-chip-obsolete-light" },
            { AssetLifeCycleStatuses.PENDING_REVIEW, "status-chip-pending-light" },
            { AssetLifeCycleStatuses.PENDING_WRITE_OFF, "status-chip-pending-light" },
            { AssetLifeCycleStatuses.PENDING_TERMINATION, "status-chip-pending-light" },
            { AssetLifeCycleStatuses.ON_LOAN, "status-chip-pending-light" },
            { AssetLifeCycleStatuses.DISPOSED, "status-chip-obsolete-light" },
        };

    Dictionary<string, string> _stateCssClassList = new()
    {
        { "", "" },
        { AssetStates.BRAND_NEW, "status-chip-success-light" },
        { AssetStates.USED_GOOD, "status-chip-success-light" },
        { AssetStates.USED_POOR, "status-chip-obsolete-light" },
        { AssetStates.USED_ESR, "status-chip-pending-light" },
        { AssetStates.EOL, "status-chip-obsolete-light" },
        { AssetStates.EOS, "status-chip-obsolete-light" },
        { AssetStates.BROKEN_UNREPAIRABLE, "status-chip-pending-light" },
        { AssetStates.NA, "status-chip-pending-light" }
    };
    #endregion

    #region PAGE LIFECYCLE FUNCTIONS
    public override Task SetParametersAsync(ParameterView parameters)
    {
        UrlPrefix = "/itasset/category";

        return base.SetParametersAsync(parameters);
    }

    protected override async Task OnInitializedAsync()
    {
        if (InitCount > 0)
        {
            InitCount++;
            return;
        }
        else
        {
            InitCount++;
        }

        switch(CRUCMode)
        {
            case CRUCModes.READ:
                {
                    CurrentObject = await Uow.ITAssetCategories.GetAsync(Id);
                    IsViewMode = true;
                }
                break;
            case CRUCModes.CREATE:
                {
                    CurrentObject = new();
                }
                break;
            case CRUCModes.UPDATE:
                CurrentObject = await Uow.ITAssetCategories.GetAsync(Id);
                break;
            case CRUCModes.CLONE:
                {
                    var tempObj = await Uow.ITAssetCategories.GetAsync(Id);
                    CurrentObject = tempObj.DeepClone();
                    CurrentObject!.Id = 0;
                    CurrentObject!.ObjectCode = String.Empty;
                } break;
        }

        CurrentEditContext = new EditContext(CurrentObject!);

        HeaderTitle = ObjectDisplayName;

        if (CurrentObject!.Parent is not null)
            _parentHierarchyPath = CurrentObject!.Parent.HierarchyPath!;

        await PopulateUIControl();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_uiControlObjectName is not null)
                await _uiControlObjectName.FocusAsync();

            await JsRuntime!.InvokeVoidAsync("console.log", $"Initialization Count: {InitCount}");
        }
    }
    #endregion

    #region UI FUNCTIONS
    
    private async Task OnAssetTypeChanged(string assetType)
    {
        if (string.IsNullOrEmpty(assetType))
            CurrentObject!.AssetType = null;
        else
            CurrentObject!.AssetType = assetType;
    }

    void OnParentChanged(int? val)
    {
        if (val is null || val <= 0)
        {
            CurrentObject!.ParentId = null;
            CurrentObject!.ParentCode = null;
            CurrentObject!.Parent = null;
            _parentHierarchyPath = string.Empty;
        }
        else
        {
            DropDownListItem? item = _validParentList.SingleOrDefault<DropDownListItem>(x => x.ObjectId == val!.Value);

            if (item is not null)
            {
                CurrentObject!.ParentId = item.ObjectId;
                CurrentObject!.ParentCode = item.ObjectCode;
                _parentHierarchyPath = item.HierarchyPath ?? "";
            }
        }
    }

    public async Task CreateOrEditRecord(int objId)
