    public async Task OnSearchClicked()
    {
        await _uiTextBoxSearch!.ClearAsync();
        await _uiTextBoxSearch!.FocusAsync();
        await _itAssetDataGrid!.ReloadServerData();
    }

    public async Task OnSearchBoxKeyDown(KeyboardEventArgs args)
    {
        if (_isSearching) return;

        switch (args.Key)
        {
            case "Enter":
                await _uiTextBoxSearch!.FocusAsync();
                await _itAssetDataGrid!.ReloadServerData();
                break;
            case "Escape":
                await _uiTextBoxSearch!.ClearAsync();
                await _uiTextBoxSearch!.FocusAsync();
                await _itAssetDataGrid!.ReloadServerData();
                break;
            default:
                return;
        }
    }

    protected string SelectedRowClassFunc(ITAsset element, int rowNumber)
    {
        if (_selectedRowNo == rowNumber)
        {
            _selectedRowNo = -1;
            return string.Empty;
        }
        else if (_selectedObject != null && _selectedObject.Equals(element))
        {
            _selectedRowNo = rowNumber;
            return "pru-ui-muddatagrid-row selected";
        }
        else
        {
            return string.Empty;
        }
    }

