@page "/core/org-struct-type/cruc/{CRUCMode}"
@page "/core/org-struct-type/cruc/{CRUCMode}/{id:int}"

@* @rendermode InteractiveAuto*@

@inherits CRUCPageBase<OrgStructType>

@if (CurrentObject != null && CurrentEditContext != null)
{
    <EditForm EditContext="CurrentEditContext" OnValidSubmit="SaveDummy" OnInvalidSubmit="SaveDummy" style="height:100%; display:flex; flex-direction:column">
        <DataAnnotationsValidator />
        <MudPaper Class="pru-ui-mudcard-hdr-banner px-5 py-4" Width="100%" Elevation="0" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Spacing="0">
                    <MudText Typo="Typo.h3" Color="Color.Secondary">@HeaderTitle</MudText>
                    @if (CRUCMode == CRUDCModes.READ)
                    {
                        <MudChip Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined" Class="pru-ui-mudchip-banner-status" T="string" Style="margin-top:-10px">VIEW</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.UPDATE)
                    {
                        <MudChip Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined" Class="pru-ui-mudchip-banner-status" T="string" Style="margin-top:-10px">UPDATE</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.CREATE)
                    {
                        <MudChip Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined" Class="pru-ui-mudchip-banner-status" T="string" Style="margin-top:-10px">NEW</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.CLONE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="pru-ui-mudchip-banner-status" T="string" Style="margin-top:-10px">NEW (Clone)</MudChip>
                    }
                </MudStack>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd">
                    @if (!IsViewMode)
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Color="Color.Secondary" Class="pru-ui-mudbutton"
                                   StartIcon="material-symbols-rounded/save_as"
                                   OnClick="@(() => Save())">Save</MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Color="Color.Secondary" Class="pru-ui-mudbutton"
                                   StartIcon="material-symbols-rounded/save"
                                   OnClick="@(() => Save(true))">Save & Close</MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Color="Color.Default" Class="pru-ui-mudbutton"
                                   StartIcon="material-symbols-rounded/cancel"
                                   OnClick="Cancel">Cancel</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Color="Color.Secondary"
                                   StartIcon="material-symbols-rounded/close"
                                   OnClick="Cancel">Close</MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>
        <MudTabs Class="pru-mudtab mt-5" Elevation="0" ActiveTabClass="pru-mudtab-active" TabHeaderClass="pru-mudtab-hdr" TabButtonsClass="pru-mudtab-btn" TabPanelsClass="pru-mudtab-tabpanel">
            <MudTabPanel Text="Main" Icon="material-symbols-rounded/home"
                         Class="pru-mudtabpanel" PanelClass="pru-mudtabpanel-panel" Style="min-width:120px">
                <MudPaper Class="pru-ui-mudpaper-cruc-tab-content px-5 pt-3 pb-4 overflow-y-auto" Square="true" Height="calc(100% - var(--pru-cruc-pg-status-bar-height))" Width="100%" Elevation="0">
                    <MudForm Model="@CurrentObject" @ref=@CrucForm @bind-IsValid=@IsValidationPassed @bind-Errors=@MudValidationErrors>
                        <MudGrid Spacing="4" Justify="Justify.SpaceEvenly">
                            <MudItem xs="8">
                                <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly="@IsViewMode" Required="true" ShrinkLabel="true"
                                              Class="pru-ui-mudform-input"
                                              Label="Name" MaxLength="255"
                                              @bind-Value=CurrentObject!.ObjectName For="@(() => CurrentObject.ObjectName)"
                                              @ref=_uiControlObjectName />
                            </MudItem>
                            <MudItem xs="1">
                                <MudNumericField Clearable="true" FullWidth="true" Immediate="false" ReadOnly="@IsViewMode" Required="true" ShrinkLabel="true"
                                                 Class="pru-ui-mudform-input" HideSpinButtons="true" Culture="@CultureInfo.GetCultureInfo("en-US")"
                                                 Adornment="Adornment.Start" AdornmentIcon="material-symbols-rounded/numbers"
                                                 Label="Level" Format="#,##0" Min="0" Max="999" Step="1"
                                                 @bind-Value=CurrentObject.OrgLevel For="@(() => CurrentObject.OrgLevel)" OnlyValidateIfDirty="true"
                                                 RequiredError="'Level' is required." />
                            </MudItem>
                            <MudItem xs="3">
                                <MudTextField Clearable="true" FullWidth="true" Immediate="false" ReadOnly="@IsViewMode" Required="true" ShrinkLabel="true"
                                              Class="pru-ui-mudform-input"
                                              Label="ID" MaxLength="80"
                                              @bind-Value=CurrentObject!.ObjectCode For="@(() => CurrentObject.ObjectCode)" OnlyValidateIfDirty="true"
                                              RequiredError="'ID' is required." />
                            </MudItem>
                            @if (CurrentObject.Id > 0)
                            {
                                <MudItem xs="12">
                                    <MudComboBox Clearable="true" Editable="true" FullWidth="true" ReadOnly=@IsViewMode Required="false" SearchBox="true" SearchBoxAutoFocus="true" SearchBoxClearable="true" ShrinkLabel="true" autocomplete="new-password"
                                                 Class="pru-ui-combobox" PopoverClass="pru-ui-combobox-popover" InputClass="pru-ui-combobox-input" HighlightClass="pru-ui-combobox-input" TemplateClass="pru-ui-combobox-input" ChipClass="pru-ui-combobox-chip"
                                                 AdornmentIcon="material-symbols-rounded/keyboard_arrow_down" AdornmentColor="Color.Primary" Adornment="Adornment.End" HasAdornmentEnd="true"
                                                 Label="Parent" T="int?"
                                                 Value="@CurrentObject.ParentId" ValueChanged="OnParentChanged"
                                                 ToStringFunc="@(val => val is not null && val > 0 ? _validParentList.SingleOrDefault<DropDownListItem>(x => x.ObjectId == val)?.ObjectName : "-")">
                                        <ChildContent>
                                            @foreach (var item in _validParentList)
                                            {
                                                <MudComboBoxItem T="int?" Value="@item.ObjectId" Text="@item.ObjectName">@item.ObjectName</MudComboBoxItem>
                                            }
                                        </ChildContent>
                                    </MudComboBox>
                                </MudItem>
                            }
                            <MudItem xs="12">
                                <MudTextField ReadOnly="true" Clearable="true" FullWidth="true" Immediate="false" ShrinkLabel="true"
                                              Class="pru-ui-mudform-input"
                                              Label="Hierarchy Path"
                                              @bind-Value=CurrentObject!.HierarchyPath For="@(() => CurrentObject.HierarchyPath)" OnlyValidateIfDirty="true" />
                            </MudItem>
                            @if (CurrentEditContext.GetValidationMessages().Any() || InvalidMsgList.Count > 0)
                            {
                                <MudItem xs="12" Class="pt-10">
                                    @* @foreach (string msg in CurrentEditContext.GetValidationMessages())
                                    {
                                        <MudAlert Variant="Variant.Outlined" Severity="Severity.Warning" Dense="true" Icon="material-symbols-rounded/warning" Class="pru-alert-validation mt-2">@msg</MudAlert>
                                    } *@
                                    @foreach (string key in InvalidMsgList.Keys)
                                    {
                                        <MudAlert Variant="Variant.Outlined" Severity="Severity.Warning" Dense="true" Icon="material-symbols-rounded/warning" Class="pru-alert-validation mt-2">@InvalidMsgList[key]</MudAlert>
                                    }
                                </MudItem>
                            }
                        </MudGrid>
                    </MudForm>
                </MudPaper>
                <MudPaper Class="pru-mudpaper-status-bar" Elevation="0" Height="var(--pru-cruc-pg-status-bar-height)">
                    @if (CurrentObject.Id > 0)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Justify="Justify.FlexStart" Style="height:100%; padding: 0px 10px">
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary">Created By</MudText>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@CurrentObject.CreatedUser</MudText>
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary">on</MudText>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@(CurrentObject.CreatedDateTime.HasValue ? CurrentObject.CreatedDateTime!.Value.ToString("dd-MMM-yyyy hh:mm:ss tt") : " - ")</MudText>
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary"> | Last Modified By</MudText>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@CurrentObject.ModifiedUser</MudText>
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary">on</MudText>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@(CurrentObject.ModifiedDateTime.HasValue ? CurrentObject.ModifiedDateTime!.Value.ToString("dd-MMM-yyyy hh:mm:ss tt") : " - ")</MudText>
                        </MudStack>
                    }
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Text="History" Class="pru-mudtabpanel" PanelClass="pru-mudtabpanel-panel"
                         Icon="material-symbols-rounded/history" Style="min-width:120px">
                <MudPaper Class="pru-ui-mudpaper-cruc-tab-content px-4 pt-2 pb-5 overflow-y-auto" Height="100%" Width="100%" Elevation="0"
                          Style="border-bottom: 1px solid var(--tw-gray-300); border-bottom-left-radius:var(--pru-base-card-radius); border-bottom-right-radius:var(--pru-base-card-radius)">
                </MudPaper>
            </MudTabPanel>
        </MudTabs>
    </EditForm>
}


@code {
    #region UI PARAM
    IEnumerable<DropDownListItem> _validParentList = [];
    MudTextField<string>? _uiControlObjectName;
    string _parentHierarchyPath = "";
    #endregion

    #region PAGE LIFECYCLE FUNCTIONS
    public override Task SetParametersAsync(ParameterView parameters)
    {
        UrlPrefix = "/core/org-struct-type";

        return base.SetParametersAsync(parameters);
    }

    protected override async Task OnInitializedAsync()
    {
        switch(CRUCMode)
        {
            case CRUCModes.READ:
                {
                    CurrentObject = await Uow.OrgStructTypes.GetAsync(Id);
                    IsViewMode = true;
                }
                break;
            case CRUCModes.CREATE:
                {
                    CurrentObject = new();
                }
                break;
            case CRUCModes.UPDATE:
                CurrentObject = await Uow.OrgStructTypes.GetAsync(Id);
                break;
            case CRUCModes.CLONE:
                {
                    var tempObj = await Uow.OrgStructTypes.GetAsync(Id);
                    CurrentObject = tempObj.DeepClone();
                    CurrentObject!.Id = 0;
                    CurrentObject!.ObjectCode = String.Empty;
                } break;
        }

        CurrentEditContext = new EditContext(CurrentObject!);

        HeaderTitle = ObjectDisplayName;

        if (CurrentObject!.Parent is not null)
            _parentHierarchyPath = CurrentObject!.Parent.HierarchyPath!;

        await PopulateUIControl();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_uiControlObjectName is not null)
                await _uiControlObjectName.FocusAsync();
        }
    }
    #endregion

    #region UI FUNCTIONS
    void OnParentChanged(int? val)
    {
        if (val is null || val <= 0)
        {
            CurrentObject!.ParentId = null;
            CurrentObject!.ParentCode = null;
            CurrentObject!.Parent = null;
            _parentHierarchyPath = string.Empty;
        }
        else
        {
            DropDownListItem? item = _validParentList.SingleOrDefault<DropDownListItem>(x => x.ObjectId == val!.Value);

            if (item is not null)
            {
                CurrentObject!.ParentId = item.ObjectId;
                CurrentObject!.ParentCode = item.ObjectCode;
                _parentHierarchyPath = item.HierarchyPath ?? "";
            }
        }
    }
    #endregion

    #region UPDATE FUNCTIONS
    protected override async Task PreSaveProcessing()
    {
        CurrentObject!.ObjectCode = CurrentObject!.ObjectCode!.ToUpper();

        if (!string.IsNullOrEmpty(_parentHierarchyPath))
            CurrentObject!.HierarchyPath = $"{_parentHierarchyPath}>{CurrentObject!.ObjectCode}";
        else
            CurrentObject!.HierarchyPath = CurrentObject!.ObjectCode;

        await Task.CompletedTask;
    }

    protected override async Task ValidatePreSave()
    {
        InvalidMsgList.Clear();

        bool isDuplicated = await Uow.OrgStructTypes.IsDuplicateCodeAsync(CurrentObject!.Id, CurrentObject!.ObjectCode!);

        if (isDuplicated)
        {
            InvalidMsgList.Add("ObjectCode_Duplicate", $"Organization Structure with ID='{CurrentObject.ObjectCode}' is already existed.");
        }
    }

    protected override async Task<bool> SaveAndCommitProcessing()
    {
        DateTime timestamp = DateTime.Now;

        if (CurrentObject!.Id == 0)
        {
            CurrentObject!.CreatedUser = AuditTrailUser;
            CurrentObject!.ModifiedUser = AuditTrailUser;
            CurrentObject!.CreatedDateTime = timestamp;
            CurrentObject!.ModifiedDateTime = timestamp;

            int objId = await Uow.OrgStructTypes.InsertAsync(CurrentObject!);

            if (objId > 0)
            {
                CurrentObject!.Id = objId;
                Id = objId;
                return true;
            }
            else
                return false;
        }
        else
        {
            CurrentObject!.ModifiedUser = AuditTrailUser;
            CurrentObject!.ModifiedDateTime = DateTime.Now;

            bool isupdated = await Uow.OrgStructTypes.UpdateAsync(CurrentObject!);
            return isupdated;
        }
    }
    #endregion

    #region INTERNAL FUNCTION
    async Task PopulateUIControl()
    {
        if (CurrentObject is not null && CurrentObject!.Id > 0)
            _validParentList = await Uow.OrgStructTypes.GetValidParentsAsync(CurrentObject.Id, CurrentObject.ObjectCode!, CurrentObject!.OrgLevel, null);
    }
    #endregion
}
