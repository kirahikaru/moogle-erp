@page "/itasset/prulico365/main"

@* @rendermode InteractiveAuto *@

@inherits MainPageBase<PruLicO365>

<MudPaper Class="pru-ui-mudcard-hdr-banner px-5 py-4" Width="100%" Elevation="0" Outlined="true">
	<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
		<MudText Typo="Typo.h3" Color="Color.Secondary">@HeaderTitle</MudText>
		<MudButton Color="Color.Primary" DropShadow="false" Size="Size.Small" Variant="Variant.Filled"
				   Class="pru-ui-mudbutton" StartIcon="material-symbols-rounded/add_circle"
				   OnClick="@(args => CreateOrEditRecord(0))">Add New</MudButton>
	</MudStack>
</MudPaper>

<MudPaper Class="pru-std-card-white mt-4" Outlined="true" Elevation="0" Height="100%" Width="100%" Style="overflow-y:hidden">
    <MudStack Class="pa-6" Row="true" AlignItems="AlignItems.Start" Justify="Justify.FlexStart" StretchItems="StretchItems.None">
        <MudTextField Clearable="true" ShrinkLabel="true" Immediate="true" Variant="Variant.Text" Class="pru-ui-mudform-input"
                      AdornmentIcon="material-symbols-rounded/search" Adornment="Adornment.Start" AdornmentColor="Color.Primary"
                      Placeholder="Search text here..."
                      @bind-Value="SearchText" OnKeyDown="OnSearchBoxKeyDown" @ref=UITextBoxSearch Disabled=IsSearching />
        <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" DropShadow="false"
                   Class="pru-ui-mudbutton" StartIcon="material-symbols-rounded/search"
                   OnClick="OnSearchClicked">Search</MudButton>
    </MudStack>
    <MudDataGrid Dense="true" Hover="true" Bordered="false" Square="true" FixedHeader="true" Striped="true"
                 ColumnResizeMode="ResizeMode.Column" SortMode="SortMode.Multiple" Loading=@IsSearching RowsPerPage="50" Elevation="0"
                 Class="pru-ui-muddatagrid main-pg"
                 SelectOnRowClick="true" RowClassFunc="SelectedRowClassFunc" RowClass="mud-datagrid-row"
                 ServerData="ServerDataFunc" @ref="MainDataGrid" @bind-SelectedItem=SelectedObject Height="100%"
                 T="PruLicO365">
        <Columns>
            @* <PropertyColumn Property="x => x.ObjectName" Title="Asset Name" StickyLeft="true" HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell" /> *@
            <TemplateColumn Title="Name"
                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell"
                            HeaderStyle="min-width:200px"
                            Context="rowData">
                <CellTemplate>
                    @if (rowData.Item.Status.Is(AssetLifeCycleStatuses.TERMINATED, AssetLifeCycleStatuses.WRITTEN_OFF))
                    {
                        <span style="text-decoration:line-through; font-style:italic; color:var(--vic-gray-300);">@rowData.Item.ObjectName</span>
                    }
                    else
                    {
                        <span>@rowData.Item.ObjectName</span>
                    }
                </CellTemplate>
            </TemplateColumn>
            @* <PropertyColumn Property="x => x.ObjectCode" Title="Asset ID" HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell" /> *@
            <TemplateColumn Title="Object ID"
                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell pru-ui-font-mono"
                            HeaderStyle="min-width:300px"
                            Context="rowData">
                <CellTemplate>
                    @if (rowData.Item.Status.Is(AssetLifeCycleStatuses.TERMINATED, AssetLifeCycleStatuses.WRITTEN_OFF))
                    {
                        <span style="text-decoration:line-through; font-style:italic; color:var(--vic-gray-300);">@rowData.Item.ObjectCode</span>
                    }
                    else if (rowData.Item.Status.Is(AssetLifeCycleStatuses.PENDING_TERMINATION, AssetLifeCycleStatuses.PENDING_WRITE_OFF))
					{
						<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
							<MudIcon Icon="@Icons.Material.Rounded.WarningAmber" Style="color:var(--vic-orange-500);" />
							<span style="font-style:italic; color:var(--vic-orange-500);">@rowData.Item.ObjectCode</span>
						</MudStack>
					}
					else
					{
						<span>@rowData.Item.ObjectCode</span>
					}
				</CellTemplate>
			</TemplateColumn>
            <PropertyColumn Title="User" Property="x => x.DisplayName"
                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell" HeaderStyle="min-width:200px" />
            <PropertyColumn Title="Provider Company" Property="x => x.SAMAccountName"
                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell pru-ui-font-mono" HeaderStyle="min-width:200px" />
            <PropertyColumn Title="Deparment" Property="x => x.Department"
                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell" HeaderStyle="min-width:250px" />
            <PropertyColumn Title="Licences" Property="x => x.Licenses"
                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell" HeaderStyle="min-width:300px" />
            <PropertyColumn Title="Employemnt Type" Property="x => x.EmploymentType"
                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell" Sortable="false" HeaderStyle="min-width:180px" />
            <PropertyColumn Title="Grouping" Property="x => x.Grouping"
                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell" />
            <PropertyColumn Title="Created On" Property="x => x.AccountCreatedDate" Format="dd-MMM-yyyy"
                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell" HeaderStyle="min-width:150px" />
            <PropertyColumn Title="Expiry Date" Property="x => x.ExpiryDate"
                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell" Sortable="false" HeaderStyle="min-width:120px" />
            @* <PropertyColumn Property="x => x.AssetState" Title="Asset State" HeaderClass="pru-ui-muddatagrid-hdr main-pg" /> *@
            <TemplateColumn Title="Status"
                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell"
                            HeaderStyle="justify-items:center" CellStyle="text-align:center">
                <CellTemplate>
                    <MudChip Size="Size.Small" Class="@(!string.IsNullOrEmpty(context.Item.Status) ? _statusCssClassList[context.Item.Status!] : "status-chip-default-light")" Style="padding:2px 8px; font-size:9pt">
                        @context.Item.Status
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Action" Sortable="false" Filterable="false" StickyRight="true"
                            HeaderClass="pru-ui-muddatagrid-hdr main-pg" CellClass="pru-ui-muddatagrid-cell"
                            HeaderStyle="justify-items:center; max-width:120px; width:500px"
                            CellStyle="padding-inline-end:4px; padding-inline-start:4px; padding-top: 2px !important; padding-bottom: 2px !important">
                <CellTemplate>
                    <MudStack Row="true" Spacing="0">
                        <MudIconButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info"
                                       Class="pru-ui-mudiconbtn-datagrid" Icon="material-symbols-rounded/edit"
                                       OnClick="@(args => CreateOrEditRecord(context.Item.Id))" aria-label="edit" />
                        <MudIconButton Variant="Variant.Text" Size="Size.Small" Color="Color.Info"
                                       Class="pru-ui-mudiconbtn-datagrid" Icon="material-symbols-rounded/file_copy"
                                       OnClick="@(args => CloneAndEditRecord(context.Item.Id))" aria-label="clone" />
                        <MudIconButton Variant="Variant.Text" Size="Size.Small" Color="Color.Success"
                                       Class="pru-ui-mudiconbtn-datagrid" Icon="material-symbols-rounded/visibility"
                                       OnClick="@(args => ViewFullRecord(context.Item.Id))" aria-label="view" />
                        <MudIconButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error"
                                       Class="pru-ui-mudiconbtn-datagrid" Icon="material-symbols-rounded/delete"
                                       OnClick="@(args => DeleteRecord(context.Item))" aria-label="delete" />
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
		<PagerContent>
			<MudDataGridPager T="PruLicO365" Class="pru-ui-muddatagrid-pager" PageSizeOptions="new[] {10, 30, 50, 80, 100}" />
		</PagerContent>
	</MudDataGrid>
</MudPaper>

@code {
	#region UI Param
	Dictionary<string, string> _statusCssClassList = new()
		{
			{ "", "" },
			{ AssetLifeCycleStatuses.IN_STOCK, "status-chip-success-light" },
			{ AssetLifeCycleStatuses.IN_USE, "status-chip-success-light" },
			{ AssetLifeCycleStatuses.TERMINATED, "status-chip-obsolete-light" },
			{ AssetLifeCycleStatuses.WRITTEN_OFF, "status-chip-obsolete-light" },
			{ AssetLifeCycleStatuses.PENDING_REVIEW, "status-chip-pending-light" },
			{ AssetLifeCycleStatuses.PENDING_WRITE_OFF, "status-chip-pending-light" },
			{ AssetLifeCycleStatuses.PENDING_TERMINATION, "status-chip-pending-light" },
		};

	#endregion

