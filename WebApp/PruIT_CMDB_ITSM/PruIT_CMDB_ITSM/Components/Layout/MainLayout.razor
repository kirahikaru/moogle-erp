@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="0" Style="border-bottom:solid 1px var(--tw-gray-200);">
        <MudText Typo="Typo.h5" Class="ml-3" Style="color:var(--pru-red-default); font-weight:800;">PRU</MudText>
        <MudText Typo="Typo.h5" Style="color:var(--tw-gray-500); font-weight:300;">ITAdminERP</MudText>
        <MudSpacer />
        @* <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle" /> *@
        @* <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" /> *@
        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd">
            <MudIconButton Icon="material-symbols-rounded/menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())"
                           Style="padding:4px" />
            <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center" Justify="Justify.FlexStart">
                <MudIconButton Icon="material-symbols-rounded/language" Color="Color.Primary" Size="Size.Small"
                               Style="padding:2px;" />
                <MudText Typo="Typo.body1" Color="Color.Primary" Style="font-weight:600;">@(_lang.ToUpper())</MudText>
            </MudStack>
        </MudStack>
    </MudAppBar>
    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Width="300px" Class="pru-ui-muddrawer-mainlayout">
        <NavMenu />
        <MudSpacer />
        <MudText Typo="Typo.body1" Class="ml-2" Style="font-size:7pt; color:var(--pru-red-default);">
            Version: 1.0
        </MudText>
        <MudText Typo="Typo.body1" Class="ml-2 mb-2" Style="font-size:7pt; color:var(--pru-gray-default);">
            &copy; 2025 Copy Right Company
        </MudText>
    </MudDrawer>
    <MudMainContent Class="pru-ui-mudmaincontent-mainlayout" >
        @Body
    </MudMainContent>
</MudLayout>

@* <div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div> *@

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
