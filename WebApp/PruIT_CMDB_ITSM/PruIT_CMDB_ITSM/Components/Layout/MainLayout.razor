@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="0" Style="background-color:white; border-bottom:solid 1px var(--tw-gray-200);">
        <MudText Typo="Typo.h5" Class="ml-3" Style="color:var(--pru-red-default); font-weight:800;">PRU</MudText>
        <MudText Typo="Typo.h5" Style="color:var(--tw-gray-500); font-weight:300;">ITAdminERP</MudText>
        <MudSpacer />
        @* <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle" /> *@
        @* <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" /> *@
        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd">
            <MudIconButton Icon="material-symbols-rounded/menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())"
                           Style="padding:4px" />
            <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center" Justify="Justify.FlexStart">
                <MudIconButton Icon="material-symbols-rounded/language" Color="Color.Primary" Size="Size.Small"
                               Style="padding:2px;" />
                <MudText Typo="Typo.body1" Color="Color.Primary" Style="font-weight:600;">@(_lang.ToUpper())</MudText>
            </MudStack>
        </MudStack>
    </MudAppBar>
    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Width="300px"
               Style="border-right:solid 1px var(--tw-gray-200); padding:10px; scrollbar-color: var(--tw-gray-300) var(--tw-gray-50); scrollbar-width:auto">
        <NavMenu />
        <MudSpacer />
        <MudText Typo="Typo.body1" Class="ml-2" Style="font-size:7pt; color:var(--pru-red-default);">
            Version: 1.0
        </MudText>
        <MudText Typo="Typo.body1" Class="ml-2 mb-2" Style="font-size:7pt; color:var(--pru-gray-default);">
            &copy; 2025 Copy Right Company
        </MudText>
    </MudDrawer>
    <MudMainContent Style="height:100vh; background-color:var(--tw-gray-50); padding: 85px 22px 18px 18px;">
        @Body
    </MudMainContent>
</MudLayout>

@* <div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div> *@

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    string _lang = "en";

    private MudTheme? _theme = null;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _theme = new()
        {
            PaletteLight = _pruLightPalette,
            PaletteDark = _darkPalette,
            Typography = _pruTypography,
            LayoutProperties = new LayoutProperties()
        };
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
    }

    private readonly Typography _pruTypography = new()
        {
            Body1 = new Body1Typography()
            {
                FontFamily = new[] { "Inter", "Arial", "sans-serif" },

                FontSize = "12px"
            },
            Body2 = new Body2Typography()
            {
                FontFamily = new[] { "Inter", "Arial", "sans-serif" },
                FontSize = "12px"
            },
            H4 = new H4Typography()
            {
                FontFamily = new[] { "Inter", "Arial", "sans-serif" },
                FontWeight = "800",
                FontSize = "36px",
            },
            H5 = new H5Typography()
            {
                FontFamily = new[] { "Inter", "Arial", "sans-serif" },
                FontWeight = "700",
                FontSize = "28px"
            },
            H6 = new H6Typography()
            {
                FontFamily = new[] { "Inter", "Arial", "sans-serif" },
                FontWeight = "600",
                FontSize = "32px"
            },
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Inter", "Arial", "sans-serif" },
                FontSize = "10pt"
            }
        };

    private readonly PaletteLight _pruLightPalette = new()
    {
        AppbarText = "#364153", // Tailwnid Gray 700
        Primary = "#364153", // Tailwind Gray 700
        // Primary = "#ED1B2E", //pru-red-default
        Secondary = "#687379", //pru-gray-default
        TextPrimary = "#343A3C",
        Black = "#110e2d",
        
        // AppbarBackground = "#ED1B2E",
        AppbarBackground = "#FFFFFF",
        DrawerBackground = "#FFFFFF",
        GrayLight = "#e8e8e8",
        GrayLighter = "#f9f9f9",
    };

    private readonly PaletteLight _lightPalette = new()
    {
        Black = "#110e2d",
        AppbarText = "#424242",
        AppbarBackground = "rgba(255,255,255,0.8)",
        DrawerBackground = "#ffffff",
        GrayLight = "#e8e8e8",
        GrayLighter = "#f9f9f9",
