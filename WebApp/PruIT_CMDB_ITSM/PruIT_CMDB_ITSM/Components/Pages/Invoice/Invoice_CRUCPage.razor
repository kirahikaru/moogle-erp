@page "/fin/invoice/cruc/{CRUCMode}"
@page "/fin/invoice/cruc/{CRUCMode}/{id:int}"
@page "/fin/invoice/cruc/{CRUCMode}/{PurchaseOrderCode}"
@* @rendermode InteractiveAuto*@

@inherits CRUCPageBase<Invoice>
<PageTitle>@HeaderTitle</PageTitle>
@if (CurrentObject != null && CurrentEditContext != null)
{
    <EditForm EditContext="CurrentEditContext" OnValidSubmit="SaveDummy" OnInvalidSubmit="SaveDummy" style="height:100%; display:flex; flex-direction:column">
        <DataAnnotationsValidator />
        <MudPaper Class="pru-ui-mudcard-hdr-banner px-5 py-4" Width="100%" Elevation="0" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Spacing="0">
                    <MudText Typo="Typo.h3" Color="Color.Secondary">@HeaderTitle</MudText>
                    @if (CRUCMode == CRUDCModes.READ)
                    {
                        <MudChip Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined" Class="pru-ui-mudchip-banner-status" T="string" Style="margin-top:-10px">VIEW</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.UPDATE)
                    {
                        <MudChip Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined" Class="pru-ui-mudchip-banner-status" T="string" Style="margin-top:-10px">UPDATE</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.CREATE)
                    {
                        <MudChip Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined" Class="pru-ui-mudchip-banner-status" T="string" Style="margin-top:-10px">NEW</MudChip>
                    }
                    else if (CRUCMode == CRUDCModes.CLONE)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="pru-ui-mudchip-banner-status" T="string" Style="margin-top:-10px">NEW (Clone)</MudChip>
                    }
                </MudStack>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd">
                    @if (!IsViewMode)
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Color="Color.Secondary" Class="pru-ui-mudbutton"
                                   StartIcon="material-symbols-rounded/save_as"
                                   OnClick="@(() => Save())">Save</MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Color="Color.Secondary" Class="pru-ui-mudbutton"
                                   StartIcon="material-symbols-rounded/save"
                                   OnClick="@(() => Save(true))">Save & Close</MudButton>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Color="Color.Default" Class="pru-ui-mudbutton"
                                   StartIcon="material-symbols-rounded/cancel"
                                   OnClick="Cancel">Cancel</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false" Color="Color.Secondary" 
                        StartIcon="material-symbols-rounded/close" 
                        OnClick="Cancel">Close</MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>
        <MudTabs Class="pru-mudtab mt-5" Elevation="0" ActiveTabClass="pru-mudtab-active" TabHeaderClass="pru-mudtab-hdr" TabButtonsClass="pru-mudtab-btn" TabPanelsClass="pru-mudtab-tabpanel">
            <MudTabPanel Text="Main" Icon="material-symbols-rounded/home"
                         Class="pru-mudtabpanel" PanelClass="pru-mudtabpanel-panel" Style="min-width:120px">
                <MudPaper Class="pru-ui-mudpaper-cruc-tab-content px-5 pt-3 pb-4 overflow-y-auto" Square="true" Height="calc(100% - var(--pru-cruc-pg-status-bar-height))" Width="100%" Elevation="0">
                    <MudGrid Spacing="4" Justify="Justify.SpaceEvenly">
                        <MudItem xs="1">
                            <MudSelect Clearable="true" FullWidth="true" Immediate="false" ReadOnly="@IsViewMode" Required="true" ShrinkLabel="true"
                                       Class="pru-ui-mudform-input" PopoverClass="pru-ui-mudselect-popover" InputClass="pru-ui-mudselect-input" ListClass="pru-ui-mudselect-list" OuterClass="pru-ui-mudselect-outer"
                                       ClearIcon="material-symbols-rounded/close" IconSize="Size.Small"
                                       AdornmentIcon="material-symbols-rounded/keyboard_arrow_down" AdornmentColor="Color.Primary"
                                       Label="LBU" T="string"
                                       Value=CurrentObject!.LBU For="@(() => CurrentObject.LBU)" ValueChanged="OnLBUChanged" OnlyValidateIfDirty="false">
                                @foreach (string lbuID in _lbuIDList)
                                {
                                    <MudSelectItem Value=@lbuID>@lbuID</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="2">
                            <MudDatePicker Clearable="true" Editable="true" ReadOnly=@IsViewMode Required="true" ShrinkLabel="true" 
                                           Class="pru-ui-muddatepicker"
                                           ClearIcon="material-symbols-rounded/close" IconSize="Size.Small"
                                           AdornmentIcon="material-symbols-rounded/calendar_month" AdornmentColor=@Color.Primary 
                                           Label="Date" DateFormat="dd-MMM-yyyy"
                                           @bind-Date=@CurrentObject.EffectiveDate For="@(() => CurrentObject.EffectiveDate)" />
                        </MudItem>
                        <MudItem xs="2">
                            <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="pru-ui-mudform-input" Required="true"
                                          ClearIcon="material-symbols-rounded/close" IconSize="Size.Small"
                                          Label="Ref #" MaxLength="80"
                                          @bind-Value=CurrentObject!.ObjectCode For="@(() => CurrentObject.ObjectCode)" OnlyValidateIfDirty="false" />
                        </MudItem>
                        <MudItem xs="7">
                            <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="pru-ui-mudform-input" Required="true"
                                          ClearIcon="material-symbols-rounded/close" IconSize="Size.Small"
                                          AdornmentIcon="material-symbols-rounded/calendar_month" AdornmentColor=@Color.Primary
                                          Label="One-liner Summary" MaxLength="255"
                                          @bind-Value=CurrentObject!.ObjectName For="@(() => CurrentObject.ObjectName)" OnlyValidateIfDirty="true" />
                        </MudItem>
                        <MudItem xs="3">
                            <MudTextField Clearable="true" Immediate="false" FullWidth="true" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                          Class="pru-ui-mudform-input"
                                          ClearIcon="material-symbols-rounded/close" IconSize="Size.Small"
                                          Label="Purchase Order#" MaxLength="80"
                                          @bind-Value=CurrentObject!.PurchaseOrderCode For="@(() => CurrentObject.PurchaseOrderCode)" OnlyValidateIfDirty="true" />
                        </MudItem>
                        <MudItem xs="2">
                            <MudDatePicker Clearable="true" Editable="true" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" 
                                           Class="pru-ui-muddatepicker"
                                           AdornmentIcon="material-symbols-rounded/calendar_month" AdornmentColor=@Color.Primary IconSize="Size.Small"
                                           Label="Expiry Date" DateFormat="dd-MMM-yyyy"
                                           @bind-Date=@CurrentObject.ExpiryDate For="@(() => CurrentObject.ExpiryDate)" />
                        </MudItem>
                        <MudItem xs="3">
                            <MudComboBox Clearable="true" Editable="true" FullWidth="true" ReadOnly=@IsViewMode Required="true" SearchBox="true" SearchBoxAutoFocus="true" SearchBoxClearable="true" ShrinkLabel="true" autocomplete="new-password"
                                         Class="pru-ui-combobox" PopoverClass="pru-ui-combobox-popover" InputClass="pru-ui-combobox-input" HighlightClass="pru-ui-combobox-input" TemplateClass="pru-ui-combobox-input" ChipClass="pru-ui-combobox-chip"
                                         AdornmentIcon="material-symbols-rounded/keyboard_arrow_down" AdornmentColor="Color.Primary" Adornment="Adornment.End" HasAdornmentEnd="true"
                                         Label="Vendor/Supplier" Placeholder="Select a vendor/supplier..." T="string"
                                         @bind-Value="@CurrentObject.VendorID" For="@(() => CurrentObject.VendorID)"
                                         ToStringFunc="@(e => string.IsNullOrEmpty(e) ? "" : _vendorList.Single<DropdownSelectItem>(x => x.Key == e)?.Value)">
                                <ChildContent>
                                    @foreach (var vendor in _vendorList)
                                    {
                                        <MudComboBoxItem T="string" Value="@vendor.Key" Text="@vendor.Value">@vendor.Value</MudComboBoxItem>
                                    }
                                </ChildContent>
                            </MudComboBox>
                            
                            @* <MudSelect Label="Supplier/Vendor" @bind-Value=CurrentObject!.VendorID Clearable="true" ReadOnly="@IsViewMode" Dense="true" Required="true"
                            For="@(() => CurrentObject.VendorID)" OnlyValidateIfDirty="true">
                                @foreach (DropdownSelectItem vendor in _vendorList)
                                {
                                    <MudSelectItem Value=@vendor.Key>@vendor.Value</MudSelectItem>
                                }
                            </MudSelect> *@
                        </MudItem>
                        <MudItem xs="2">
                            <MudTextField Clearable="true" Immediate="false" FullWidth="true" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true" Variant="Variant.Text"
                                          Class="pru-ui-mudform-input"
                                          ClearIcon="material-symbols-rounded/close" IconSize="Size.Small"
                                          Label="Customer No." MaxLength="80"
                                          @bind-Value=CurrentObject!.CustomerRef For="@(() => CurrentObject.CustomerRef)" OnlyValidateIfDirty="true" />
                        </MudItem>
                        <MudItem xs="2">
                            <MudSelect Clearable="true" FullWidth="true" Immediate="false" ReadOnly="@IsViewMode" Required="false" ShrinkLabel="true"
                                       Class="pru-ui-mudform-input" PopoverClass="pru-ui-mudselect-popover" InputClass="pru-ui-mudselect-input" ListClass="pru-ui-mudselect-list" OuterClass="pru-ui-mudselect-outer"
                                       AdornmentIcon="material-symbols-rounded/keyboard_arrow_down" AdornmentColor="Color.Primary"
                                       Label="Status"
                                       @bind-Value=CurrentObject!.WorkflowStatus For="@(() => CurrentObject.WorkflowStatus)" OnlyValidateIfDirty="true">
                                @foreach (DropdownSelectItem wfs in _wfsList)
                                {
                                    <MudSelectItem Value=@wfs.Key>@wfs.Value</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="1">
                            <MudSelect Clearable="true" FullWidth="true" Immediate="false" ReadOnly="@IsViewMode" Required="false" ShrinkLabel="true"
                                       Class="pru-ui-mudform-input" PopoverClass="pru-ui-mudselect-popover" InputClass="pru-ui-mudselect-input" ListClass="pru-ui-mudselect-list" OuterClass="pru-ui-mudselect-outer"
                                       ClearIcon="material-symbols-rounded/close" IconSize="Size.Small"
                                       AdornmentIcon="material-symbols-rounded/keyboard_arrow_down" AdornmentColor="Color.Primary"
                                       Label="Currency"
                                       @bind-Value=CurrentObject!.CurrencyCode For="@(() => CurrentObject.CurrencyCode)" OnlyValidateIfDirty="true">
                                @foreach (DropdownSelectItem curr in _currList)
                                {
                                    <MudSelectItem Value=@curr.Key>@curr.Key</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="1">
                            <MudNumericField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="pru-ui-mudform-input" Culture="@CultureInfo.GetCultureInfo("en-US")" HideSpinButtons="true"
                                             AdornmentIcon="material-symbols-rounded/attach_money" Adornment="Adornment.Start" AdornmentColor=@Color.Primary
                                             Label="Total Amount" Step=".1M" Format="#,##0.00" Min="0"
                                             @bind-Value=CurrentObject!.TotalAmount For="@(() => CurrentObject.TotalAmount)" OnlyValidateIfDirty="true" />
                        </MudItem>
                        <MudItem xs="1">
                            <MudNumericField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="pru-ui-mudform-input" Culture="@CultureInfo.GetCultureInfo("en-US")" HideSpinButtons="true"
                                             AdornmentIcon="material-symbols-rounded/attach_money" Adornment="Adornment.Start" AdornmentColor=@Color.Primary
                                             Label="Tax Amount" Step=".1M" Format="#,##0.00" Min="0"
                                             @bind-Value=CurrentObject!.TotalTaxAmount For="@(() => CurrentObject.TotalTaxAmount)" OnlyValidateIfDirty="true" />
                        </MudItem>
                        <MudItem xs="2">
                            <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="pru-ui-mudform-input"
                                          ClearIcon="material-symbols-rounded/close" IconSize="Size.Small"
                                          Label="Accounting System Ref #"
                                          @bind-Value=CurrentObject!.AccSysSubmID For="@(() => CurrentObject.AccSysSubmID)" OnlyValidateIfDirty="true"
                                          MaxLength="80" />
                        </MudItem>
                        <MudItem xs="7">
                            <MudStack Row=true Spacing="1" Justify="Justify.FlexStart" AlignItems="AlignItems.Center" StretchItems="StretchItems.None">
                                <MudText Typo="Typo.body1" Color="Color.Secondary">File Name: </MudText>
                                <MudText Typo="Typo.body1" Class="reddit-mono-400" Color="Color.Info" Style="font-weight:500;">@(CurrentObject.FileNameDisplay)</MudText>
                                <MudTooltip Text="Copy Filename">
                                    <MudIconButton Icon="material-symbols-rounded/content_copy" Size="Size.Small" Color="Color.Primary" Class="pru-mud-icon-btn" aria-label="copy" OnClick="CopyFileName" />
                                </MudTooltip>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12">
                            <MudStack Spacing="2" Justify=Justify.FlexStart Class="mt-3">
                                @if (!IsViewMode)
                                {
                                    <MudStack Row=true Spacing="2" Justify="Justify.FlexStart" AlignItems="AlignItems.End" StretchItems="StretchItems.None">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" DropShadow="false" Class="pru-ui-mudbutton mb-1"
                                                   StartIcon="material-symbols-rounded/add"
                                                   Disabled=_isEditingItemDataGrid OnClick="AddInvoiceItem" >
                                            Add Item
                                        </MudButton>
                                        <MudNumericField Clearable="true" FullWidth="false" HideSpinButtons="true" Immediate="true" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true"
                                                         Class="pru-ui-mudform-input no-flex allow-label-overflow" Culture="@CultureInfo.GetCultureInfo("en-US")"
                                                         ClearIcon="material-symbols-rounded/close" IconSize="Size.Small" 
                                                         AdornmentIcon="material-symbols-rounded/calendar_month" AdornmentColor=@Color.Primary Adornment="Adornment.Start"
                                                         Label="Expense Month" T="int?"
                                                         @bind-Value=@_expMth OnlyValidateIfDirty="true"
                                                         Step="1" Min="1" Max="12" MaxLength="2" Style="max-width: 100px" />
                                        <MudNumericField Clearable="true" FullWidth="false" HideSpinButtons="true" Immediate="true" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true"
                                                         Class="pru-ui-mudform-input no-flex allow-label-overflow" Culture="@CultureInfo.GetCultureInfo("en-US")"
                                                         ClearIcon="material-symbols-rounded/close" IconSize="Size.Small"
                                                         AdornmentIcon="material-symbols-rounded/calendar_month" AdornmentColor=@Color.Primary Adornment="Adornment.Start"
                                                         Label="Expense Year" T="int?"
                                                         @bind-Value=@_expYr OnlyValidateIfDirty="true"
                                                         Step="1" Min="1900" Max="9999" MaxLength="4" Style="max-width: 100px" />
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" DropShadow="false" Class="pru-ui-mudbutton mb-1"
                                                   StartIcon="material-symbols-rounded/update"
                                                   Disabled=_isEditingItemDataGrid OnClick="UpdateExpensePeriod" >
                                            Apply Period
                                        </MudButton>
                                    </MudStack>

                                }
                                <MudDataGrid Class="pru-ui-muddatagrid" Dense="true" Hover="true" FixedHeader="true" Striped="true" ReadOnly=@IsViewMode Elevation="0"
                                             ColumnResizeMode="ResizeMode.Container" HorizontalScrollbar="true" Bordered="false"
                                             EditTrigger="DataGridEditTrigger.Manual" EditMode="DataGridEditMode.Form" EditDialogOptions=@(new (){ BackdropClick=false, MaxWidth=MaxWidth.Medium, FullWidth=true, NoHeader=true })
                                             StartedEditingItem="@StartedEditingItem" CanceledEditingItem="@CanceledEditingItem" CommittedItemChanges="@CommittedItemChanges" Style="width:100%"
                                             @ref="_qItemDataGrid" T="InvoiceItem" Items="@CurrentObject!.Items">
                                    <Columns>
                                        <PropertyColumn Title="No." Property="x => x.OrderNo" Sortable="false" Editable="false"
                                                        HeaderClass="pru-ui-muddatagrid-hdr cruc-pg-items" CellClass="pru-ui-muddatagrid-cell"
                                                        HeaderStyle="width:80px; max-width:50px" CellStyle="text-align:right" Context="qi">
                                            <EditTemplate>
                                                <MudGrid Spacing="4" Justify="Justify.SpaceEvenly">
                                                    <MudItem xs="12">
                                                        <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="pru-ui-mudform-input" Required="true"
                                                                      ClearIcon="material-symbols-rounded/close" IconSize="Size.Small"
                                                                      Label="Name"
                                                                      @bind-Value=qi.Item.ObjectName For="@(() => qi.Item.ObjectName)" OnlyValidateIfDirty="true"
                                                                      MaxLength="255" />
                                                    </MudItem>
                                                    <MudItem xs="6">
                                                        <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="pru-ui-mudform-input"
                                                                      Label="PO#" MaxLength="50"
                                                                      @bind-Value=qi.Item.PurchaseOrderCode For="@(() => qi.Item.PurchaseOrderCode)" OnlyValidateIfDirty="true" />
                                                    </MudItem>
                                                    <MudItem xs="6">
                                                        <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="pru-ui-mudform-input"
                                                                      Label="SKU"
                                                                      @bind-Value=qi.Item.SKU For="@(() => qi.Item.SKU)" OnlyValidateIfDirty="true"
                                                                      MaxLength="255" />
                                                    </MudItem>
                                                    <MudItem xs="3">
                                                        <MudNumericField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="pru-ui-mudform-input" HideSpinButtons="true" Culture="@CultureInfo.GetCultureInfo("en-US")" Required="true"
                                                                         Adornment="Adornment.Start" AdornmentIcon="material-symbols-rounded/attach_money" AdornmentColor=@Color.Primary
                                                                         Label="Unit Price" Format="#,##0.##" Min="0" Step=".1M"
                                                                         T="decimal?" @bind-Value=qi.Item.UnitPrice For="@(() => qi.Item.UnitPrice)" OnlyValidateIfDirty="true" />
                                                    </MudItem>
                                                    <MudItem xs="3">
                                                        <MudNumericField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="pru-ui-mudform-input" HideSpinButtons="true" Culture="@CultureInfo.GetCultureInfo("en-US")" Required="true"
                                                                         Adornment="Adornment.Start" AdornmentIcon="material-symbols-rounded/numbers" AdornmentColor=@Color.Secondary
                                                                         Label="Quantity" Format="#,##0.##" Min="0" Step=".1M" T="decimal?"
                                                                         @bind-Value=qi.Item.Quantity For="@(() => qi.Item.Quantity)" OnlyValidateIfDirty="true" />
                                                        
                                                    </MudItem>
                                                    <MudItem xs="3">
                                                        <MudNumericField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="pru-ui-mudform-input" HideSpinButtons="true" Culture="@CultureInfo.GetCultureInfo("en-US")" Disabled="true"
                                                                         Adornment="Adornment.Start" AdornmentIcon="material-symbols-rounded/attach_money" AdornmentColor=@Color.Primary
                                                                         Label="Total Amount" Format="#,##0.##" Min="0" Step=".1M"
                                                                         @bind-Value=qi.Item.TotalAmount For="@(() => qi.Item.TotalAmount)" OnlyValidateIfDirty="true" />
                                                    </MudItem>
                                                    <MudItem xs="3">
                                                        <MudNumericField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="pru-ui-mudform-input" HideSpinButtons="true" Culture="@CultureInfo.GetCultureInfo("en-US")"
                                                                         Adornment="Adornment.Start" AdornmentIcon="material-symbols-rounded/attach_money" AdornmentColor=@Color.Primary
                                                                         Label="Tax Amount" Format="#,##0.##"
                                                                         @bind-Value=qi.Item.TaxAmount For="@(() => qi.Item.TaxAmount)" OnlyValidateIfDirty="true"
                                                                         Step=".1M" Min="0" />
                                                    </MudItem>
                                                    <MudItem xs="6">
                                                        <MudDatePicker Clearable="true" Editable="true" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true"
                                                                       Class="pru-ui-muddatepicker"
                                                                       AdornmentIcon="material-symbols-rounded/calendar_month" AdornmentColor=@Color.Primary IconSize="Size.Small"
                                                                       Label="Start Date" DateFormat="dd-MMM-yyyy"
                                                                       @bind-Date=@qi.Item.CoverageStartDate For="@(() => qi.Item.CoverageStartDate)" />
                                                    </MudItem>
                                                    <MudItem xs="6">
                                                        <MudDatePicker Clearable="true" Editable="true" ReadOnly=@IsViewMode Required="false" ShrinkLabel="true"
                                                                       Class="pru-ui-muddatepicker"
                                                                       AdornmentIcon="material-symbols-rounded/calendar_month" AdornmentColor=@Color.Primary IconSize="Size.Small"
                                                                       Label="End Date" DateFormat="dd-MMM-yyyy"
                                                                       @bind-Date=@qi.Item.CoverageEndDate For="@(() => qi.Item.CoverageEndDate)" />
                                                    </MudItem>
                                                    <MudItem xs="12">
                                                        <MudTextField ReadOnly=@IsViewMode Clearable="true" ShrinkLabel="true" Class="pru-ui-mudform-input" Lines=4
                                                                      Label="Remark"
                                                                      @bind-Value=qi.Item.Remark For="@(() => qi.Item.Remark)" OnlyValidateIfDirty="true"
                                                                      MaxLines="25" MaxLength="1000" />
                                                    </MudItem>
                                                </MudGrid>
                                            </EditTemplate>
                                        </PropertyColumn>
                                        <PropertyColumn Title="Item" Property="x => x.ObjectName" Sortable="false"
                                                        HeaderClass="pru-ui-muddatagrid-hdr cruc-pg-items" CellClass="pru-ui-muddatagrid-cell"
                                                        HeaderStyle="min-width:250px" Context="qi">
                                            <EditTemplate>
                                                
                                            </EditTemplate>
                                        </PropertyColumn>
                                        <PropertyColumn Title="PO#" Property="x => x.PurchaseOrderCode" Sortable="false"
                                                        HeaderClass="pru-ui-muddatagrid-hdr cruc-pg-items" CellClass="pru-ui-muddatagrid-cell reddit-mono-400"
                                                        HeaderStyle="min-width:120px" Context="qi">
                                            <EditTemplate>
                                                
                                            </EditTemplate>
                                        </PropertyColumn>
                                        <PropertyColumn Title="SKU" Property="x => x.SKU" Sortable="false"
                                                        HeaderClass="pru-ui-muddatagrid-hdr cruc-pg-items" CellClass="pru-ui-muddatagrid-cell reddit-mono-400"
                                                        Context="qi">
                                            <EditTemplate>

                                            </EditTemplate>
                                        </PropertyColumn>
                                        <PropertyColumn Title="Unit Price" Property="x => x.UnitPrice" Format="@(CurrentObject!.CurrencyCode == PruGC.Currencies.USD ? "#,##0.00" : "#,##0")"
                                                        HeaderClass="pru-ui-muddatagrid-hdr cruc-pg-items" CellClass="pru-ui-muddatagrid-cell pru-ui-font-mono"
                                                        HeaderStyle="min-width:100px" CellStyle="text-align:right"
                                                        Filterable="false" Sortable="false" Context="qi">
                                            <EditTemplate>
                                                
                                            </EditTemplate>
                                        </PropertyColumn>
                                        <PropertyColumn Title="Quantity" Property="x => x.Quantity" Format="#,##0.##" Filterable="false" Sortable="false"
                                                        HeaderClass="pru-ui-muddatagrid-hdr cruc-pg-items" CellClass="pru-ui-muddatagrid-cell pru-ui-font-mono"
                                                        CellStyle="text-align:right"
                                                        Context="qi">
                                            <EditTemplate>

                                            </EditTemplate>
                                        </PropertyColumn>
                                        <PropertyColumn Title="Start Date" Property="x => x.CoverageStartDate" Sortable="false" Filterable="false" Format="dd-MMM-yyyy"
                                                        HeaderClass="pru-ui-muddatagrid-hdr cruc-pg-items" CellClass="pru-ui-muddatagrid-cell reddit-mono-400"
                                                        HeaderStyle="justify-items:center; min-width:110px" CellStyle="text-align:center"
                                                        Context="qi">
                                            <EditTemplate>
                                                
                                            </EditTemplate>
                                        </PropertyColumn>
                                        <PropertyColumn Title="End Date" Property="x => x.CoverageEndDate" Format="dd-MMM-yyyy" Filterable="false" Sortable="false"
                                                        HeaderClass="pru-ui-muddatagrid-hdr cruc-pg-items" CellClass="pru-ui-muddatagrid-cell reddit-mono-400"
                                                        HeaderStyle="justify-items:center; min-width:110px" CellStyle="text-align:center"
                                                        Context="qi" FooterClass="reddit-mono-400">
                                            <EditTemplate>

                                            </EditTemplate>
                                            <FooterTemplate>
                                                <MudText Typo="Typo.body2" Style="font-weight:500">Total</MudText>
