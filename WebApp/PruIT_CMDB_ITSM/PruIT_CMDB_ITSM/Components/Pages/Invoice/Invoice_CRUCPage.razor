    protected override async Task OnInitializedAsync()
    {
        switch (CRUCMode)
        {
            case CRUCModes.READ:
                {
                    CurrentObject = await Uow.Invoices.GetFullAsync(Id);
                    IsViewMode = true;
                }
                break;
            case CRUCModes.CREATE:
                {
                    CurrentObject = new();
                    _expMth = DateTime.Today.Month;
                    _expYr = DateTime.Today.Year;

                    if (!string.IsNullOrEmpty(PurchaseOrderCode))
                    {
                        PurchaseOrder? po = await Uow.PurchaseOrders.GetFullAsync(PurchaseOrderCode!);

                        if (po != null)
                        {
                            CurrentObject!.PurchaseOrderCode = po.ObjectCode;
                            CurrentObject!.ObjectName = po.ObjectName;
                            CurrentObject!.TotalAmount = po.TotalAmount;
                            CurrentObject!.TotalTaxAmount = po.TotalTaxAmount;
                            CurrentObject!.VendorID = po.VendorID;

                            foreach (PurchaseOrderItem poi in po.Items)
                            {
                                InvoiceItem invItem = new();
                                invItem.OrderNo = poi.OrderNo;
                                invItem.PurchaseOrderCode = poi.ObjectCode;
                                invItem.ObjectName = poi.ObjectName;
                                invItem.PurchaseOrderItemId = poi.Id;
                                invItem.CoverageStartDate = poi.StartDate;
                                invItem.CoverageEndDate = poi.EndDate;
                                invItem.UnitPrice = poi.UnitPrice;
                                invItem.Quantity = poi.Quantity;
                                invItem.TotalAmount = poi.TotalAmount;

                                CurrentObject.Items.Add(invItem);

                                ExpenseItem expItem = new();
                                expItem.OrderNo = poi.OrderNo;
                                expItem.PurchaseOrderNo= po.ObjectCode;
                                expItem.ObjectName = poi.ObjectName;
                                expItem.ObjectCode = poi.ITAssetCode;
                                expItem.EmpID = poi.UserID;
                                expItem.Amount = poi.TotalAmount;

                                CurrentObject!.ExpenseItems.Add(expItem);
                            }
                        }
                    }
                }
                break;
            case CRUCModes.UPDATE:
                CurrentObject = await Uow.Invoices.GetFullAsync(Id);
                break;
            case CRUCModes.CLONE:
                {
                    var tempObj = await Uow.Invoices.GetFullAsync(Id);
                    CurrentObject = tempObj.DeepClone();
                    CurrentObject!.Id = 0;
                    CurrentObject!.ObjectCode = null;
                    CurrentObject!.AccSysSubmID = null;

                    foreach (InvoiceItem i in CurrentObject.Items)
                    {
                        i.Id = 0;
                        i.InvoiceId = null;
                        i.InvoiceCode = null;
                        i.ObjectCode = null;
                        i.PurchaseOrderCode = null;
                        i.PurchaseOrderId = null;
                        i.PurchaseOrderItemId = null;
                    }

                    foreach (ExpenseItem i in CurrentObject.ExpenseItems)
                    {
                        i.Id = 0;
                        i.InvoiceId = null;
                        i.InvoiceCode = null;
                        i.ObjectCode = null;
                        i.InvoiceItemId = null;
                        i.AccSysID = null;
                    }
                }
                break;
        }

        CurrentEditContext = new EditContext(CurrentObject!);

        HeaderTitle = ObjectDisplayName;

        await PopulateUIControl();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CurrentHotKeyContext = HotKeys.CreateContext()
            .Add(Code.Escape, CancelHotkeyPressed, new() { Exclude = Exclude.None })
            .Add(ModCode.Ctrl, Code.S, SaveHotKeyPressed, new() { Exclude = Exclude.None })
            .Add(ModCode.Ctrl | ModCode.Shift, Code.S, SaveAndCloseHotKeyPressed, new() { Exclude = Exclude.None });
        }

        return base.OnAfterRenderAsync(firstRender);
    }
