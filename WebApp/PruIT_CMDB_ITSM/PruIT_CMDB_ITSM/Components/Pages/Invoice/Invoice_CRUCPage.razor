    void MoveInvoiceItemUp(InvoiceItem i)
    {
        if (i.OrderNo == 1)
            return;
        else
        {
            i.OrderNo--;
            var tmpInvItem = CurrentObject!.Items.SingleOrDefault(x => x.OrderNo == i.OrderNo && x != i);
            if (tmpInvItem != null)
                tmpInvItem.OrderNo++;

            CurrentObject!.Items = CurrentObject!.Items.OrderBy(x => x.OrderNo).ToList();
        }
    }

    void MoveInvoiceItemDown(InvoiceItem i)
    {
        if (i.OrderNo == CurrentObject!.Items.Count())
            return;
        else
        {
            i.OrderNo++;
            var tmpInvItem = CurrentObject!.Items.SingleOrDefault(x => x.OrderNo == i.OrderNo && x != i);
            if (tmpInvItem != null)
                tmpInvItem.OrderNo--;

            CurrentObject!.Items = CurrentObject!.Items.OrderBy(x => x.OrderNo).ToList();
        }
    }

