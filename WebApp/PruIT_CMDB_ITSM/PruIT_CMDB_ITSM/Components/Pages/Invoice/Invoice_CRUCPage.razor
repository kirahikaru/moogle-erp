            item.FinActTrackerID = finActTrackerId;
            FinActivityTracker? finActTracker = _finActTrackerList.SingleOrDefault<FinActivityTracker>(x => x.ObjectCode == finActTrackerId);

            if (finActTracker != null)
            {
                item.FinActTrackerName = finActTracker.ObjectName;
            }
